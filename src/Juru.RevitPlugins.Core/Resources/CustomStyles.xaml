<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:controls="clr-namespace:Wpf.Ui.Controls;assembly=Wpf.Ui">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary
            Source="pack://application:,,,/Wpf.Ui;component/Controls/CheckBox/CheckBox.xaml" />
        <ResourceDictionary
            Source="pack://application:,,,/Wpf.Ui;component/Controls/ToggleSwitch/ToggleSwitch.xaml" />
        <!-- Переключатели так же, как флажки: WPF-UI держит стиль под ключом
             DefaultRadioButtonStyle и по типу ни на что не вешает. -->
        <ResourceDictionary
            Source="pack://application:,,,/Wpf.Ui;component/Controls/RadioButton/RadioButton.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- Отмеченный флажок под курсором и в нажатии в WPF-UI 4.3 заливается прозрачной кистью
         (CheckBoxCheckBackgroundFillChecked*  = #00FFFFFF), а рамка у отмеченного состояния
         прозрачна по замыслу - в сумме квадрат флажка пропадал целиком, стоило навести мышь.
         Изначально здесь стояла заливка акцентом ({DynamicResource SystemAccentColorSecondary} /
         Tertiary) - "проверено в пустом приложении с теми же словарями, к Revit отношения не
         имеет". Оказалось, что как раз имеет: SystemAccentColor* прописывает
         Wpf.Ui.Appearance.ApplicationAccentColorManager.UpdateColorResources, а тот целиком
         обёрнут в "if (Application.Current != null)". Ревит не создаёт System.Windows.Application,
         поэтому этот код не выполняется вообще ни разу ни для одного окна плагина, ключ нигде не
         появляется, и DynamicResource на него молча резолвится в прозрачный цвет по умолчанию.
         Тот же прозрачный итог, что и без этого исправления. Фиксированные цвета вместо
         акцентных - тот же приём, что уже применён в проекте для DynamicResource-кистей WPF-UI,
         не резолвящихся внутри Popup (см. память проекта): не гнаться за резолюцией ресурса темы
         там, где сама тема Ревитом не поднимается, а просто взять видимый цвет. -->
    <SolidColorBrush
        x:Key="CheckBoxCheckBackgroundFillCheckedPointerOver"
        Color="#106EBE" />
    <SolidColorBrush
        x:Key="CheckBoxCheckBackgroundFillCheckedPressed"
        Color="#005A9E" />
    <Style
        x:Key="CustomColumnCheckBoxStyle"
        TargetType="CheckBox"
        BasedOn="{StaticResource DefaultCheckBoxStyle}">
        <Setter
            Property="Margin"
            Value="0" />
        <Setter
            Property="Padding"
            Value="0" />
        <Setter
            Property="HorizontalAlignment"
            Value="Left" />
        <Setter
            Property="Width"
            Value="47" />
    </Style>
    <Style
        TargetType="Border"
        x:Key="CustomBorder">
        <Setter
            Property="Padding"
            Value="14 8 14 8" />
        <Setter
            Property="VerticalAlignment"
            Value="Stretch" />
        <Setter
            Property="HorizontalAlignment"
            Value="Stretch" />
        <Setter
            Property="SnapsToDevicePixels"
            Value="True" />
        <Setter
            Property="OverridesDefaultStyle"
            Value="True" />
        <Setter
            Property="ScrollViewer.HorizontalScrollBarVisibility"
            Value="Auto" />
        <Setter
            Property="ScrollViewer.VerticalScrollBarVisibility"
            Value="Disabled" />
        <Setter
            Property="Background"
            Value="{DynamicResource CardBackground}" />
        <Setter
            Property="BorderBrush"
            Value="{DynamicResource CardBorderBrush}" />
        <Setter
            Property="BorderThickness"
            Value="{DynamicResource CardControlBorderThemeThickness}" />
        <Setter
            Property="FocusVisualStyle"
            Value="{DynamicResource DefaultControlFocusVisualStyle}" />
        <Setter
            Property="CornerRadius"
            Value="{DynamicResource ControlCornerRadius}" />
    </Style>
    <Style
        TargetType="ui:TextBlock"
        x:Key="CustomErrorText">
        <Setter
            Property="Foreground"
            Value="Orange" />
        <Setter
            Property="VerticalAlignment"
            Value="Center" />
        <Setter
            Property="Background"
            Value="Transparent" />
        <Setter
            Property="Focusable"
            Value="False" />
        <Setter
            Property="SnapsToDevicePixels"
            Value="True" />
        <Setter
            Property="OverridesDefaultStyle"
            Value="True" />
        <Style.Triggers>
            <Trigger
                Property="Text"
                Value="">
                <Setter
                    Property="Visibility"
                    Value="Hidden" />
            </Trigger>
            <Trigger
                Property="Text"
                Value="{x:Null}">
                <Setter
                    Property="Visibility"
                    Value="Collapsed" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style
        TargetType="ui:TextBlock"
        x:Key="CustomMessageText">
        <Setter
            Property="Foreground"
            Value="Green" />
        <Setter
            Property="VerticalAlignment"
            Value="Center" />
        <Setter
            Property="Background"
            Value="Transparent" />
        <Setter
            Property="Focusable"
            Value="False" />
        <Setter
            Property="SnapsToDevicePixels"
            Value="True" />
        <Setter
            Property="OverridesDefaultStyle"
            Value="True" />
        <Style.Triggers>
            <Trigger
                Property="Text"
                Value="">
                <Setter
                    Property="Visibility"
                    Value="Hidden" />
            </Trigger>
            <Trigger
                Property="Text"
                Value="{x:Null}">
                <Setter
                    Property="Visibility"
                    Value="Collapsed" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style
        TargetType="GridSplitter"
        x:Key="CustomGridSplitter">
        <Setter
            Property="Width"
            Value="5" />
        <Setter
            Property="Background"
            Value="Transparent" />
        <Setter
            Property="HorizontalAlignment"
            Value="Center" />
        <Setter
            Property="VerticalAlignment"
            Value="Stretch" />
    </Style>
    <Style
        TargetType="ui:ToggleSwitch"
        x:Key="LabeledToggleSwitch"
        BasedOn="{StaticResource DefaultUiToggleSwitchStyle}">
        <Setter
            Property="Foreground"
            Value="{DynamicResource LabelForeground}" />
    </Style>
    <Style
        TargetType="Label"
        x:Key="CustomLabel">
        <Setter
            Property="Padding"
            Value="0,0,0,4" />
        <Setter
            Property="Focusable"
            Value="False" />
        <Setter
            Property="Foreground"
            Value="{DynamicResource LabelForeground}" />
        <Setter
            Property="SnapsToDevicePixels"
            Value="True" />
        <Setter
            Property="VerticalAlignment"
            Value="Center" />
        <Setter
            Property="VerticalContentAlignment"
            Value="Center" />
        <Style.Triggers>
            <Trigger
                Property="IsEnabled"
                Value="False">
                <Setter
                    Property="Foreground"
                    Value="{DynamicResource LabelForeground}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Тянущиеся ручки заголовка DataGrid. Штатный стиль DataGridColumnHeader из WPF-UI ставит
         ручкам Thumb без фона - Thumb без фона не участвует в hit-test, и колонку нельзя потянуть
         за границу заголовка мышью, хотя CanUserResizeColumns остаётся True. Нужен свой шаблон
         заголовка с прозрачным, но hit-testable фоном у ручек. Взято из ClashNavigator, где это
         уже подтверждено рабочим. -->
    <Style
        x:Key="CustomHeaderGripperStyle"
        TargetType="Thumb">
        <Setter
            Property="Width"
            Value="8" />
        <Setter
            Property="VerticalAlignment"
            Value="Stretch" />
        <Setter
            Property="Cursor"
            Value="SizeWE" />
        <Setter
            Property="Template">
            <Setter.Value>
                <ControlTemplate
                    TargetType="Thumb">
                    <Border
                        Background="Transparent" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style
        x:Key="CustomResizableColumnHeaderStyle"
        TargetType="DataGridColumnHeader">
        <Setter
            Property="Background"
            Value="Transparent" />
        <Setter
            Property="BorderBrush"
            Value="{DynamicResource ControlElevationBorderBrush}" />
        <Setter
            Property="BorderThickness"
            Value="0,0,1,1" />
        <Setter
            Property="Padding"
            Value="8,6" />
        <Setter
            Property="MinHeight"
            Value="32" />
        <Setter
            Property="FontWeight"
            Value="SemiBold" />
        <Setter
            Property="HorizontalContentAlignment"
            Value="Stretch" />
        <Setter
            Property="VerticalContentAlignment"
            Value="Center" />
        <Setter
            Property="Template">
            <Setter.Value>
                <ControlTemplate
                    TargetType="DataGridColumnHeader">
                    <Grid>
                        <Border
                            x:Name="HeaderBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}">
                            <ContentPresenter
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <Thumb
                            x:Name="PART_LeftHeaderGripper"
                            HorizontalAlignment="Left"
                            Style="{StaticResource CustomHeaderGripperStyle}" />
                        <Thumb
                            x:Name="PART_RightHeaderGripper"
                            HorizontalAlignment="Right"
                            Style="{StaticResource CustomHeaderGripperStyle}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger
                            Property="IsMouseOver"
                            Value="True">
                            <Setter
                                TargetName="HeaderBorder"
                                Property="Background"
                                Value="{DynamicResource ListViewItemBackgroundPointerOver}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
