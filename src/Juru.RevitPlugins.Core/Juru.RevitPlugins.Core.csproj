<Project Sdk="Nice3point.Revit.Sdk/6.2.2">

    <PropertyGroup>
        <Configurations>Debug.R23;Debug.R24;Debug.R25;Debug.R26;Debug.R27</Configurations>
        <Configurations>$(Configurations);Release.R23;Release.R24;Release.R25;Release.R26;Release.R27</Configurations>
		<UseWPF>true</UseWPF>
		<DefineConstants>REVIT_2023_OR_LESS</DefineConstants>
        <!-- HintPath обязан побеждать. SDK-проект превращает все .dll внутри папки проекта в
             CandidateAssemblyFiles, а этот путь поиска у RAR идёт раньше HintPath: для
             dosymep.Revit/dosymep.Bim4Everyone выигрывала libs\2020 (первая одноимённая папка),
             и сборка компилировалась против версии 2020.2.4.0, тогда как в выход копируется
             2024.2.4.0. В процессе Ревита это давало
             "Could not load file or assembly 'dosymep.Revit, Version=2020.2.4.0'"
             при первом обращении к типу из dosymep.Revit - например при сохранении отчёта. -->
        <AssemblySearchPaths>{HintPathFromItem};$(AssemblySearchPaths)</AssemblySearchPaths>
    </PropertyGroup>

    <ItemGroup>
        <!-- Revit Dependencies -->
        <PackageReference Include="Microsoft.Xaml.Behaviors.Wpf" Version="1.1.142" />
        <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
        <PackageReference Include="Nice3point.Revit.Toolkit" Version="$(RevitVersion).*" />
        <PackageReference Include="Nice3point.Revit.Extensions" Version="$(RevitVersion).*" />
        <PackageReference Include="Nice3point.Revit.Api.RevitAPI" Version="$(RevitVersion).*" />
        <PackageReference Include="Nice3point.Revit.Api.RevitAPIUI" Version="$(RevitVersion).*" />

        <!-- Development Dependencies -->
        <PackageReference Include="JetBrains.Annotations" Version="2025.2.4" PrivateAssets="all" />
        <PackageReference Include="Polyfill" Version="10.5.1" PrivateAssets="all" />
        <PackageReference Include="WPF-UI" Version="4.3.0" />
    </ItemGroup>

    <ItemGroup>
      <Reference Include="Bim4Everyone.RevitFiltration">
        <HintPath>libs\2024\Bim4Everyone.RevitFiltration.dll</HintPath>
      </Reference>
      <Reference Include="Bim4Everyone.RevitFiltration.Controls">
        <HintPath>libs\2024\Bim4Everyone.RevitFiltration.Controls.dll</HintPath>
      </Reference>
      <Reference Include="Bim4Everyone.RevitFiltration.Ninject">
        <HintPath>libs\2024\Bim4Everyone.RevitFiltration.Ninject.dll</HintPath>
      </Reference>
      <Reference Include="dosymep.Bim4Everyone">
        <HintPath>libs\2024\dosymep.Bim4Everyone.dll</HintPath>
      </Reference>
      <Reference Include="dosymep.Revit">
        <HintPath>libs\2024\dosymep.Revit.dll</HintPath>
      </Reference>
      <Reference Include="dosymep.SimpleServices">
        <HintPath>libs\dosymep.SimpleServices.dll</HintPath>
      </Reference>
      <Reference Include="dosymep.WpfCore">
        <HintPath>libs\dosymep.WpfCore.dll</HintPath>
      </Reference>
      <Reference Include="dosymep.WpfCore.Ninject">
        <HintPath>libs\dosymep.WpfCore.Ninject.dll</HintPath>
      </Reference>
      <Reference Include="dosymep.WpfUI.Core">
        <HintPath>libs\dosymep.WpfUI.Core.dll</HintPath>
      </Reference>
      <Reference Include="dosymep.WpfUI.Core.Ninject">
        <HintPath>libs\dosymep.WpfUI.Core.Ninject.dll</HintPath>
      </Reference>
    </ItemGroup>

</Project>