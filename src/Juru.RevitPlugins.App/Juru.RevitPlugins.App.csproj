<Project Sdk="Nice3point.Revit.Sdk/6.2.2">

    <PropertyGroup>
        <UseWPF>true</UseWPF>
        <DeployAddin>true</DeployAddin>
        <LaunchRevit>true</LaunchRevit>
        <!-- Merge shared dependencies (dosymep.*, Ninject, Newtonsoft.Json, etc.) into this add-in's own assembly
             on pre-2027 Revit, where the process has no per-add-in assembly isolation. Without this, a separately
             installed product that ships a different version of the same dependency (e.g. the real Bim4Everyone
             plugin's dosymep.WpfCore.dll) can win the .NET simple-name assembly resolution race and cause a
             MissingMethodException in this add-in at runtime.

             Release only: repacking collapses every project into Juru.RevitPlugins.App.dll, which leaves no
             Juru.RevitPlugins.ClashNavigator.dll for AddinManager to load and forces a full solution build per
             iteration. Debug keeps loose assemblies so AddinManager can point straight at the project output. -->
        <IsRepackable Condition="'$(RevitVersion)' &lt; '2027' And $(Configuration.StartsWith('Release'))">true</IsRepackable>
        <!-- Unused transitive deps of dosymep.Bim4Everyone.dll (nothing in our code calls into Serilog) -
             kept as loose files instead of merging. -->
        <!-- WPF-UI ставится отдельным файлом, а не вклеивается: при первом использовании он меняет
             общие классы WPF (метаданные TextBlock, его свойства), а это можно сделать один раз на процесс.
             Вклеенные копии у Juru и YM - разные сборки, и окно той редакции, что открылась второй, падало.
             Отдельный Wpf.Ui.dll одной версии Ревит грузит один раз на обе редакции. Версия WPF-UI
             у редакций должна совпадать, иначе копий снова станет две. -->
        <RepackBinariesExcludes>Serilog.Enrichers.Autodesk.Revit.dll;Serilog.Sinks.Autodesk.Revit.dll;Wpf.Ui.dll;Wpf.Ui.Abstractions.dll</RepackBinariesExcludes>
        <EnableDynamicLoading>true</EnableDynamicLoading>
        <Configurations>Debug.R23;Debug.R24;Debug.R25;Debug.R26;Debug.R27</Configurations>
        <Configurations>$(Configurations);Release.R23;Release.R24;Release.R25;Release.R26;Release.R27</Configurations>
    </PropertyGroup>

    <ItemGroup>
        <!-- Revit Dependencies -->
        <PackageReference Include="Nice3point.Revit.Toolkit" Version="$(RevitVersion).*"/>
        <PackageReference Include="Nice3point.Revit.Extensions" Version="$(RevitVersion).*"/>
        <PackageReference Include="Nice3point.Revit.Api.RevitAPI" Version="$(RevitVersion).*"/>
        <PackageReference Include="Nice3point.Revit.Api.RevitAPIUI" Version="$(RevitVersion).*"/>

        <!-- Development Dependencies -->
        <PackageReference Include="JetBrains.Annotations" Version="2025.2.4" PrivateAssets="all"/>
        <PackageReference Include="Polyfill" Version="10.5.1" PrivateAssets="all"/>

        <!-- Required by IsRepackable to merge dependencies and avoid simple-name assembly conflicts with other installed add-ins -->
        <PackageReference Include="ILRepack" Version="2.0.46" PrivateAssets="all"/>

        <!-- dosymep.Bim4Everyone.dll depends on this (transitively, via a vendored raw <Reference>, so it never
             gets restored on its own). Without an explicit reference it's never present in our build output for
             ILRepack to merge, so at runtime the CLR loads the copy from the separately-installed Bim4Everyone
             product instead - which expects the ORIGINAL (non-repacked) Ninject types, not the ones internalized
             into this assembly, causing a MissingMethodException on ChildKernel's constructor. -->
        <PackageReference Include="Ninject.Extensions.ChildKernel" Version="3.3.0" PrivateAssets="all"/>
    </ItemGroup>

    <ItemGroup>
        <!-- Адрес сервера коллизий. Правится рядом с установленным плагином, без пересборки. -->
        <None Include="ClashServer.json" CopyToOutputDirectory="PreserveNewest"/>
    </ItemGroup>

    <ItemGroup>
        <Resource Include="Resources\Icons\NavigatorIcon16Small.png"/>
        <Resource Include="Resources\Icons\NavigatorIcon32.png"/>
        <Resource Include="Resources\Icons\FindClashesIcon16.png"/>
        <Resource Include="Resources\Icons\FindClashesIcon32.png"/>
        <Resource Include="Resources\Icons\SearchSetsIcon16.png"/>
        <Resource Include="Resources\Icons\SearchSetsIcon32.png"/>
        <Resource Include="Resources\Icons\SettingsIcon16.png"/>
        <Resource Include="Resources\Icons\SettingsIcon32.png"/>
        <Resource Include="Resources\Icons\PlaceOpeningsIcon16.png"/>
        <Resource Include="Resources\Icons\PlaceOpeningsIcon32.png"/>
        <Resource Include="Resources\Icons\UniteOpeningsIcon16.png"/>
        <Resource Include="Resources\Icons\UniteOpeningsIcon32.png"/>
        <Resource Include="Resources\Icons\OpeningsNavigatorIcon16.png"/>
        <Resource Include="Resources\Icons\OpeningsNavigatorIcon32.png"/>
        <Resource Include="Resources\Icons\SendOpeningsIcon16.png"/>
        <Resource Include="Resources\Icons\SendOpeningsIcon32.png"/>
        <Resource Include="Resources\Icons\LoadOpeningsIcon16.png"/>
        <Resource Include="Resources\Icons\LoadOpeningsIcon32.png"/>
        <Resource Include="Resources\Icons\ApproveOpeningsIcon16.png"/>
        <Resource Include="Resources\Icons\ApproveOpeningsIcon32.png"/>
        <Resource Include="Resources\Icons\TranslateIcon16.png"/>
        <Resource Include="Resources\Icons\TranslateIcon32.png"/>
        <Resource Include="Resources\Icons\UpdateCopyIcon16.png"/>
        <Resource Include="Resources\Icons\UpdateCopyIcon32.png"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Juru.RevitPlugins.ClashNavigator\Juru.RevitPlugins.ClashNavigator.csproj"/>
        <ProjectReference Include="..\Juru.RevitPlugins.Openings\Juru.RevitPlugins.Openings.csproj"/>
        <ProjectReference Include="..\Juru.RevitPlugins.Schedules\Juru.RevitPlugins.Schedules.csproj"/>
        <!-- Подготовка проекта в СОД: команда без кнопки на ленте, запускается через Add-in Manager -->
        <ProjectReference Include="..\Juru.RevitPlugins.ProjectSetup\Juru.RevitPlugins.ProjectSetup.csproj"/>
    </ItemGroup>

</Project>
