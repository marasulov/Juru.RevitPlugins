<Project Sdk="Nice3point.Revit.Sdk/6.2.2">

    <PropertyGroup>
        <UseWPF>true</UseWPF>
        <Configurations>Debug.R23;Debug.R24;Debug.R25;Debug.R26;Debug.R27</Configurations>
        <Configurations>$(Configurations);Release.R23;Release.R24;Release.R25;Release.R26;Release.R27</Configurations>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)' == 'Debug.R23' Or '$(Configuration)' == 'Release.R23'">
        <DefineConstants>$(DefineConstants);REVIT_2023_OR_LESS</DefineConstants>
    </PropertyGroup>

    <ItemGroup>
        <!-- Revit Dependencies -->
        <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
        <PackageReference Include="Nice3point.Revit.Toolkit" Version="$(RevitVersion).*" />
        <PackageReference Include="Nice3point.Revit.Extensions" Version="$(RevitVersion).*" />
        <PackageReference Include="Nice3point.Revit.Api.RevitAPI" Version="$(RevitVersion).*" />
        <PackageReference Include="Nice3point.Revit.Api.RevitAPIUI" Version="$(RevitVersion).*" />

        <!-- MVVM -->
        <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />

        <!-- Development Dependencies -->
        <PackageReference Include="JetBrains.Annotations" Version="2025.2.4" PrivateAssets="all" />
        <PackageReference Include="Ninject" Version="3.3.6" />
        <PackageReference Include="Polyfill" Version="10.5.1" PrivateAssets="all" />
        <PackageReference Include="WPF-UI" Version="4.3.0" />
    </ItemGroup>

    <ItemGroup>
        <Folder Include="Models" />
        <Folder Include="Commands\" />
        <Folder Include="Services\" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\Juru.RevitPlugins.Core\Juru.RevitPlugins.Core.csproj" />
    </ItemGroup>

    <ItemGroup>
      <Reference Include="dosymep.Bim4Everyone">
        <HintPath>..\Juru.RevitPlugins.Core\libs\2024\dosymep.Bim4Everyone.dll</HintPath>
      </Reference>
      <Reference Include="dosymep.Revit">
        <HintPath>..\Juru.RevitPlugins.Core\libs\2024\dosymep.Revit.dll</HintPath>
      </Reference>
      <Reference Include="dosymep.SimpleServices">
        <HintPath>..\Juru.RevitPlugins.Core\libs\dosymep.SimpleServices.dll</HintPath>
      </Reference>
      <Reference Include="dosymep.WpfCore">
        <HintPath>..\Juru.RevitPlugins.Core\libs\dosymep.WpfCore.dll</HintPath>
      </Reference>
      <Reference Include="dosymep.WpfCore.Ninject">
        <HintPath>..\Juru.RevitPlugins.Core\libs\dosymep.WpfCore.Ninject.dll</HintPath>
      </Reference>
      <Reference Include="dosymep.WpfUI.Core">
        <HintPath>..\Juru.RevitPlugins.Core\libs\dosymep.WpfUI.Core.dll</HintPath>
      </Reference>
      <Reference Include="dosymep.WpfUI.Core.Ninject">
        <HintPath>..\Juru.RevitPlugins.Core\libs\dosymep.WpfUI.Core.Ninject.dll</HintPath>
      </Reference>
      <Reference Include="dosymep.Xpf.Core.Ninject">
        <HintPath>..\Juru.RevitPlugins.Core\libs\dosymep.Xpf.Core.Ninject.dll</HintPath>
      </Reference>
    </ItemGroup>

</Project>
