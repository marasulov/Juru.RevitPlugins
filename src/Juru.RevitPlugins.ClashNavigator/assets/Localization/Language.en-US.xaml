<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:system="clr-namespace:System;assembly=mscorlib">

    <!-- English UI strings. Keys missing here fall back to Language.ru-RU.xaml, which the
         localization service merges in as the default dictionary - a forgotten key shows
         Russian text rather than nothing at all. -->

    <system:String x:Key="BIM">BIM</system:String>

    <!-- Shared -->
    <system:String x:Key="Common.Ok">OK</system:String>
    <system:String x:Key="Common.Cancel">Cancel</system:String>
    <system:String x:Key="Common.Close">Close</system:String>
    <system:String x:Key="Common.Yes">Yes</system:String>
    <system:String x:Key="Common.No">No</system:String>
    <system:String x:Key="Common.Select">Select</system:String>
    <system:String x:Key="Common.SelectAll">Select all</system:String>
    <system:String x:Key="Common.Delete">Delete</system:String>
    <system:String x:Key="Common.Load">Load</system:String>
    <system:String x:Key="Common.Save">Save</system:String>
    <system:String x:Key="Common.SaveAs">Save as...</system:String>
    <system:String x:Key="Common.Name">Name</system:String>

    <!-- Checks window -->
    <system:String x:Key="ChecksWindow.Title">Clash detection</system:String>
    <system:String x:Key="ChecksWindow.LoadTooltip">Load checks from a file</system:String>
    <system:String x:Key="ChecksWindow.SaveTooltip">Save the checks</system:String>
    <system:String x:Key="ChecksWindow.SaveAsTooltip">Save the checks to a separate file</system:String>
    <system:String x:Key="ChecksWindow.AddCheck">Add check</system:String>
    <system:String x:Key="ChecksWindow.RemoveCheck">Remove check</system:String>
    <system:String x:Key="ChecksWindow.RemoveCheckTooltip">Remove the checks selected in the table</system:String>
    <system:String x:Key="ChecksWindow.SearchPlaceholder">Search checks...</system:String>
    <system:String x:Key="ChecksWindow.Selection1">Selection 1</system:String>
    <system:String x:Key="ChecksWindow.Selection2">Selection 2</system:String>
    <system:String x:Key="ChecksWindow.ShowClashes">Clashes</system:String>
    <system:String x:Key="ChecksWindow.ShowClashesTooltip">Open the clashes found in the navigator</system:String>
    <system:String x:Key="ChecksWindow.DefaultCheckName">New check</system:String>
    <system:String x:Key="ChecksWindow.SearchCompleted">Clash detection finished</system:String>
    <system:String x:Key="ChecksWindow.ChecksSaved">Checks saved</system:String>
    <system:String x:Key="ChecksWindow.ChecksLoaded">Checks loaded</system:String>
    <system:String x:Key="ChecksWindow.SavePrompt">Save the checks?</system:String>

    <system:String x:Key="ChecksWindow.SummaryTitle">Clash detection</system:String>
    <system:String x:Key="ChecksWindow.SummaryEmpty">{0}: no clashes found</system:String>
    <system:String x:Key="ChecksWindow.SummaryFirstRun">{0}: found {1}</system:String>
    <system:String x:Key="ChecksWindow.SummaryLine">{0}: found {1} ({2} new, {3} gone)</system:String>

    <system:String x:Key="ChecksWindow.Validation.NamesDuplicated">Check names are duplicated.</system:String>
    <system:String x:Key="ChecksWindow.Validation.SelectAnyCheck">No check is ticked.</system:String>
    <system:String x:Key="ChecksWindow.Validation.EmptyFilterInCheck">Check "{0}" has no search set selected.</system:String>
    <system:String x:Key="ChecksWindow.Validation.EmptyFileInCheck">Check "{0}" has no file selected.</system:String>
    <system:String x:Key="ChecksWindow.Validation.MissingFiles1">Selection 1 is missing these files: {0}.</system:String>
    <system:String x:Key="ChecksWindow.Validation.MissingFilters1">Selection 1 is missing these search sets: {0}.</system:String>
    <system:String x:Key="ChecksWindow.Validation.MissingFiles2">Selection 2 is missing these files: {0}.</system:String>
    <system:String x:Key="ChecksWindow.Validation.MissingFilters2">Selection 2 is missing these search sets: {0}.</system:String>

    <!-- Selection inside a check row -->
    <system:String x:Key="Selection.SelectFilesLabel">Select files</system:String>
    <system:String x:Key="Selection.SelectSearchSetsLabel">Select search sets</system:String>
    <system:String x:Key="Selection.SelectFilesTitle">Select files</system:String>
    <system:String x:Key="Selection.SelectSearchSetsTitle">Select search sets</system:String>
    <system:String x:Key="Selection.CreateSearchSet">Create set...</system:String>

    <!-- Search sets window -->
    <system:String x:Key="SearchSets.Title">Search sets</system:String>
    <system:String x:Key="SearchSets.LoadTooltip">Load sets from a file</system:String>
    <system:String x:Key="SearchSets.SaveTooltip">Save the sets</system:String>
    <system:String x:Key="SearchSets.SaveAsTooltip">Save the sets to a separate file</system:String>
    <system:String x:Key="SearchSets.AddFilter">Add set</system:String>
    <system:String x:Key="SearchSets.RemoveFilter">Remove set</system:String>
    <system:String x:Key="SearchSets.RemoveFilterTooltip">Remove the sets selected in the list</system:String>
    <system:String x:Key="SearchSets.SearchPlaceholder">Search sets...</system:String>
    <system:String x:Key="SearchSets.NameLabel">Set name</system:String>
    <system:String x:Key="SearchSets.CategoriesLabel">Categories</system:String>
    <system:String x:Key="SearchSets.SelectCategoriesTooltip">Select the set's categories</system:String>
    <system:String x:Key="SearchSets.SelectCategoriesTitle">Select categories</system:String>
    <system:String x:Key="SearchSets.AddRule">Add rule</system:String>
    <system:String x:Key="SearchSets.AddNestedSet">Add nested set</system:String>
    <system:String x:Key="SearchSets.DeleteRuleTooltip">Remove rule</system:String>
    <system:String x:Key="SearchSets.DeleteSetTooltip">Remove nested set</system:String>
    <system:String x:Key="SearchSets.DefaultFilterName">New set</system:String>
    <system:String x:Key="SearchSets.SetsSaved">Sets saved</system:String>
    <system:String x:Key="SearchSets.SetsLoaded">Sets loaded</system:String>
    <system:String x:Key="SearchSets.SelectCategoriesFirst">Select categories first.</system:String>
    <system:String x:Key="SearchSets.ParametersError">Could not read the parameters of the categories: {0}</system:String>
    <system:String x:Key="SearchSets.NoParametersSingle">The category has no parameter available for filtering.</system:String>
    <system:String x:Key="SearchSets.NoParametersMultiple">The selected categories share no parameter - the list holds only what all of them have in common. Try fewer categories per set.</system:String>

    <system:String x:Key="SearchSets.Validation.NoFilters">No search set has been created.</system:String>
    <system:String x:Key="SearchSets.Validation.NamesDuplicated">Set names are duplicated.</system:String>
    <system:String x:Key="SearchSets.Validation.NoName">The set has no name.</system:String>
    <system:String x:Key="SearchSets.Validation.NoCategories">Set "{0}" has no category selected.</system:String>
    <system:String x:Key="SearchSets.Validation.SetPrefix">Set "{0}": {1}</system:String>
    <system:String x:Key="SearchSets.Validation.RuleNoParameter">The rule has no parameter selected.</system:String>
    <system:String x:Key="SearchSets.Validation.RuleNoEvaluator">The rule has no condition selected.</system:String>
    <system:String x:Key="SearchSets.Validation.RuleNoValue">Rule "{0}" has no value.</system:String>
    <system:String x:Key="SearchSets.Validation.NestedSetEmpty">The nested set is empty.</system:String>

    <!-- Rule conditions -->
    <system:String x:Key="Evaluator.Equals">equals</system:String>
    <system:String x:Key="Evaluator.NotEquals">does not equal</system:String>
    <system:String x:Key="Evaluator.Greater">greater than</system:String>
    <system:String x:Key="Evaluator.GreaterOrEqual">greater than or equal</system:String>
    <system:String x:Key="Evaluator.Less">less than</system:String>
    <system:String x:Key="Evaluator.LessOrEqual">less than or equal</system:String>
    <system:String x:Key="Evaluator.Contains">contains</system:String>
    <system:String x:Key="Evaluator.NotContains">does not contain</system:String>
    <system:String x:Key="Evaluator.BeginsWith">begins with</system:String>
    <system:String x:Key="Evaluator.NotBeginsWith">does not begin with</system:String>
    <system:String x:Key="Evaluator.EndsWith">ends with</system:String>
    <system:String x:Key="Evaluator.NotEndsWith">does not end with</system:String>
    <system:String x:Key="Evaluator.HasValue">has a value</system:String>
    <system:String x:Key="Evaluator.HasNoValue">has no value</system:String>
    <system:String x:Key="SetEvaluator.And">AND</system:String>
    <system:String x:Key="SetEvaluator.Or">OR</system:String>

    <!-- Configuration loading -->
    <system:String x:Key="ConfigLoader.InvalidFile">Could not read the configuration file.</system:String>

    <!-- Clash navigator -->
    <system:String x:Key="Navigator.DeletePrompt">Delete the selected report?</system:String>
    <system:String x:Key="Navigator.ClashComments">Comments: {0}</system:String>
    <system:String x:Key="ReportsMerge.ConflictedClashes">Clashes with conflicts</system:String>
    <system:String x:Key="ReportsMerge.AutoMergedClashes">Merged automatically</system:String>
    <system:String x:Key="ReportsResolver.Header">Loading reports</system:String>
    <system:String x:Key="ReportsResolver.Body">The file being loaded contains reports with matching names: {0}.</system:String>
    <system:String x:Key="ReportsResolver.Merge">Merge</system:String>
    <system:String x:Key="ReportsResolver.Replace">Replace</system:String>
    <system:String x:Key="ReportsResolver.CopyAndRename">Copy and rename</system:String>

    <!-- Settings -->
    <system:String x:Key="SettingsWindow.Validation.OffsetLessThanZero">The offset cannot be negative.</system:String>
    <system:String x:Key="SettingsWindow.Validation.OffsetGreaterThan">The offset cannot be greater than {0}.</system:String>
    <system:String x:Key="SettingsWindow.Language">Interface language</system:String>
    <system:String x:Key="SettingsWindow.LanguageTooltip">The language applies the next time the plugin's windows are opened</system:String>

    <!-- Language choice on first run -->
    <system:String x:Key="LanguagePrompt.Title">Interface language</system:String>
    <system:String x:Key="LanguagePrompt.Body">Choose the plugin's interface language. You can change it later in the settings.</system:String>
    <system:String x:Key="Language.Russian">Русский</system:String>
    <system:String x:Key="Language.English">English</system:String>
</ResourceDictionary>
