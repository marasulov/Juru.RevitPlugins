    <system:String x:Key="SearchSets.DefaultFilterName">Новый набор</system:String>
    <system:String x:Key="SearchSets.SetsSaved">Наборы сохранены</system:String>
    <system:String x:Key="SearchSets.SetsLoaded">Наборы загружены</system:String>
    <system:String x:Key="SearchSets.SelectCategoriesFirst">Сначала выберите категории.</system:String>
    <system:String x:Key="SearchSets.ParametersError">Не удалось получить параметры категорий: {0}</system:String>
    <system:String x:Key="SearchSets.NoParametersSingle">У категории нет ни одного параметра, доступного для фильтрации.</system:String>
    <system:String x:Key="SearchSets.NoParametersMultiple">У выбранных категорий нет ни одного общего параметра - список параметров общий для всех сразу. Попробуйте меньше категорий за один набор.</system:String>

    <system:String x:Key="SearchSets.Validation.NoFilters">Не создано ни одного поискового набора.</system:String>
    <system:String x:Key="SearchSets.Validation.NamesDuplicated">Имена наборов повторяются.</system:String>
    <system:String x:Key="SearchSets.Validation.NoName">У набора не задано имя.</system:String>
    <system:String x:Key="SearchSets.Validation.NoCategories">У набора "{0}" не выбрана ни одна категория.</system:String>
    <system:String x:Key="SearchSets.Validation.SetPrefix">Набор "{0}": {1}</system:String>
    <system:String x:Key="SearchSets.Validation.RuleNoParameter">У правила не выбран параметр.</system:String>
    <system:String x:Key="SearchSets.Validation.RuleNoEvaluator">У правила не выбрано условие.</system:String>
    <system:String x:Key="SearchSets.Validation.RuleNoValue">У правила "{0}" не задано значение.</system:String>
    <system:String x:Key="SearchSets.Validation.NestedSetEmpty">Вложенный набор пуст.</system:String>

    <!-- Условия правил -->
    <system:String x:Key="Evaluator.Equals">равно</system:String>
    <system:String x:Key="Evaluator.NotEquals">не равно</system:String>
    <system:String x:Key="Evaluator.Greater">больше</system:String>
    <system:String x:Key="Evaluator.GreaterOrEqual">больше или равно</system:String>
    <system:String x:Key="Evaluator.Less">меньше</system:String>
    <system:String x:Key="Evaluator.LessOrEqual">меньше или равно</system:String>
    <system:String x:Key="Evaluator.Contains">содержит</system:String>
    <system:String x:Key="Evaluator.NotContains">не содержит</system:String>
    <system:String x:Key="Evaluator.BeginsWith">начинается с</system:String>
    <system:String x:Key="Evaluator.NotBeginsWith">не начинается с</system:String>
    <system:String x:Key="Evaluator.EndsWith">заканчивается на</system:String>
    <system:String x:Key="Evaluator.NotEndsWith">не заканчивается на</system:String>
    <system:String x:Key="Evaluator.HasValue">имеет значение</system:String>
    <system:String x:Key="Evaluator.HasNoValue">без значения</system:String>
    <system:String x:Key="SetEvaluator.And">И</system:String>
    <system:String x:Key="SetEvaluator.Or">ИЛИ</system:String>

    <!-- Загрузка конфигураций -->
    <system:String x:Key="ConfigLoader.InvalidFile">Не удалось прочитать файл конфигурации.</system:String>

    <!-- Навигатор коллизий -->
    <system:String x:Key="Navigator.DeletePrompt">Удалить выбранный отчёт?</system:String>
    <system:String x:Key="Navigator.ClashComments">Комментарии: {0}</system:String>
    <system:String x:Key="ReportsMerge.ConflictedClashes">Коллизии с расхождениями</system:String>
    <system:String x:Key="ReportsMerge.AutoMergedClashes">Объединённые автоматически</system:String>
    <system:String x:Key="ReportsResolver.Header">Загрузка отчётов</system:String>
    <system:String x:Key="ReportsResolver.Body">В загружаемом файле есть отчёты с совпадающими именами: {0}.</system:String>
    <system:String x:Key="ReportsResolver.Merge">Объединить</system:String>
    <system:String x:Key="ReportsResolver.Replace">Заменить</system:String>
    <system:String x:Key="ReportsResolver.CopyAndRename">Копировать с переименованием</system:String>

    <!-- Настройки -->
    <system:String x:Key="SettingsWindow.Validation.OffsetLessThanZero">Отступ не может быть отрицательным.</system:String>
    <system:String x:Key="SettingsWindow.Validation.OffsetGreaterThan">Отступ не может быть больше {0}.</system:String>
    <system:String x:Key="SettingsWindow.Language">Язык интерфейса</system:String>
    <system:String x:Key="SettingsWindow.LanguageTooltip">Язык применится при следующем открытии окон плагина</system:String>

    <!-- Выбор языка при первом запуске -->
    <system:String x:Key="LanguagePrompt.Title">Язык интерфейса</system:String>
    <system:String x:Key="LanguagePrompt.Body">Выберите язык интерфейса плагина. Позже его можно сменить в настройках.</system:String>
    <system:String x:Key="Language.Russian">Русский</system:String>
    <system:String x:Key="Language.English">English</system:String>
</ResourceDictionary>
