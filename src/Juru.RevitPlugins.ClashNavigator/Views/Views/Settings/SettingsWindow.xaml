<Window
    x:Class="Juru.RevitPlugins.ClashNavigator.Views.Settings.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:local="clr-namespace:Juru.RevitPlugins.ClashNavigator.Views.Settings"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:vms="clr-namespace:Juru.RevitPlugins.ClashNavigator.ViewModels.Settings"
    xmlns:core="clr-namespace:dosymep.WpfUI.Core"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:me="clr-namespace:dosymep.WpfCore.MarkupExtensions;assembly=dosymep.WpfCore"
    mc:Ignorable="d"
    WindowStartupLocation="CenterOwner"
    Title="{me:LocalizationSource SettingsWindow.Title}"
    Width="450"
    Height="320"
    MinWidth="420"
    MinHeight="300"
    d:DataContext="{d:DesignInstance vms:SettingsViewModel, IsDesignTimeCreatable=False}">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary
                    Source="pack://application:,,,/Juru.RevitPlugins.Core;component/Resources/CustomStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <b:Interaction.Triggers>
        <b:EventTrigger
            EventName="Loaded">
            <b:InvokeCommandAction
                Command="{Binding LoadViewCommand}" />
        </b:EventTrigger>
    </b:Interaction.Triggers>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition
                Height="Auto" />
            <RowDefinition
                Height="Auto" />
            <RowDefinition
                Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar
            Grid.Row="0"
            Title="{me:LocalizationSource SettingsWindow.Title}" />

        <Border
            Grid.Row="1"
            Margin="10"
            Style="{StaticResource CustomBorder}">
            <StackPanel>
                <Border
                    Margin="0 0 0 10"
                    Style="{StaticResource CustomBorder}">
                    <DockPanel
                        Margin="14 8"
                        VerticalAlignment="Center">
                        <Label
                            Width="150"
                            Style="{StaticResource CustomLabel}"
                            Content="{me:LocalizationSource SettingsWindow.Language}" />
                        <ComboBox
                            DisplayMemberPath="Title"
                            ToolTip="{me:LocalizationSource SettingsWindow.LanguageTooltip}"
                            ItemsSource="{Binding Languages}"
                            SelectedItem="{Binding SelectedLanguage}" />
                    </DockPanel>
                </Border>
                <Border
                    Margin="0 0 0 10"
                    Style="{StaticResource CustomBorder}">
                    <StackPanel>
                        <Label
                            Content="{me:LocalizationSource SettingsWindow.ClashServer}" />
                        <DockPanel
                            Margin="14 8"
                            VerticalAlignment="Center">
                            <Label
                                Width="150"
                                Style="{StaticResource CustomLabel}"
                                Content="{me:LocalizationSource SettingsWindow.ServerUrl}" />
                            <ui:TextBox
                                Text="{Binding ClashServerUrl, UpdateSourceTrigger=PropertyChanged}"
                                PlaceholderText="http://localhost:5000" />
                        </DockPanel>
                    </StackPanel>
                </Border>
                <Label
                    Content="{me:LocalizationSource SettingsWindow.ClashDisplay}" />
                <Border
                    Style="{StaticResource CustomBorder}">
                    <StackPanel>
                        
                        <StackPanel
                            Margin="14 8"
                            IsEnabled="{Binding ApplySectionBoxSettings}">
                            <DockPanel
                                VerticalAlignment="Center">
                                <Label
                                    Width="150"
                                    Style="{StaticResource CustomLabel}"
                                    Content="{me:LocalizationSource SettingsWindow.SectionBoxOffset}" />
                                <ui:TextBox
                                    Text="{Binding SectionBoxOffset, UpdateSourceTrigger=PropertyChanged}" />
                            </DockPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <StackPanel
            Grid.Row="2"
            Orientation="Horizontal"
            HorizontalAlignment="Right">

            <ui:TextBlock
                Margin="10"
                Foreground="Orange"
                VerticalAlignment="Center"
                Text="{Binding ErrorText}" />

            <ui:Button
                Margin="10"
                Width="80"
                Appearance="Info"
                Content="{me:LocalizationSource Common.Ok}"
                Click="ButtonOk_Click"
                Command="{Binding AcceptViewCommand}" />

            <ui:Button
                Margin="10"
                Width="80"
                Content="{me:LocalizationSource Common.Cancel}"
                IsCancel="True"
                Click="ButtonCancel_Click" />
        </StackPanel>
    </Grid>
</Window>
