<Window
    x:Class="Juru.RevitPlugins.ClashNavigator.Views.Settings.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:local="clr-namespace:Juru.RevitPlugins.ClashNavigator.Views.Settings"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:vms="clr-namespace:Juru.RevitPlugins.ClashNavigator.ViewModels.Settings"
    xmlns:core="clr-namespace:dosymep.WpfUI.Core"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:me="clr-namespace:dosymep.WpfCore.MarkupExtensions;assembly=dosymep.WpfCore"
    mc:Ignorable="d"
    WindowStartupLocation="CenterOwner"
    Title="{me:LocalizationSource SettingsWindow.Title}"
    Width="450"
    Height="400"
    MinWidth="420"
    MinHeight="380"
    d:DataContext="{d:DesignInstance vms:SettingsViewModel, IsDesignTimeCreatable=False}">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary
                    Source="pack://application:,,,/Juru.RevitPlugins.Core;component/Resources/CustomStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <!-- CustomStyles.xaml даёт стиль флажка только под ключом DefaultCheckBoxStyle:
                 без этой неявной привязки флажок подсветки рисуется системным квадратом. -->
            <Style
                TargetType="CheckBox"
                BasedOn="{StaticResource DefaultCheckBoxStyle}" />
        </ResourceDictionary>
    </Window.Resources>
    <b:Interaction.Triggers>
        <b:EventTrigger
            EventName="Loaded">
            <b:InvokeCommandAction
                Command="{Binding LoadViewCommand}" />
        </b:EventTrigger>
    </b:Interaction.Triggers>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition
                Height="Auto" />
            <RowDefinition
                Height="Auto" />
            <RowDefinition
                Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar
            Grid.Row="0"
            Title="{me:LocalizationSource SettingsWindow.Title}" />

        <Border
            Grid.Row="1"
            Margin="10"
            Style="{StaticResource CustomBorder}">
            <StackPanel>
                <Border
                    Margin="0 0 0 10"
                    Style="{StaticResource CustomBorder}">
                    <DockPanel
                        Margin="14 8"
                        VerticalAlignment="Center">
                        <Label
                            Width="150"
                            Style="{StaticResource CustomLabel}"
                            Content="{me:LocalizationSource SettingsWindow.Language}" />
                        <ComboBox
                            DisplayMemberPath="Title"
                            ToolTip="{me:LocalizationSource SettingsWindow.LanguageTooltip}"
                            ItemsSource="{Binding Languages}"
                            SelectedItem="{Binding SelectedLanguage}" />
                    </DockPanel>
                </Border>
                <Border
                    Margin="0 0 0 10"
                    Style="{StaticResource CustomBorder}">
                    <StackPanel>
                        <Label
                            Content="{me:LocalizationSource SettingsWindow.ClashServer}" />
                        <DockPanel
                            Margin="14 8"
                            VerticalAlignment="Center">
                            <Label
                                Width="150"
                                Style="{StaticResource CustomLabel}"
                                Content="{me:LocalizationSource SettingsWindow.ServerUrl}" />
                            <ui:TextBox
                                Text="{Binding ClashServerUrl, UpdateSourceTrigger=PropertyChanged}"
                                PlaceholderText="http://localhost:5000" />
                        </DockPanel>
                    </StackPanel>
                </Border>
                <Label
                    Content="{me:LocalizationSource SettingsWindow.ClashDisplay}" />
                <Border
                    Style="{StaticResource CustomBorder}">
                    <StackPanel>
                        <CheckBox
                            Margin="14 8 14 0"
                            Content="{me:LocalizationSource SettingsWindow.HighlightClash}"
                            IsChecked="{Binding HighlightClashElements}" />
                        <CheckBox
                            Margin="38 8 14 0"
                            Content="{me:LocalizationSource SettingsWindow.HalftoneOthers}"
                            IsEnabled="{Binding HighlightClashElements}"
                            IsChecked="{Binding HalftoneOtherElements}" />

                        <!-- Цвета подсветки элементов коллизии. Прозрачность - только граней:
                             рёбра остаются непрозрачными, иначе при 100% элемент пропал бы целиком. -->
                        <!-- Две строки разметкой, а не общим DataTemplate: в шаблон
                             me:LocalizationSource попадает невычисленным, и подписи пропали бы. -->
                        <DockPanel
                            Margin="38 8 14 0"
                            IsEnabled="{Binding DataContext.HighlightClashElements, RelativeSource={RelativeSource AncestorType=Window}}"
                            DataContext="{Binding FirstHighlight}">
                            <Label
                                Width="126"
                                Style="{StaticResource CustomLabel}"
                                Content="{me:LocalizationSource SettingsWindow.FirstHighlight}" />
                            <Button
                                Width="30"
                                Height="24"
                                Padding="0"
                                Cursor="Hand"
                                ToolTip="{me:LocalizationSource SettingsWindow.PickColorTooltip}"
                                Command="{Binding PickColorCommand}">
                                <Rectangle
                                    Width="26"
                                    Height="20"
                                    RadiusX="3"
                                    RadiusY="3">
                                    <Rectangle.Fill>
                                        <SolidColorBrush
                                            Color="{Binding Color}" />
                                    </Rectangle.Fill>
                                </Rectangle>
                            </Button>
                            <ui:Button
                                DockPanel.Dock="Right"
                                Margin="8 0 0 0"
                                Padding="6 2"
                                Content="&#x21BA;"
                                ToolTip="{me:LocalizationSource SettingsWindow.ResetColorTooltip}"
                                Command="{Binding ResetCommand}" />
                            <TextBlock
                                DockPanel.Dock="Right"
                                Width="36"
                                Margin="6 0 0 0"
                                VerticalAlignment="Center"
                                TextAlignment="Right"
                                Text="{Binding Transparency, StringFormat={}{0} %}" />
                            <Slider
                                Margin="12 0 0 0"
                                VerticalAlignment="Center"
                                Minimum="0"
                                Maximum="100"
                                SmallChange="5"
                                LargeChange="10"
                                IsSnapToTickEnabled="True"
                                TickFrequency="5"
                                ToolTip="{me:LocalizationSource SettingsWindow.TransparencyTooltip}"
                                Value="{Binding Transparency}" />
                        </DockPanel>
                        <DockPanel
                            Margin="38 8 14 0"
                            IsEnabled="{Binding DataContext.HighlightClashElements, RelativeSource={RelativeSource AncestorType=Window}}"
                            DataContext="{Binding SecondHighlight}">
                            <Label
                                Width="126"
                                Style="{StaticResource CustomLabel}"
                                Content="{me:LocalizationSource SettingsWindow.SecondHighlight}" />
                            <Button
                                Width="30"
                                Height="24"
                                Padding="0"
                                Cursor="Hand"
                                ToolTip="{me:LocalizationSource SettingsWindow.PickColorTooltip}"
                                Command="{Binding PickColorCommand}">
                                <Rectangle
                                    Width="26"
                                    Height="20"
                                    RadiusX="3"
                                    RadiusY="3">
                                    <Rectangle.Fill>
                                        <SolidColorBrush
                                            Color="{Binding Color}" />
                                    </Rectangle.Fill>
                                </Rectangle>
                            </Button>
                            <ui:Button
                                DockPanel.Dock="Right"
                                Margin="8 0 0 0"
                                Padding="6 2"
                                Content="&#x21BA;"
                                ToolTip="{me:LocalizationSource SettingsWindow.ResetColorTooltip}"
                                Command="{Binding ResetCommand}" />
                            <TextBlock
                                DockPanel.Dock="Right"
                                Width="36"
                                Margin="6 0 0 0"
                                VerticalAlignment="Center"
                                TextAlignment="Right"
                                Text="{Binding Transparency, StringFormat={}{0} %}" />
                            <Slider
                                Margin="12 0 0 0"
                                VerticalAlignment="Center"
                                Minimum="0"
                                Maximum="100"
                                SmallChange="5"
                                LargeChange="10"
                                IsSnapToTickEnabled="True"
                                TickFrequency="5"
                                ToolTip="{me:LocalizationSource SettingsWindow.TransparencyTooltip}"
                                Value="{Binding Transparency}" />
                        </DockPanel>

                        <StackPanel
                            Margin="14 8"
                            IsEnabled="{Binding ApplySectionBoxSettings}">
                            <DockPanel
                                VerticalAlignment="Center">
                                <Label
                                    Width="150"
                                    Style="{StaticResource CustomLabel}"
                                    Content="{me:LocalizationSource SettingsWindow.SectionBoxOffset}" />
                                <ui:TextBox
                                    Text="{Binding SectionBoxOffset, UpdateSourceTrigger=PropertyChanged}" />
                            </DockPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <StackPanel
            Grid.Row="2"
            Orientation="Horizontal"
            HorizontalAlignment="Right">

            <ui:TextBlock
                Margin="10"
                Foreground="Orange"
                VerticalAlignment="Center"
                Text="{Binding ErrorText}" />

            <ui:Button
                Margin="10"
                Width="80"
                Appearance="Info"
                Content="{me:LocalizationSource Common.Ok}"
                Click="ButtonOk_Click"
                Command="{Binding AcceptViewCommand}" />

            <ui:Button
                Margin="10"
                Width="80"
                Content="{me:LocalizationSource Common.Cancel}"
                IsCancel="True"
                Click="ButtonCancel_Click" />
        </StackPanel>
    </Grid>
</Window>
