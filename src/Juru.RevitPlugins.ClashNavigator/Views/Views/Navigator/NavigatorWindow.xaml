<platform:WpfUIPlatformWindow x:Class="Juru.RevitPlugins.ClashNavigator.Views.Navigator.NavigatorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:res="clr-namespace:Juru.RevitPlugins.ClashNavigator.Resources"
        xmlns:platform="clr-namespace:dosymep.WpfUI.Core;assembly=Juru.RevitPlugins.Core"
        Title="Навигатор коллизий" Height="650" Width="1200"
        WindowStartupLocation="CenterScreen"
        ExtendsContentIntoTitleBar="True"
        Background="{ui:ThemeResource ApplicationBackgroundBrush}"
        Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}">
    <platform:WpfUIPlatformWindow.Resources>
        <res:DictionaryIndexerConverter x:Key="DictionaryIndexerConverter" />

        <DataTemplate x:Key="FilterHeaderTemplate">
            <DockPanel LastChildFill="False">
                <TextBlock Text="{Binding}" VerticalAlignment="Center" />
                <Grid DockPanel.Dock="Right">
                    <Grid.DataContext>
                        <MultiBinding Converter="{StaticResource DictionaryIndexerConverter}">
                            <Binding Path="DataContext.SelectedReport.ColumnFilters"
                                     RelativeSource="{RelativeSource AncestorType=Window}" />
                            <Binding ElementName="FilterButton" Path="Tag" />
                        </MultiBinding>
                    </Grid.DataContext>
                    <Button x:Name="FilterButton" Content="▼" Padding="5,0" Margin="4,0,0,0"
                            Tag="{Binding RelativeSource={RelativeSource AncestorType=DataGridColumnHeader}, Path=Column.SortMemberPath}"
                            Command="{Binding OpenCommand}" />
                    <Popup IsOpen="{Binding IsOpen, Mode=TwoWay}" PlacementTarget="{Binding ElementName=FilterButton}"
                           Placement="Bottom" StaysOpen="True" AllowsTransparency="False">
                        <Border Background="White"
                                BorderBrush="Gray"
                                TextElement.Foreground="Black"
                                BorderThickness="1" Padding="8" MinWidth="200">
                            <DockPanel>
                                <ui:TextBox DockPanel.Dock="Top" Margin="0,0,0,6"
                                            PlaceholderText="Поиск..."
                                            Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                                    <Button Content="Все" Command="{Binding SelectAllCommand}" Margin="0,0,6,0" />
                                    <Button Content="Очистить" Command="{Binding ClearCommand}" />
                                </StackPanel>
                                <Button DockPanel.Dock="Bottom" Content="Применить"
                                        Command="{Binding ApplyCommand}" Margin="0,6,0,0" />
                                <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="220">
                                    <ItemsControl ItemsSource="{Binding FilteredOptions}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <CheckBox Content="{Binding Value}" IsChecked="{Binding IsChecked}" Margin="0,2" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </DockPanel>
                        </Border>
                    </Popup>
                </Grid>
            </DockPanel>
        </DataTemplate>
    </platform:WpfUIPlatformWindow.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- FluentWindow берёт область перетаскивания и кнопки окна из TitleBar. -->
        <ui:TitleBar Grid.Row="0" Title="Навигатор коллизий"
                     ShowMinimize="True" ShowMaximize="True" ShowClose="True"/>

    <Grid Grid.Row="1" Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,0,10">
            <TextBlock Text="Навигатор коллизий" FontSize="20" FontWeight="SemiBold" DockPanel.Dock="Left"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <ui:Button Content="Загрузить XML" Command="{Binding LoadCommand}"  Margin="0,0,8,0"/>
                <ui:Button Content="Загрузить с сервера" Command="{Binding LoadFromServerCommand}" Margin="0,0,8,0"/>
                <ui:Button Content="Сохранить все" Command="{Binding SaveAllReportsCommand}"/>
            </StackPanel>
        </DockPanel>

        <DockPanel Grid.Row="1" Margin="0,0,0,10">
            <ComboBox ItemsSource="{Binding Reports}" SelectedItem="{Binding SelectedReport}"
                      DisplayMemberPath="Name" MinWidth="300"
                      ToolTip="Выберите отчёт из загруженного XML" />
            <TextBlock Margin="12,4,0,0" Foreground="MediumVioletRed"
                       Text="{Binding SelectedReport.ImportedClashesCount, StringFormat=Импортировано коллизий: {0}}" />
            <TextBlock Margin="12,4,0,0" Foreground="MediumVioletRed"
                       Text="{Binding SelectedReport.ResolvedClashesCount, StringFormat=Найдено пар в Revit: {0}}" />
        </DockPanel>

        <DataGrid x:Name="ClashesGrid" Grid.Row="3" ItemsSource="{Binding SelectedReport.GuiClashes}"
                  SelectedItem="{Binding SelectedReport.SelectedGuiClash}" AutoGenerateColumns="False"
                  CanUserAddRows="False" IsReadOnly="True" HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal" BorderThickness="1"
                  BorderBrush="{ui:ThemeResource ControlElevationBorderBrush}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Коллизия" Binding="{Binding ClashName}" SortMemberPath="ClashName" HeaderTemplate="{StaticResource FilterHeaderTemplate}" Width="120" />
                <DataGridTextColumn Header="Файл 1" Binding="{Binding FirstDocumentName}" SortMemberPath="FirstDocumentName" HeaderTemplate="{StaticResource FilterHeaderTemplate}" Width="*" />
                <DataGridTextColumn Header="ID 1" Binding="{Binding FirstId}" SortMemberPath="FirstId" HeaderTemplate="{StaticResource FilterHeaderTemplate}" Width="100" />
                <DataGridTextColumn Header="Файл 2" Binding="{Binding SecondDocumentName}" SortMemberPath="SecondDocumentName" HeaderTemplate="{StaticResource FilterHeaderTemplate}" Width="*" />
                <DataGridTextColumn Header="ID 2" Binding="{Binding SecondId}" SortMemberPath="SecondId" HeaderTemplate="{StaticResource FilterHeaderTemplate}" Width="100" />
                <DataGridTextColumn Header="Статус" Binding="{Binding ClashStatusName}" SortMemberPath="ClashStatusName" HeaderTemplate="{StaticResource FilterHeaderTemplate}" Width="130" />
                <DataGridTemplateColumn Header="Снимок" Width="145">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Image Source="{Binding ImagePath}" Height="70" Stretch="Uniform" ToolTip="{Binding ImagePath}"
                                   Cursor="Hand" MouseLeftButtonUp="ClashImage_Click" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Revit" Width="110">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ui:Button Content="Показать" IsEnabled="{Binding IsResolved}"
                                Command="{Binding DataContext.SelectClashCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <ui:Button Content="Закрыть" Click="ButtonCancel_Click"/>
        </StackPanel>
    </Grid>
    </Grid>
</platform:WpfUIPlatformWindow>
