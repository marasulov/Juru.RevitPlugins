<platform:WpfUIPlatformWindow x:Class="Juru.RevitPlugins.ClashNavigator.Views.Navigator.NavigatorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:res="clr-namespace:Juru.RevitPlugins.ClashNavigator.Resources"
        xmlns:platform="clr-namespace:dosymep.WpfUI.Core;assembly=Juru.RevitPlugins.Core"
        xmlns:me="clr-namespace:dosymep.WpfCore.MarkupExtensions;assembly=dosymep.WpfCore"
        xmlns:loc="clr-namespace:Juru.RevitPlugins.ClashNavigator.Views"
        Title="{me:LocalizationSource Navigator.Title}" Height="650" Width="1200"
        WindowStartupLocation="CenterScreen"
        ExtendsContentIntoTitleBar="True"
        Background="{ui:ThemeResource ApplicationBackgroundBrush}"
        Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}"
        Loaded="Window_Loaded"
        Closing="Window_Closing"
        Closed="Window_Closed">
    <platform:WpfUIPlatformWindow.Resources>
        <res:DictionaryIndexerConverter x:Key="DictionaryIndexerConverter" />
        <res:VisibilityToBooleanConverter x:Key="VisibilityToBooleanConverter" />

        <Style x:Key="HeaderGripperStyle" TargetType="Thumb">
            <Setter Property="Width" Value="8" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="SizeWE" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <!-- Background обязателен: без него Thumb не участвует в hit-test
                             и колонку нельзя потянуть за границу заголовка. Именно этим
                             сломан штатный стиль заголовка из WPF-UI. -->
                        <Border Background="Transparent" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Собственный шаблон заголовка колонки: нужен только затем, чтобы вернуть рабочие
             "ручки" изменения ширины (PART_LeftHeaderGripper / PART_RightHeaderGripper). -->
        <Style x:Key="ResizableColumnHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlElevationBorderBrush}" />
            <Setter Property="BorderThickness" Value="0,0,1,1" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridColumnHeader">
                        <Grid>
                            <Border x:Name="HeaderBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    Padding="{TemplateBinding Padding}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <!-- Указатель сортировки слева от названия и мельче: рядом с кнопкой
                                         фильтра он выглядел парной стрелкой, и заголовок читался
                                         как ещё одна колонка, которую пробовали тянуть. -->
                                    <TextBlock x:Name="SortIcon" Text="▲" FontSize="9"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               Margin="0,0,4,0" VerticalAlignment="Center"
                                               Visibility="Collapsed" />
                                    <ContentPresenter Grid.Column="1"
                                        HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                        VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                                </Grid>
                            </Border>
                            <Thumb x:Name="PART_LeftHeaderGripper" HorizontalAlignment="Left"
                                   Style="{StaticResource HeaderGripperStyle}" />
                            <Thumb x:Name="PART_RightHeaderGripper" HorizontalAlignment="Right"
                                   Style="{StaticResource HeaderGripperStyle}" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="HeaderBorder" Property="Background"
                                        Value="{DynamicResource ListViewItemBackgroundPointerOver}" />
                            </Trigger>
                            <Trigger Property="SortDirection" Value="Ascending">
                                <Setter TargetName="SortIcon" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="SortDirection" Value="Descending">
                                <Setter TargetName="SortIcon" Property="Visibility" Value="Visible" />
                                <Setter TargetName="SortIcon" Property="Text" Value="▼" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Панель всплывающего списка. Содержимое Popup живёт в отдельном визуальном дереве,
             поэтому фон и цвет текста берём из темы явно: раньше панель была жёстко белой,
             а элементы WPF-UI в тёмной теме Windows рисовали светлый текст - на белом его не было видно. -->
        <Style x:Key="PopupPanelStyle" TargetType="Border">
            <Setter Property="Background" Value="{ui:ThemeResource ApplicationBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{ui:ThemeResource ControlElevationBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8" />
            <Setter Property="TextBlock.Foreground" Value="{ui:ThemeResource TextFillColorPrimaryBrush}" />
        </Style>

        <!-- Флажкам цвет задаём отдельно: их собственный стиль WPF-UI перекрывает наследование от панели. -->
        <Style x:Key="PopupCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{ui:ThemeResource TextFillColorPrimaryBrush}" />
            <Setter Property="Margin" Value="0,2" />
        </Style>

        <DataTemplate x:Key="FilterHeaderTemplate">
            <DockPanel LastChildFill="False">
                <TextBlock Text="{Binding}" VerticalAlignment="Center" />
                <Grid DockPanel.Dock="Right">
                    <Grid.DataContext>
                        <MultiBinding Converter="{StaticResource DictionaryIndexerConverter}">
                            <Binding Path="DataContext.SelectedReport.ColumnFilters"
                                     RelativeSource="{RelativeSource AncestorType=Window}" />
                            <Binding ElementName="FilterButton" Path="Tag" />
                        </MultiBinding>
                    </Grid.DataContext>
                    <!-- Воронка вместо треугольника: иначе кнопка фильтра не отличалась от указателя
                         сортировки. Глиф из Segoe MDL2 Assets - шрифт есть в самой Windows,
                         иконки WPF-UI сюда тянуть незачем. -->
                    <Button x:Name="FilterButton" Padding="5,0" Margin="4,0,0,0"
                            ToolTip="{Binding FilterTooltip}"
                            Tag="{Binding RelativeSource={RelativeSource AncestorType=DataGridColumnHeader}, Path=Column.SortMemberPath}"
                            Command="{Binding OpenCommand}">
                        <TextBlock Text="&#xE71C;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                   VerticalAlignment="Center" />
                    </Button>
                    <!-- StaysOpen=False закрывает фильтр по щелчку вне него; двусторонняя привязка IsOpen
                         сообщает об этом модели, а Closed применяет отмеченное - иначе выбор пользователя
                         остался бы в галочках, но не в таблице. -->
                    <Popup IsOpen="{Binding IsOpen, Mode=TwoWay}" PlacementTarget="{Binding ElementName=FilterButton}"
                           Placement="Bottom" StaysOpen="False" AllowsTransparency="False"
                           Closed="FilterPopup_Closed">
                        <Border Style="{StaticResource PopupPanelStyle}" MinWidth="200">
                            <DockPanel>
                                <ui:TextBox DockPanel.Dock="Top" Margin="0,0,0,6"
                                            PlaceholderText="{Binding SearchPlaceholder}"
                                            Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                                    <Button Content="{Binding SelectAllTitle}" Command="{Binding SelectAllCommand}" Margin="0,0,6,0" />
                                    <Button Content="{Binding ClearTitle}" Command="{Binding ClearCommand}" />
                                </StackPanel>
                                <Button DockPanel.Dock="Bottom" Content="{Binding ApplyTitle}"
                                        Command="{Binding ApplyCommand}" Margin="0,6,0,0" />
                                <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="220">
                                    <ItemsControl ItemsSource="{Binding FilteredOptions}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <CheckBox Content="{Binding Value}" IsChecked="{Binding IsChecked}"
                                                          Style="{StaticResource PopupCheckBoxStyle}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </DockPanel>
                        </Border>
                    </Popup>
                </Grid>
            </DockPanel>
        </DataTemplate>
    </platform:WpfUIPlatformWindow.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- FluentWindow берёт область перетаскивания и кнопки окна из TitleBar. -->
        <!-- Заголовок берём из модели представления: он содержит время сборки плагина,
             по которому видно, не держит ли Ревит прежнюю загруженную сборку. -->
        <ui:TitleBar Grid.Row="0" Title="{Binding Title}"
                     ShowMinimize="True" ShowMaximize="True" ShowClose="True"/>

    <Grid Grid.Row="1" Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,0,10">
            <TextBlock Text="{me:LocalizationSource Navigator.Title}" FontSize="20" FontWeight="SemiBold" DockPanel.Dock="Left"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <ui:Button Content="{me:LocalizationSource Navigator.LoadXml}" Command="{Binding LoadCommand}"  Margin="0,0,8,0"/>
                <ui:Button Content="{me:LocalizationSource Navigator.LoadFromServer}" Command="{Binding LoadFromServerCommand}" Margin="0,0,8,0"/>
                <CheckBox Content="{me:LocalizationSource Navigator.AutoLoad}" IsChecked="{Binding AutoLoadFromServer}"
                          VerticalAlignment="Center" Margin="0,0,8,0"
                          ToolTip="{me:LocalizationSource Navigator.AutoLoadTooltip}"/>
                <!-- Отдельная кнопка отправки: количество в надписи отвечает на вопрос,
                     сколько изменений ждёт сервера, а результат всегда показывается диалогом. -->
                <!-- Без Appearance=Primary: акцентная кисть WPF-UI в этом окне не подхватывается,
                     и кнопка выходила белым текстом на белом фоне - надписи не было видно. -->
                <ui:Button Content="{Binding SendStatusesTitle}" Command="{Binding SendStatusesCommand}"
                           FontWeight="SemiBold" Margin="0,0,8,0"
                           Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}"
                           ToolTip="{me:LocalizationSource Navigator.SendStatusesTooltip}"/>
                <ui:Button Content="{me:LocalizationSource Navigator.SaveAll}" Command="{Binding SaveAllReportsCommand}" Margin="0,0,8,0"/>
                <!-- ClickMode=Press: иначе клик по кнопке при открытом Popup перехватывается им,
                     и кнопка остаётся нажатой при закрытом списке. -->
                <ui:Button Content="{me:LocalizationSource Navigator.ResetFilters}" Command="{Binding SelectedReport.ResetFiltersCommand}"
                           Margin="0,0,8,0"
                           ToolTip="{me:LocalizationSource Navigator.ResetFiltersTooltip}"/>
                <ToggleButton x:Name="ColumnsToggle" Content="{me:LocalizationSource Navigator.Columns}" ClickMode="Press"
                              ToolTip="{me:LocalizationSource Navigator.ColumnsTooltip}"/>
                <Popup IsOpen="{Binding IsChecked, ElementName=ColumnsToggle}"
                       PlacementTarget="{Binding ElementName=ColumnsToggle}"
                       Placement="Bottom" StaysOpen="False" AllowsTransparency="False">
                    <Border Style="{StaticResource PopupPanelStyle}" MinWidth="180">
                        <ItemsControl ItemsSource="{Binding Columns, ElementName=ClashesGrid}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Content="{Binding Header}"
                                              Style="{StaticResource PopupCheckBoxStyle}"
                                              IsChecked="{Binding Visibility, Mode=TwoWay,
                                                  Converter={StaticResource VisibilityToBooleanConverter}}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                </Popup>
            </StackPanel>
        </DockPanel>

        <DockPanel Grid.Row="1" Margin="0,0,0,10">
            <ComboBox ItemsSource="{Binding Reports}" SelectedItem="{Binding SelectedReport}"
                      DisplayMemberPath="Name" MinWidth="300"
                      ToolTip="{me:LocalizationSource Navigator.ReportsTooltip}" />
            <TextBlock Margin="12,4,0,0" Foreground="MediumVioletRed"
                       Text="{Binding SelectedReport.ImportedClashesInfo}" />
            <TextBlock Margin="12,4,0,0" Foreground="MediumVioletRed"
                       Text="{Binding SelectedReport.ResolvedClashesInfo}" />
            <!-- Сколько строк осталось после фильтра. Пусто, когда фильтров нет. -->
            <TextBlock Margin="12,4,0,0" FontWeight="SemiBold"
                       Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}"
                       Text="{Binding SelectedReport.FilterInfo}" />
        </DockPanel>

        <!-- VirtualizationMode=Standard вместо принятого в DataGrid Recycling: переиспользование строк
             отдаёт списку статусов ячейку от другой коллизии, и выбор уходит не в ту строку. -->
        <DataGrid x:Name="ClashesGrid" Grid.Row="3" ItemsSource="{Binding SelectedReport.GuiClashes}"
                  SelectedItem="{Binding SelectedReport.SelectedGuiClash}" AutoGenerateColumns="False"
                  CanUserAddRows="False" IsReadOnly="True" HeadersVisibility="Column"
                  CanUserResizeColumns="True" CanUserResizeRows="False" MinColumnWidth="40"
                  VirtualizingPanel.VirtualizationMode="Standard"
                  ColumnHeaderStyle="{StaticResource ResizableColumnHeaderStyle}"
                  Loaded="ClashesGrid_Loaded"
                  GridLinesVisibility="Horizontal" BorderThickness="1"
                  BorderBrush="{ui:ThemeResource ControlElevationBorderBrush}">
            <DataGrid.Columns>
                <DataGridTextColumn loc:ColumnLocalization.Key="Navigator.Column.ClashName" Binding="{Binding ClashName}" SortMemberPath="ClashName" HeaderTemplate="{StaticResource FilterHeaderTemplate}" Width="120" />
                <DataGridTextColumn loc:ColumnLocalization.Key="Navigator.Column.FirstFile" Binding="{Binding FirstDocumentName}" SortMemberPath="FirstDocumentName" HeaderTemplate="{StaticResource FilterHeaderTemplate}" Width="*" />
                <DataGridTextColumn loc:ColumnLocalization.Key="Navigator.Column.FirstId" Binding="{Binding FirstId}" SortMemberPath="FirstId" HeaderTemplate="{StaticResource FilterHeaderTemplate}" Width="100" />
                <DataGridTextColumn loc:ColumnLocalization.Key="Navigator.Column.FirstElement" Binding="{Binding FirstObjectName}" SortMemberPath="FirstObjectName" HeaderTemplate="{StaticResource FilterHeaderTemplate}" Width="*" />
                <DataGridTextColumn loc:ColumnLocalization.Key="Navigator.Column.SecondFile" Binding="{Binding SecondDocumentName}" SortMemberPath="SecondDocumentName" HeaderTemplate="{StaticResource FilterHeaderTemplate}" Width="*" />
                <DataGridTextColumn loc:ColumnLocalization.Key="Navigator.Column.SecondId" Binding="{Binding SecondId}" SortMemberPath="SecondId" HeaderTemplate="{StaticResource FilterHeaderTemplate}" Width="100" />
                <DataGridTextColumn loc:ColumnLocalization.Key="Navigator.Column.SecondElement" Binding="{Binding SecondObjectName}" SortMemberPath="SecondObjectName" HeaderTemplate="{StaticResource FilterHeaderTemplate}" Width="*" />
                <!-- Статус меняется прямо в таблице: выбор в списке уходит на сервер коллизий
                     вместе с учётной записью Windows. Если выделено несколько строк,
                     статус применяется ко всем выделенным. -->
                <DataGridTemplateColumn loc:ColumnLocalization.Key="Navigator.Column.Status" SortMemberPath="ClashStatusName"
                                        HeaderTemplate="{StaticResource FilterHeaderTemplate}" Width="150">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Grid>
                                <!-- Список статусов берём из самой коллизии, а не через окно-предок:
                                     привязка через окно срабатывала позже установки выбранного значения,
                                     и выбор пользователя не доходил до модели - статус менялся только на вид. -->
                                <!-- Выбранный статус пишем в модель из обработчика SelectionChanged,
                                     а не двусторонней привязкой: в ячейке DataGrid запись SelectedValue
                                     в источник не доходила, статус менялся только на вид. -->
                                <ComboBox x:Name="StatusBox"
                                    ItemsSource="{Binding Statuses}"
                                    DisplayMemberPath="Name"
                                    SelectedValuePath="Status"
                                    SelectedValue="{Binding ClashStatus, Mode=OneWay}"
                                    SelectionChanged="StatusBox_SelectionChanged"
                                    Margin="0,2"
                                    ToolTip="{Binding DataContext.StatusTooltip, RelativeSource={RelativeSource AncestorType=Window}}" />
                                <!-- У коллизии "Нет пересечения" статус не выбирают: показываем его текстом. -->
                                <TextBlock x:Name="StatusText" Text="{Binding ClashStatusName}"
                                           VerticalAlignment="Center" Visibility="Collapsed" />
                            </Grid>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding CanChangeStatus}" Value="False">
                                    <Setter TargetName="StatusBox" Property="Visibility" Value="Collapsed" />
                                    <Setter TargetName="StatusText" Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn loc:ColumnLocalization.Key="Navigator.Column.ChangedBy" Binding="{Binding StatusAuthorInfo}" SortMemberPath="StatusAuthorInfo" HeaderTemplate="{StaticResource FilterHeaderTemplate}" Width="180" />
                <DataGridTextColumn loc:ColumnLocalization.Key="Navigator.Column.ChangedAt" Binding="{Binding StatusChangedAt}" SortMemberPath="StatusChangedAt" HeaderTemplate="{StaticResource FilterHeaderTemplate}" Width="130" />
                <DataGridTemplateColumn loc:ColumnLocalization.Key="Navigator.Column.Snapshot"
                                        SortMemberPath="ImagePath" CanUserSort="False" Width="145">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Image Source="{Binding ImagePath}" Height="70" Stretch="Uniform" ToolTip="{Binding ImagePath}"
                                   Cursor="Hand" MouseLeftButtonUp="ClashImage_Click" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Revit"
                                        SortMemberPath="RevitHint" CanUserSort="False" Width="110">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <!-- ShowOnDisabled: подсказка нужна именно у выключенной кнопки -
                                 иначе причина, по которой коллизию не показать, остаётся неизвестной. -->
                            <ui:Button Content="{Binding DataContext.ShowTitle, RelativeSource={RelativeSource AncestorType=Window}}" IsEnabled="{Binding IsResolved}"
                                ToolTip="{Binding RevitHint}" ToolTipService.ShowOnDisabled="True"
                                Command="{Binding DataContext.SelectClashCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <DockPanel Grid.Row="4" Margin="0,15,0,0">
            <ui:Button DockPanel.Dock="Right" Content="{me:LocalizationSource Common.Close}" Click="ButtonCancel_Click"/>
            <!-- Строка состояния: результат отправки статуса на сервер и сообщения загрузки отчёта. -->
            <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                       Text="{Binding SelectedReport.Message}" />
            <TextBlock VerticalAlignment="Center" Margin="12,0,0,0" TextTrimming="CharacterEllipsis"
                       FontWeight="SemiBold" Text="{Binding SelectedReport.UnsentStatusesMessage}" />
            <!-- Предупреждение об отчёте без связи с базой: постоянное, до правки статусов. -->
            <TextBlock VerticalAlignment="Center" Margin="12,0,0,0" TextTrimming="CharacterEllipsis"
                       Foreground="OrangeRed" Text="{Binding SelectedReport.ServerLinkInfo}" />
            <!-- Почему кнопки «Показать» неактивны. -->
            <TextBlock VerticalAlignment="Center" Margin="12,0,0,0" TextTrimming="CharacterEllipsis"
                       Foreground="OrangeRed" Text="{Binding SelectedReport.UnresolvedInfo}" />
            <TextBlock VerticalAlignment="Center" Margin="12,0,0,0" TextTrimming="CharacterEllipsis"
                       Foreground="MediumVioletRed" Text="{Binding Diagnostic}" />
        </DockPanel>
    </Grid>
    </Grid>
</platform:WpfUIPlatformWindow>
