<platform:WpfUIPlatformWindow x:Class="Juru.RevitPlugins.ClashNavigator.Views.Navigator.NavigatorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:res="clr-namespace:Juru.RevitPlugins.ClashNavigator.Resources"
        xmlns:platform="clr-namespace:dosymep.WpfUI.Core;assembly=Juru.RevitPlugins.Core"
        Title="Навигатор коллизий" Height="650" Width="1200"
        WindowStartupLocation="CenterScreen"
        ExtendsContentIntoTitleBar="True"
        Background="{ui:ThemeResource ApplicationBackgroundBrush}"
        Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}"
        Loaded="Window_Loaded"
        Closing="Window_Closing"
        Closed="Window_Closed">
    <platform:WpfUIPlatformWindow.Resources>
        <res:DictionaryIndexerConverter x:Key="DictionaryIndexerConverter" />
        <res:VisibilityToBooleanConverter x:Key="VisibilityToBooleanConverter" />

        <Style x:Key="HeaderGripperStyle" TargetType="Thumb">
            <Setter Property="Width" Value="8" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="SizeWE" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <!-- Background обязателен: без него Thumb не участвует в hit-test
                             и колонку нельзя потянуть за границу заголовка. Именно этим
                             сломан штатный стиль заголовка из WPF-UI. -->
                        <Border Background="Transparent" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Собственный шаблон заголовка колонки: нужен только затем, чтобы вернуть рабочие
             "ручки" изменения ширины (PART_LeftHeaderGripper / PART_RightHeaderGripper). -->
        <Style x:Key="ResizableColumnHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlElevationBorderBrush}" />
            <Setter Property="BorderThickness" Value="0,0,1,1" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridColumnHeader">
                        <Grid>
                            <Border x:Name="HeaderBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    Padding="{TemplateBinding Padding}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ContentPresenter
                                        HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                        VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                                    <TextBlock x:Name="SortIcon" Grid.Column="1" Text="▲"
                                               Margin="4,0,0,0" VerticalAlignment="Center"
                                               Visibility="Collapsed" />
                                </Grid>
                            </Border>
                            <Thumb x:Name="PART_LeftHeaderGripper" HorizontalAlignment="Left"
                                   Style="{StaticResource HeaderGripperStyle}" />
                            <Thumb x:Name="PART_RightHeaderGripper" HorizontalAlignment="Right"
                                   Style="{StaticResource HeaderGripperStyle}" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="HeaderBorder" Property="Background"
                                        Value="{DynamicResource ListViewItemBackgroundPointerOver}" />
                            </Trigger>
                            <Trigger Property="SortDirection" Value="Ascending">
                                <Setter TargetName="SortIcon" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="SortDirection" Value="Descending">
                                <Setter TargetName="SortIcon" Property="Visibility" Value="Visible" />
                                <Setter TargetName="SortIcon" Property="Text" Value="▼" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="FilterHeaderTemplate">
            <DockPanel LastChildFill="False">
                <TextBlock Text="{Binding}" VerticalAlignment="Center" />
                <Grid DockPanel.Dock="Right">
                    <Grid.DataContext>
                        <MultiBinding Converter="{StaticResource DictionaryIndexerConverter}">
                            <Binding Path="DataContext.SelectedReport.ColumnFilters"
                                     RelativeSource="{RelativeSource AncestorType=Window}" />
                            <Binding ElementName="FilterButton" Path="Tag" />
                        </MultiBinding>
                    </Grid.DataContext>
                    <Button x:Name="FilterButton" Content="▼" Padding="5,0" Margin="4,0,0,0"
                            Tag="{Binding RelativeSource={RelativeSource AncestorType=DataGridColumnHeader}, Path=Column.SortMemberPath}"
                            Command="{Binding OpenCommand}" />
                    <Popup IsOpen="{Binding IsOpen, Mode=TwoWay}" PlacementTarget="{Binding ElementName=FilterButton}"
                           Placement="Bottom" StaysOpen="True" AllowsTransparency="False">
                        <Border Background="White"
                                BorderBrush="Gray"
                                TextElement.Foreground="Black"
                                BorderThickness="1" Padding="8" MinWidth="200">
                            <DockPanel>
                                <ui:TextBox DockPanel.Dock="Top" Margin="0,0,0,6"
                                            PlaceholderText="Поиск..."
                                            Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                                    <Button Content="Все" Command="{Binding SelectAllCommand}" Margin="0,0,6,0" />
                                    <Button Content="Очистить" Command="{Binding ClearCommand}" />
                                </StackPanel>
                                <Button DockPanel.Dock="Bottom" Content="Применить"
                                        Command="{Binding ApplyCommand}" Margin="0,6,0,0" />
                                <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="220">
                                    <ItemsControl ItemsSource="{Binding FilteredOptions}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <CheckBox Content="{Binding Value}" IsChecked="{Binding IsChecked}" Margin="0,2" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </DockPanel>
                        </Border>
                    </Popup>
                </Grid>
            </DockPanel>
        </DataTemplate>
    </platform:WpfUIPlatformWindow.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- FluentWindow берёт область перетаскивания и кнопки окна из TitleBar. -->
        <!-- Заголовок берём из модели представления: он содержит время сборки плагина,
             по которому видно, не держит ли Ревит прежнюю загруженную сборку. -->
        <ui:TitleBar Grid.Row="0" Title="{Binding Title, FallbackValue=Навигатор коллизий}"
                     ShowMinimize="True" ShowMaximize="True" ShowClose="True"/>

    <Grid Grid.Row="1" Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,0,10">
            <TextBlock Text="Навигатор коллизий" FontSize="20" FontWeight="SemiBold" DockPanel.Dock="Left"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <ui:Button Content="Загрузить XML" Command="{Binding LoadCommand}"  Margin="0,0,8,0"/>
                <ui:Button Content="Загрузить с сервера" Command="{Binding LoadFromServerCommand}" Margin="0,0,8,0"/>
                <CheckBox Content="При открытии" IsChecked="{Binding AutoLoadFromServer}"
                          VerticalAlignment="Center" Margin="0,0,8,0"
                          ToolTip="Загружать отчёт с сервера сразу при открытии навигатора"/>
                <ui:Button Content="Сохранить все" Command="{Binding SaveAllReportsCommand}" Margin="0,0,8,0"/>
                <!-- ClickMode=Press: иначе клик по кнопке при открытом Popup перехватывается им,
                     и кнопка остаётся нажатой при закрытом списке. -->
                <ToggleButton x:Name="ColumnsToggle" Content="Колонки" ClickMode="Press"
                              ToolTip="Показать или скрыть колонки таблицы"/>
                <Popup IsOpen="{Binding IsChecked, ElementName=ColumnsToggle}"
                       PlacementTarget="{Binding ElementName=ColumnsToggle}"
                       Placement="Bottom" StaysOpen="False" AllowsTransparency="False">
                    <Border Background="White"
                            BorderBrush="Gray"
                            TextElement.Foreground="Black"
                            BorderThickness="1" Padding="8" MinWidth="180">
                        <ItemsControl ItemsSource="{Binding Columns, ElementName=ClashesGrid}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Content="{Binding Header}" Margin="0,2"
                                              IsChecked="{Binding Visibility, Mode=TwoWay,
                                                  Converter={StaticResource VisibilityToBooleanConverter}}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                </Popup>
            </StackPanel>
        </DockPanel>

        <DockPanel Grid.Row="1" Margin="0,0,0,10">
            <ComboBox ItemsSource="{Binding Reports}" SelectedItem="{Binding SelectedReport}"
                      DisplayMemberPath="Name" MinWidth="300"
                      ToolTip="Выберите отчёт из загруженного XML" />
            <TextBlock Margin="12,4,0,0" Foreground="MediumVioletRed"
                       Text="{Binding SelectedReport.ImportedClashesCount, StringFormat=Импортировано коллизий: {0}}" />
            <TextBlock Margin="12,4,0,0" Foreground="MediumVioletRed"
                       Text="{Binding SelectedReport.ResolvedClashesCount, StringFormat=Найдено пар в Revit: {0}}" />
        </DockPanel>

        <DataGrid x:Name="ClashesGrid" Grid.Row="3" ItemsSource="{Binding SelectedReport.GuiClashes}"
                  SelectedItem="{Binding SelectedReport.SelectedGuiClash}" AutoGenerateColumns="False"
                  CanUserAddRows="False" IsReadOnly="True" HeadersVisibility="Column"
                  CanUserResizeColumns="True" CanUserResizeRows="False" MinColumnWidth="40"
                  ColumnHeaderStyle="{StaticResource ResizableColumnHeaderStyle}"
                  Loaded="ClashesGrid_Loaded"
                  GridLinesVisibility="Horizontal" BorderThickness="1"
                  BorderBrush="{ui:ThemeResource ControlElevationBorderBrush}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Коллизия" Binding="{Binding ClashName}" SortMemberPath="ClashName" HeaderTemplate="{StaticResource FilterHeaderTemplate}" Width="120" />
                <DataGridTextColumn Header="Файл 1" Binding="{Binding FirstDocumentName}" SortMemberPath="FirstDocumentName" HeaderTemplate="{StaticResource FilterHeaderTemplate}" Width="*" />
                <DataGridTextColumn Header="ID 1" Binding="{Binding FirstId}" SortMemberPath="FirstId" HeaderTemplate="{StaticResource FilterHeaderTemplate}" Width="100" />
                <DataGridTextColumn Header="Элемент А" Binding="{Binding FirstObjectName}" SortMemberPath="FirstObjectName" HeaderTemplate="{StaticResource FilterHeaderTemplate}" Width="*" />
                <DataGridTextColumn Header="Файл 2" Binding="{Binding SecondDocumentName}" SortMemberPath="SecondDocumentName" HeaderTemplate="{StaticResource FilterHeaderTemplate}" Width="*" />
                <DataGridTextColumn Header="ID 2" Binding="{Binding SecondId}" SortMemberPath="SecondId" HeaderTemplate="{StaticResource FilterHeaderTemplate}" Width="100" />
                <DataGridTextColumn Header="Элемент B" Binding="{Binding SecondObjectName}" SortMemberPath="SecondObjectName" HeaderTemplate="{StaticResource FilterHeaderTemplate}" Width="*" />
                <!-- Статус меняется прямо в таблице: выбор в списке уходит на сервер коллизий
                     вместе с учётной записью Windows. Если выделено несколько строк,
                     статус применяется ко всем выделенным. -->
                <DataGridTemplateColumn Header="Статус" SortMemberPath="ClashStatusName"
                                        HeaderTemplate="{StaticResource FilterHeaderTemplate}" Width="150">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Grid>
                                <ComboBox x:Name="StatusBox"
                                    ItemsSource="{Binding DataContext.SelectedReport.ClashStatuses, RelativeSource={RelativeSource AncestorType=Window}}"
                                    DisplayMemberPath="Name"
                                    SelectedValuePath="Status"
                                    SelectedValue="{Binding ClashStatus, Mode=TwoWay}"
                                    Margin="0,2"
                                    ToolTip="Новый статус уйдёт на сервер коллизий по кнопке «Сохранить все»" />
                                <!-- У коллизии "Нет пересечения" статус не выбирают: показываем его текстом. -->
                                <TextBlock x:Name="StatusText" Text="{Binding ClashStatusName}"
                                           VerticalAlignment="Center" Visibility="Collapsed" />
                            </Grid>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding CanChangeStatus}" Value="False">
                                    <Setter TargetName="StatusBox" Property="Visibility" Value="Collapsed" />
                                    <Setter TargetName="StatusText" Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Кем изменён" Binding="{Binding StatusChangedBy}" SortMemberPath="StatusChangedBy" Width="140" />
                <DataGridTextColumn Header="Когда изменён" Binding="{Binding StatusChangedAt}" SortMemberPath="StatusChangedAt" Width="120" />
                <DataGridTemplateColumn Header="Снимок" Width="145">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Image Source="{Binding ImagePath}" Height="70" Stretch="Uniform" ToolTip="{Binding ImagePath}"
                                   Cursor="Hand" MouseLeftButtonUp="ClashImage_Click" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Revit" Width="110">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ui:Button Content="Показать" IsEnabled="{Binding IsResolved}"
                                Command="{Binding DataContext.SelectClashCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <DockPanel Grid.Row="4" Margin="0,15,0,0">
            <ui:Button DockPanel.Dock="Right" Content="Закрыть" Click="ButtonCancel_Click"/>
            <!-- Строка состояния: результат отправки статуса на сервер и сообщения загрузки отчёта. -->
            <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                       Text="{Binding SelectedReport.Message}" />
            <TextBlock VerticalAlignment="Center" Margin="12,0,0,0" TextTrimming="CharacterEllipsis"
                       FontWeight="SemiBold" Text="{Binding SelectedReport.UnsentStatusesMessage}" />
            <TextBlock VerticalAlignment="Center" Margin="12,0,0,0" TextTrimming="CharacterEllipsis"
                       Foreground="MediumVioletRed" Text="{Binding Diagnostic}" />
        </DockPanel>
    </Grid>
    </Grid>
</platform:WpfUIPlatformWindow>
