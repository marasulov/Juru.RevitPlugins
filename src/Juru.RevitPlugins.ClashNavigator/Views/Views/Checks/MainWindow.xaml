<platform:WpfUIPlatformWindow
    x:Class="Juru.RevitPlugins.ClashNavigator.Views.Checks.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="clr-namespace:Juru.RevitPlugins.ClashNavigator.Views"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:wpfbehaviors="clr-namespace:dosymep.WpfCore.Behaviors;assembly=dosymep.WpfCore"
    xmlns:platform="clr-namespace:dosymep.WpfUI.Core;assembly=Juru.RevitPlugins.Core"
    xmlns:clashDetective="clr-namespace:Juru.RevitPlugins.ClashNavigator.ViewModels.ClashDetective"
    xmlns:checks="clr-namespace:Juru.RevitPlugins.ClashNavigator.Views.Checks"
    xmlns:me="clr-namespace:dosymep.WpfCore.MarkupExtensions;assembly=dosymep.WpfCore"
    xmlns:glob="clr-namespace:System.Globalization;assembly=mscorlib"
    mc:Ignorable="d"
    Title="{me:LocalizationSource ChecksWindow.Title}"
    Height="450" Width="800" MinHeight="400" MinWidth="700"
    WindowStartupLocation="CenterScreen"
    Background="{ui:ThemeResource ApplicationBackgroundBrush}"
    Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}"
    d:DataContext="{d:DesignInstance clashDetective:MainViewModel, IsDesignTimeCreatable=False}">

    <platform:WpfUIPlatformWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary
                    Source="pack://application:,,,/Juru.RevitPlugins.Core;component/Resources/CustomStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <!-- Тот же неявный стиль, что и у SelectableNamesWindow.xaml: без него голый CheckBox
                 (колонка выбора проверки) не подхватывает DefaultCheckBoxStyle из CustomStyles.xaml
                 сам по себе. -->
            <Style
                TargetType="CheckBox"
                BasedOn="{StaticResource DefaultCheckBoxStyle}" />
        </ResourceDictionary>
    </platform:WpfUIPlatformWindow.Resources>

    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Closing">
            <i:InvokeCommandAction Command="{Binding AskForSaveCommand}" />
        </i:EventTrigger>
    </i:Interaction.Triggers>

    <!-- Required by UseWpfUIMessageBox: supplies the window theme to the service. -->
    <i:Interaction.Behaviors>
        <wpfbehaviors:WpfAttachServiceBehavior
            AttachableService="{Binding MessageBoxService}" />
    </i:Interaction.Behaviors>

    <!-- FluentWindow убирает системную строку заголовка: без ui:TitleBar окно нечем
         перетащить и нечем закрыть. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar
            Grid.Row="0"
            Title="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}"
            ShowMinimize="True" ShowMaximize="True" ShowClose="True" />

    <Grid Grid.Row="1" Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Верхняя панель инструментов -->
        <DockPanel Grid.Row="0" Margin="0,0,0,10" LastChildFill="True">
            <ui:Button Content="{me:LocalizationSource Common.Load}" ToolTip="{me:LocalizationSource ChecksWindow.LoadTooltip}" Command="{Binding LoadClashCommand}" Margin="0,0,8,0" />
            <ui:Button Content="{me:LocalizationSource Common.Save}" ToolTip="{me:LocalizationSource ChecksWindow.SaveTooltip}" Command="{Binding SaveClashesCommand}" Margin="0,0,8,0" />
            <ui:Button Content="{me:LocalizationSource Common.SaveAs}" ToolTip="{me:LocalizationSource ChecksWindow.SaveAsTooltip}" Command="{Binding SaveAsClashesCommand}" Margin="0,0,8,0" />
            <ui:Button Content="{me:LocalizationSource Export.Button}" ToolTip="{me:LocalizationSource Export.ChecksTooltip}" Command="{Binding ExportNavisworksCommand}" Margin="0,0,8,0" />
            <ui:Button Content="{me:LocalizationSource ChecksWindow.AddCheck}" Command="{Binding AddCheckCommand}" Margin="0,0,8,0" />

            <ui:Button Appearance="Danger" Content="{me:LocalizationSource ChecksWindow.RemoveCheck}"
                       ToolTip="{me:LocalizationSource ChecksWindow.RemoveCheckTooltip}"
                       CommandParameter="{Binding SelectedItems, ElementName=ChecksGrid}"
                       Command="{Binding RemoveCheckCommand}" />

            <ui:TextBox DockPanel.Dock="Right" MinWidth="300" MaxWidth="300" HorizontalAlignment="Right" 
                        Text="{Binding ChecksFilter, UpdateSourceTrigger=PropertyChanged}" 
                        PlaceholderText="{me:LocalizationSource ChecksWindow.SearchPlaceholder}" />
        </DockPanel>

        <!-- Строки таблицы высокие и разной высоты: в каждой стоят две выборки со своими
             подписями. Виртуализация строк на таких строках держит устаревшие смещения - после
             удаления строки её место оставалось пустым, а следующая добавленная уезжала вниз на
             высоту удалённой. Проверок единицы, поэтому виртуализация тут не нужна вовсе.
             CanUserAddRows: иначе таблица дорисовывает в конце пустую строку-заготовку во всю
             высоту шаблона; проверки добавляются кнопкой. -->
        <DataGrid x:Name="ChecksGrid" Grid.Row="1" SelectionMode="Extended" Tag="{Binding}" 
                  AutoGenerateColumns="False" CanUserDeleteRows="False" CanUserReorderColumns="False" 
                  CanUserAddRows="False"
                  EnableRowVirtualization="False" EnableColumnVirtualization="False"
                  GridLinesVisibility="Horizontal" BorderThickness="1" 
                  BorderBrush="{ui:ThemeResource ControlElevationBorderBrush}"
                  SelectedItem="{Binding SelectedCheck}" 
                  ItemsSource="{Binding Checks.View, UpdateSourceTrigger=PropertyChanged}">
            <DataGrid.Columns>

                <!-- Колонка с чекбоксом и иконкой ошибки. Флажок в заголовке отмечает все видимые
                     проверки; привязка через Tag таблицы - из заголовка колонки RelativeSource до
                     окна не дотягивается, заголовок попадает в дерево позже привязки. -->
                <DataGridTemplateColumn Width="Auto" CanUserResize="False" CanUserSort="False">
                    <DataGridTemplateColumn.HeaderTemplate>
                        <DataTemplate>
                            <CheckBox Padding="0" HorizontalAlignment="Center" Margin="12,0,0,0"
                                      IsChecked="{Binding Tag.AllChecksSelected, Mode=TwoWay, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.HeaderTemplate>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <DockPanel HorizontalAlignment="Center" Margin="5,0">
                                <TextBlock Text="!" FontWeight="Bold" VerticalAlignment="Center"
                                           ToolTip="{Binding ErrorText}" Margin="0,0,4,0" Foreground="Red">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <!-- Скрываем иконку ошибки, если текст ошибки пустой -->
                                                <DataTrigger Binding="{Binding ErrorText}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding ErrorText}" Value="">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <CheckBox Padding="0" IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" />
                            </DockPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Width="150" CanUserSort="True" SortMemberPath="Name" local:ColumnLocalization.Key="Common.Name">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ui:TextBox VerticalContentAlignment="Center" ToolTip="{Binding Name}" 
                                        Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" 
                                        BorderThickness="0" Background="Transparent" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Width="*" CanUserSort="False" local:ColumnLocalization.Key="ChecksWindow.Files1">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <checks:SelectionView Part="Files" DataContext="{Binding FirstSelection, UpdateSourceTrigger=PropertyChanged}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Width="*" CanUserSort="False" local:ColumnLocalization.Key="ChecksWindow.SearchSets1">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <checks:SelectionView Part="SearchSets" DataContext="{Binding FirstSelection, UpdateSourceTrigger=PropertyChanged}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Width="*" CanUserSort="False" local:ColumnLocalization.Key="ChecksWindow.Files2">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <checks:SelectionView Part="Files" DataContext="{Binding SecondSelection, UpdateSourceTrigger=PropertyChanged}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Width="*" CanUserSort="False" local:ColumnLocalization.Key="ChecksWindow.SearchSets2">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <checks:SelectionView Part="SearchSets" DataContext="{Binding SecondSelection, UpdateSourceTrigger=PropertyChanged}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- Допуск проверки, мм: пересечения мельче не считаются коллизиями. -->
                <DataGridTemplateColumn Width="90" CanUserSort="True" SortMemberPath="Tolerance"
                                        local:ColumnLocalization.Key="ChecksWindow.Tolerance">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ui:TextBox VerticalContentAlignment="Center" HorizontalContentAlignment="Right"
                                        ToolTip="{DynamicResource ChecksWindow.ToleranceTooltip}"
                                        Text="{Binding Tolerance, UpdateSourceTrigger=LostFocus, ConverterCulture={x:Static glob:CultureInfo.CurrentCulture}}"
                                        BorderThickness="0" Background="Transparent" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- Число коллизий в отчёте проверки; прочерк - поиск ещё не запускали. -->
                <DataGridTextColumn Width="80" IsReadOnly="True" CanUserSort="True" SortMemberPath="ClashCount"
                                    local:ColumnLocalization.Key="ChecksWindow.ClashCount"
                                    Binding="{Binding ClashCount, TargetNullValue='—'}">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Right" />
                            <Setter Property="VerticalAlignment" Value="Center" />
                            <Setter Property="Margin" Value="0,0,12,0" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- Кнопка 'Показать коллизии' -->
                <DataGridTemplateColumn Width="Auto" CanUserResize="False" CanUserSort="False">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ui:Button Click="ButtonOk_Click" Command="{Binding ShowClashesCommand}"
                                       Content="{DynamicResource ChecksWindow.ShowClashes}"
                                       ToolTip="{DynamicResource ChecksWindow.ShowClashesTooltip}"
                                       Padding="6,4" Margin="4,2" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Нижняя панель с кнопками ОК/Отмена -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <TextBlock Margin="8" Text="{Binding ErrorText}" Foreground="Red" VerticalAlignment="Center" />
            <TextBlock Margin="8" Text="{Binding MessageText}" VerticalAlignment="Center" />

            <!-- Не Appearance="Primary" - см. комментарий у того же атрибута в FiltersWindow.xaml. -->
            <ui:Button Width="80" Margin="8,0" IsDefault="True" Content="{me:LocalizationSource Common.Ok}" Command="{Binding FindClashesCommand}" />
            <ui:Button Width="80" IsCancel="true" Click="ButtonCancel_Click" Content="{me:LocalizationSource Common.Cancel}" />
        </StackPanel>
    </Grid>
    </Grid>
</platform:WpfUIPlatformWindow>
