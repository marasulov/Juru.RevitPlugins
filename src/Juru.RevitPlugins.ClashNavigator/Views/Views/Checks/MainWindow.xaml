<Window
    x:Class="Juru.RevitPlugins.ClashNavigator.Views.Checks.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="clr-namespace:Juru.RevitPlugins.ClashNavigator.Views"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:wpfbehaviors="clr-namespace:dosymep.WpfCore.Behaviors;assembly=dosymep.WpfCore"
    xmlns:clashDetective="clr-namespace:Juru.RevitPlugins.ClashNavigator.ViewModels.ClashDetective"
    xmlns:checks="clr-namespace:Juru.RevitPlugins.ClashNavigator.Views.Checks"
    mc:Ignorable="d"
    Title="Поиск коллизий"
    Height="450" Width="800" MinHeight="400" MinWidth="700"
    WindowStartupLocation="CenterScreen"
    Background="{ui:ThemeResource ApplicationBackgroundBrush}"
    Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}"
    d:DataContext="{d:DesignInstance clashDetective:MainViewModel, IsDesignTimeCreatable=False}">

    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Closing">
            <i:InvokeCommandAction Command="{Binding AskForSaveCommand}" />
        </i:EventTrigger>
    </i:Interaction.Triggers>

    <!-- Required by UseWpfUIMessageBox: supplies the window theme to the service. -->
    <i:Interaction.Behaviors>
        <wpfbehaviors:WpfAttachServiceBehavior
            AttachableService="{Binding MessageBoxService}" />
    </i:Interaction.Behaviors>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Верхняя панель инструментов -->
        <DockPanel Grid.Row="0" Margin="0,0,0,10" LastChildFill="True">
            <ui:Button ToolTip="Загрузить" Command="{Binding LoadClashCommand}" Icon="{ui:SymbolIcon Symbol=ArrowDownload20}" Margin="0,0,8,0" />
            <ui:Button ToolTip="Сохранить" Command="{Binding SaveClashesCommand}" Icon="{ui:SymbolIcon Symbol=Save20}" Margin="0,0,8,0" />
            <ui:Button ToolTip="Сохранить как..." Command="{Binding SaveAsClashesCommand}" Icon="{ui:SymbolIcon Symbol=SaveEdit20}" Margin="0,0,8,0" />
            <ui:Button ToolTip="Добавить проверку" Command="{Binding AddCheckCommand}" Icon="{ui:SymbolIcon Symbol=Add20}" Margin="0,0,8,0" />

            <ui:Button Appearance="Danger" ToolTip="Удалить проверку" 
                       CommandParameter="{Binding SelectedItems, ElementName=ChecksGrid}" 
                       Command="{Binding RemoveCheckCommand}" 
                       Icon="{ui:SymbolIcon Symbol=Delete20}" />

            <ui:TextBox DockPanel.Dock="Right" MinWidth="300" MaxWidth="300" HorizontalAlignment="Right" 
                        Text="{Binding ChecksFilter, UpdateSourceTrigger=PropertyChanged}" 
                        PlaceholderText="Поиск проверок..." />
        </DockPanel>

        <!-- Стандартная таблица -->
        <DataGrid x:Name="ChecksGrid" Grid.Row="1" SelectionMode="Extended" 
                  AutoGenerateColumns="False" CanUserDeleteRows="False" CanUserReorderColumns="False" 
                  GridLinesVisibility="Horizontal" BorderThickness="1" 
                  BorderBrush="{ui:ThemeResource ControlElevationBorderBrush}"
                  SelectedItem="{Binding SelectedCheck}" 
                  ItemsSource="{Binding Checks.View, UpdateSourceTrigger=PropertyChanged}">
            <DataGrid.Columns>

                <!-- Колонка с чекбоксом и иконкой ошибки -->
                <DataGridTemplateColumn Width="Auto" CanUserResize="False" CanUserSort="False">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <DockPanel HorizontalAlignment="Center" Margin="5,0">
                                <ui:SymbolIcon Symbol="Warning20" ToolTip="{Binding ErrorText}" Margin="0,0,4,0" Foreground="Red">
                                    <ui:SymbolIcon.Style>
                                        <Style TargetType="ui:SymbolIcon">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <!-- Скрываем иконку ошибки, если текст ошибки пустой -->
                                                <DataTrigger Binding="{Binding ErrorText}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding ErrorText}" Value="">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ui:SymbolIcon.Style>
                                </ui:SymbolIcon>
                                <CheckBox Padding="0" IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" />
                            </DockPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Width="150" CanUserSort="True" SortMemberPath="Name" Header="Имя">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ui:TextBox VerticalContentAlignment="Center" ToolTip="{Binding Name}" 
                                        Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" 
                                        BorderThickness="0" Background="Transparent" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Width="*" CanUserSort="False" Header="Выборка 1">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <checks:SelectionView DataContext="{Binding FirstSelection, UpdateSourceTrigger=PropertyChanged}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Width="*" CanUserSort="False" Header="Выборка 2">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <checks:SelectionView DataContext="{Binding SecondSelection, UpdateSourceTrigger=PropertyChanged}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- Кнопка 'Показать коллизии' -->
                <DataGridTemplateColumn Width="Auto" CanUserResize="False" CanUserSort="False">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ui:Button Click="ButtonOk_Click" Command="{Binding ShowClashesCommand}" 
                                       ToolTip="Показать коллизии" Icon="{ui:SymbolIcon Symbol=Notebook20}" 
                                       Padding="6,4" Margin="4,2" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Нижняя панель с кнопками ОК/Отмена -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <TextBlock Margin="8" Text="{Binding ErrorText}" Foreground="Red" VerticalAlignment="Center" />
            <TextBlock Margin="8" Text="{Binding MessageText}" VerticalAlignment="Center" />

            <ui:Button Width="80" Margin="8,0" IsDefault="True" Content="ОК" Appearance="Primary" Command="{Binding FindClashesCommand}" />
            <ui:Button Width="80" IsCancel="true" Click="ButtonCancel_Click" Content="Отмена" />
        </StackPanel>
    </Grid>
</Window>
