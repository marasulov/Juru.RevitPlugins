<platform:WpfUIPlatformWindow
    x:Class="Juru.RevitPlugins.ClashNavigator.Views.Filters.FiltersWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:wpfbehaviors="clr-namespace:dosymep.WpfCore.Behaviors;assembly=dosymep.WpfCore"
    xmlns:platform="clr-namespace:dosymep.WpfUI.Core;assembly=Juru.RevitPlugins.Core"
    xmlns:searchSet="clr-namespace:Juru.RevitPlugins.ClashNavigator.ViewModels.SearchSet"
    xmlns:res="clr-namespace:Juru.RevitPlugins.ClashNavigator.Resources"
    xmlns:me="clr-namespace:dosymep.WpfCore.MarkupExtensions;assembly=dosymep.WpfCore"
    mc:Ignorable="d"
    Title="{me:LocalizationSource SearchSets.Title}"
    Height="600" Width="1000" MinHeight="450" MinWidth="800"
    WindowStartupLocation="CenterScreen"
    Background="{ui:ThemeResource ApplicationBackgroundBrush}"
    Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}"
    d:DataContext="{d:DesignInstance searchSet:FiltersViewModel, IsDesignTimeCreatable=False}">

    <!-- Required by UseWpfUIMessageBox: supplies the window theme to the service. -->
    <i:Interaction.Behaviors>
        <wpfbehaviors:WpfAttachServiceBehavior
            AttachableService="{Binding MessageBoxService}" />
    </i:Interaction.Behaviors>

    <Window.Resources>
        <ResourceDictionary>
            <res:CollectionToStringConverter
                x:Key="CollectionToStringConverter"
                Separator="; " />
            <BooleanToVisibilityConverter
                x:Key="BoolToVisibility" />

            <!-- Правило: параметр, условие, значение. -->
            <DataTemplate
                x:Key="RuleTemplate">
                <Grid
                    Margin="0 2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" MinWidth="150" />
                        <ColumnDefinition Width="*" MinWidth="120" />
                        <ColumnDefinition Width="2*" MinWidth="150" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <ComboBox
                        Grid.Column="0"
                        Margin="0 0 4 0"
                        DisplayMemberPath="Name"
                        ItemsSource="{Binding Providers}"
                        SelectedItem="{Binding SelectedProvider}" />

                    <ComboBox
                        Grid.Column="1"
                        Margin="0 0 4 0"
                        DisplayMemberPath="Message"
                        ItemsSource="{Binding Evaluators}"
                        SelectedItem="{Binding SelectedEvaluator}" />

                    <!-- Список значений собирается по всем документам проверки, поэтому
                         заполняется только когда список раскрыли. -->
                    <ComboBox
                        Grid.Column="2"
                        Margin="0 0 4 0"
                        IsEditable="True"
                        IsEnabled="{Binding IsValueEnabled}"
                        ItemsSource="{Binding Values}"
                        Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}">
                        <i:Interaction.Triggers>
                            <i:EventTrigger
                                EventName="DropDownOpened">
                                <i:InvokeCommandAction
                                    Command="{Binding LoadValuesCommand}" />
                            </i:EventTrigger>
                        </i:Interaction.Triggers>
                    </ComboBox>

                    <ui:Button
                        Grid.Column="3"
                        Appearance="Danger"
                        Content="{DynamicResource Common.Delete}"
                        ToolTip="{DynamicResource SearchSets.DeleteRuleTooltip}"
                        Command="{Binding Parent.RemoveCriterionCommand}"
                        CommandParameter="{Binding}" />
                </Grid>
            </DataTemplate>

            <!-- Набор: условие объединения и вложенные узлы. -->
            <DataTemplate
                x:Key="SetTemplate">
                <Border
                    Margin="0 2"
                    Padding="6"
                    BorderThickness="1"
                    CornerRadius="4"
                    BorderBrush="{ui:ThemeResource ControlElevationBorderBrush}">
                    <StackPanel>
                        <StackPanel
                            Orientation="Horizontal"
                            Margin="0 0 0 4">
                            <ComboBox
                                Width="90"
                                DisplayMemberPath="Message"
                                ItemsSource="{Binding Evaluators}"
                                SelectedItem="{Binding SelectedEvaluator}" />
                            <ui:Button
                                Margin="8 0 0 0"
                                Content="{DynamicResource SearchSets.AddRule}"
                                Command="{Binding AddRuleCommand}" />
                            <ui:Button
                                Margin="8 0 0 0"
                                Content="{DynamicResource SearchSets.AddNestedSet}"
                                Command="{Binding AddSetCommand}" />
                            <ui:Button
                                Margin="8 0 0 0"
                                Appearance="Danger"
                                Content="{DynamicResource Common.Delete}"
                                ToolTip="{DynamicResource SearchSets.DeleteSetTooltip}"
                                Command="{Binding Parent.RemoveCriterionCommand}"
                                CommandParameter="{Binding}"
                                Visibility="{Binding CanRemove, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                        <ItemsControl
                            Margin="16 0 0 0"
                            ItemsSource="{Binding Criteria}"
                            ItemTemplate="{DynamicResource CriterionTemplate}" />
                    </StackPanel>
                </Border>
            </DataTemplate>

            <!-- Узел дерева - правило или вложенный набор. Шаблон выбирается по IsSet:
                 модели представления внутренние, и ссылаться на них из разметки нельзя. -->
            <DataTemplate
                x:Key="CriterionTemplate">
                <ContentControl
                    Content="{Binding}">
                    <ContentControl.Style>
                        <Style
                            TargetType="ContentControl">
                            <Setter
                                Property="ContentTemplate"
                                Value="{StaticResource RuleTemplate}" />
                            <Style.Triggers>
                                <DataTrigger
                                    Binding="{Binding IsSet}"
                                    Value="True">
                                    <Setter
                                        Property="ContentTemplate"
                                        Value="{StaticResource SetTemplate}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ContentControl.Style>
                </ContentControl>
            </DataTemplate>
        </ResourceDictionary>
    </Window.Resources>

    <!-- FluentWindow убирает системную строку заголовка: без ui:TitleBar окно нечем
         перетащить и нечем закрыть. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar
            Grid.Row="0"
            Title="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}"
            ShowMinimize="True" ShowMaximize="True" ShowClose="True" />

    <Grid
        Grid.Row="1"
        Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel
            Grid.Row="0"
            Margin="0 0 0 10"
            LastChildFill="True">
            <ui:Button
                Margin="0 0 8 0"
                Content="{me:LocalizationSource Common.Load}"
                ToolTip="{me:LocalizationSource SearchSets.LoadTooltip}"
                Command="{Binding LoadCommand}" />
            <ui:Button
                Margin="0 0 8 0"
                Content="{me:LocalizationSource Common.Save}"
                ToolTip="{me:LocalizationSource SearchSets.SaveTooltip}"
                Command="{Binding SaveCommand}" />
            <ui:Button
                Margin="0 0 8 0"
                Content="{me:LocalizationSource Common.SaveAs}"
                ToolTip="{me:LocalizationSource SearchSets.SaveAsTooltip}"
                Command="{Binding SaveAsCommand}" />
            <ui:Button
                Margin="0 0 8 0"
                Content="{me:LocalizationSource SearchSets.AddFilter}"
                Command="{Binding AddFilterCommand}" />
            <ui:Button
                Appearance="Danger"
                Content="{me:LocalizationSource SearchSets.RemoveFilter}"
                ToolTip="{me:LocalizationSource SearchSets.RemoveFilterTooltip}"
                Command="{Binding RemoveFilterCommand}"
                CommandParameter="{Binding SelectedItems, ElementName=FiltersList}" />
            <ui:TextBox
                DockPanel.Dock="Right"
                MinWidth="300"
                MaxWidth="300"
                HorizontalAlignment="Right"
                PlaceholderText="{me:LocalizationSource SearchSets.SearchPlaceholder}"
                Text="{Binding FiltersFilter, UpdateSourceTrigger=PropertyChanged}" />
        </DockPanel>

        <Grid
            Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250" MinWidth="150" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ListBox
                x:Name="FiltersList"
                Grid.Column="0"
                DisplayMemberPath="Name"
                SelectionMode="Extended"
                BorderThickness="1"
                BorderBrush="{ui:ThemeResource ControlElevationBorderBrush}"
                ItemsSource="{Binding Filters.View}"
                SelectedItem="{Binding SelectedFilter}" />

            <GridSplitter
                Grid.Column="1"
                Width="6"
                HorizontalAlignment="Stretch"
                Background="Transparent" />

            <Grid
                Grid.Column="2">
                <Grid.Style>
                    <Style
                        TargetType="Grid">
                        <Style.Triggers>
                            <!-- Пока набор не выбран, правую половину окна редактировать нечем. -->
                            <DataTrigger
                                Binding="{Binding SelectedFilter}"
                                Value="{x:Null}">
                                <Setter
                                    Property="IsEnabled"
                                    Value="False" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <DockPanel
                    Grid.Row="0"
                    Margin="0 0 0 8"
                    LastChildFill="True">
                    <TextBlock
                        VerticalAlignment="Center"
                        Margin="0 0 8 0"
                        Text="{me:LocalizationSource SearchSets.NameLabel}" />
                    <ui:TextBox
                        Text="{Binding SelectedFilter.Name, UpdateSourceTrigger=PropertyChanged}" />
                </DockPanel>

                <DockPanel
                    Grid.Row="1"
                    Margin="0 0 0 8"
                    LastChildFill="True">
                    <TextBlock
                        VerticalAlignment="Center"
                        Margin="0 0 8 0"
                        Text="{me:LocalizationSource SearchSets.CategoriesLabel}" />
                    <ui:Button
                        DockPanel.Dock="Right"
                        Margin="8 0 0 0"
                        Content="{me:LocalizationSource Common.Select}"
                        ToolTip="{me:LocalizationSource SearchSets.SelectCategoriesTooltip}"
                        Command="{Binding SelectedFilter.SelectCategoriesCommand}" />
                    <Border
                        Padding="6 4"
                        BorderThickness="1"
                        CornerRadius="4"
                        Background="Transparent"
                        Cursor="Hand"
                        ToolTip="{me:LocalizationSource SearchSets.SelectCategoriesTooltip}"
                        BorderBrush="{ui:ThemeResource ControlElevationBorderBrush}">
                        <!-- Щелчок по самому полю открывает тот же выбор, что и кнопка: поле похоже
                             на поле ввода, и в него щёлкают, чтобы искать категорию. В окне выбора
                             курсор сразу стоит в поиске. -->
                        <Border.InputBindings>
                            <MouseBinding
                                Gesture="LeftClick"
                                Command="{Binding SelectedFilter.SelectCategoriesCommand}" />
                        </Border.InputBindings>
                        <TextBlock
                            TextWrapping="Wrap"
                            VerticalAlignment="Center"
                            Text="{Binding SelectedFilter.SelectedCategories,
                                Converter={StaticResource CollectionToStringConverter}}" />
                    </Border>
                </DockPanel>

                <TextBlock
                    Grid.Row="2"
                    Margin="0 0 0 8"
                    TextWrapping="Wrap"
                    Foreground="Red"
                    Text="{Binding SelectedFilter.ProvidersErrorText}" />

                <ScrollViewer
                    Grid.Row="3"
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled">
                    <ContentControl
                        Content="{Binding SelectedFilter.Set}"
                        ContentTemplate="{StaticResource SetTemplate}" />
                </ScrollViewer>
            </Grid>
        </Grid>

        <StackPanel
            Grid.Row="2"
            Orientation="Horizontal"
            HorizontalAlignment="Right"
            Margin="0 15 0 0">
            <TextBlock
                Margin="8"
                Foreground="Red"
                VerticalAlignment="Center"
                Text="{Binding ErrorText}" />
            <TextBlock
                Margin="8"
                VerticalAlignment="Center"
                Text="{Binding MessageText}" />
            <!-- Не Appearance="Primary": в WPF-UI 4.3 подпись такой кнопки не видна на её акцентном
                 фоне (кисти для этого вида не резолвятся, текст сливается с фоном) - см. тот же
                 комментарий у SelectableNamesWindow.xaml и MessageWindow.xaml. -->
            <ui:Button
                Width="80"
                Margin="8 0"
                Content="{me:LocalizationSource Common.Ok}"
                IsDefault="True"
                Click="ButtonOk_Click"
                Command="{Binding SaveCommand}" />
            <ui:Button
                Width="80"
                Content="{me:LocalizationSource Common.Close}"
                IsCancel="True"
                Click="ButtonCancel_Click" />
        </StackPanel>
    </Grid>
    </Grid>
</platform:WpfUIPlatformWindow>
