<platform:WpfUIPlatformWindow
    x:Class="Juru.RevitPlugins.ClashNavigator.Views.Filters.SearchSetPreviewWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:platform="clr-namespace:dosymep.WpfUI.Core;assembly=Juru.RevitPlugins.Core"
    xmlns:searchSet="clr-namespace:Juru.RevitPlugins.ClashNavigator.ViewModels.SearchSet"
    xmlns:me="clr-namespace:dosymep.WpfCore.MarkupExtensions;assembly=dosymep.WpfCore"
    xmlns:loc="clr-namespace:Juru.RevitPlugins.ClashNavigator.Views"
    mc:Ignorable="d"
    Title="{Binding Name}"
    Height="500" Width="900" MinHeight="300" MinWidth="600"
    WindowStartupLocation="CenterOwner"
    Background="{ui:ThemeResource ApplicationBackgroundBrush}"
    Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}"
    d:DataContext="{d:DesignInstance searchSet:SearchSetPreviewViewModel, IsDesignTimeCreatable=False}">

    <Window.Resources>
        <!-- Те же стили заголовка колонки, что и в NavigatorWindow.xaml: штатный стиль WPF-UI
             теряет "ручки" изменения ширины колонок. Стили только по ключу - неявный стиль по
             типу в ресурсах окна вместе с элементом WPF-UI в таблице роняет окно при Clear. -->
        <Style x:Key="HeaderGripperStyle" TargetType="Thumb">
            <Setter Property="Width" Value="8" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="SizeWE" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="Transparent" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ResizableColumnHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlElevationBorderBrush}" />
            <Setter Property="BorderThickness" Value="0,0,1,1" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridColumnHeader">
                        <Grid>
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                            </Border>
                            <Thumb x:Name="PART_LeftHeaderGripper" HorizontalAlignment="Left"
                                   Style="{StaticResource HeaderGripperStyle}" />
                            <Thumb x:Name="PART_RightHeaderGripper" HorizontalAlignment="Right"
                                   Style="{StaticResource HeaderGripperStyle}" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- FluentWindow убирает системную строку заголовка: без ui:TitleBar окно нечем
         перетащить и нечем закрыть. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar
            Grid.Row="0"
            Title="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}"
            ShowMinimize="True" ShowMaximize="True" ShowClose="True" />

        <Grid
            Grid.Row="1"
            Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel
                Grid.Row="0"
                Margin="0 0 0 10"
                Orientation="Horizontal">
                <ui:Button
                    Margin="0 0 8 0"
                    Content="{me:LocalizationSource SearchSet.ShowSet}"
                    ToolTip="{me:LocalizationSource SearchSet.ShowSetTooltip}"
                    Command="{Binding ShowSetCommand}" />
                <ui:Button
                    Margin="0 0 8 0"
                    Content="{me:LocalizationSource SearchSet.Previous}"
                    ToolTip="{me:LocalizationSource SearchSet.StepTooltip}"
                    Command="{Binding PreviousCommand}" />
                <ui:Button
                    Margin="0 0 8 0"
                    Content="{me:LocalizationSource SearchSet.Next}"
                    ToolTip="{me:LocalizationSource SearchSet.StepTooltip}"
                    Command="{Binding NextCommand}" />
                <ui:Button
                    Margin="0 0 16 0"
                    Content="{me:LocalizationSource SearchSet.ShowElement}"
                    ToolTip="{me:LocalizationSource SearchSet.ShowElementTooltip}"
                    Command="{Binding ShowElementCommand}" />
                <!-- Обычный CheckBox без неявного стиля - см. комментарий у ресурсов окна. -->
                <CheckBox
                    VerticalAlignment="Center"
                    Content="{me:LocalizationSource SearchSet.Invert}"
                    ToolTip="{me:LocalizationSource SearchSet.InvertTooltip}"
                    IsChecked="{Binding Inverted}" />
            </StackPanel>

            <!-- Колонки параметров правил добавляются кодом (см. SearchSetPreviewWindow.xaml.cs):
                 их число и имена зависят от набора. VirtualizationMode=Standard - по той же
                 причине, что и в NavigatorWindow.xaml. -->
            <DataGrid
                x:Name="ElementsGrid"
                Grid.Row="1"
                ItemsSource="{Binding Elements}"
                SelectedItem="{Binding SelectedElement}"
                AutoGenerateColumns="False"
                CanUserAddRows="False"
                IsReadOnly="True"
                SelectionMode="Single"
                HeadersVisibility="Column"
                CanUserResizeColumns="True"
                MinColumnWidth="40"
                VirtualizingPanel.VirtualizationMode="Standard"
                ColumnHeaderStyle="{StaticResource ResizableColumnHeaderStyle}"
                GridLinesVisibility="Horizontal"
                BorderThickness="1"
                BorderBrush="{ui:ThemeResource ControlElevationBorderBrush}"
                MouseDoubleClick="ElementsGrid_MouseDoubleClick">
                <DataGrid.Columns>
                    <DataGridTextColumn loc:ColumnLocalization.Key="SearchSet.Column.File" Binding="{Binding File}" Width="2*" />
                    <DataGridTextColumn loc:ColumnLocalization.Key="SearchSet.Column.Id" Binding="{Binding Id}" Width="90" />
                    <DataGridTextColumn loc:ColumnLocalization.Key="SearchSet.Column.Category" Binding="{Binding Category}" Width="*" />
                    <DataGridTextColumn loc:ColumnLocalization.Key="SearchSet.Column.Family" Binding="{Binding FamilyName}" Width="2*" />
                    <DataGridTextColumn loc:ColumnLocalization.Key="SearchSet.Column.Type" Binding="{Binding Name}" Width="2*" />
                </DataGrid.Columns>
            </DataGrid>

            <DockPanel
                Grid.Row="2"
                Margin="0 10 0 0"
                LastChildFill="True">
                <TextBlock
                    DockPanel.Dock="Left"
                    VerticalAlignment="Center"
                    Text="{Binding StatusText}" />
                <ui:Button
                    DockPanel.Dock="Right"
                    Width="80"
                    Content="{me:LocalizationSource Common.Close}"
                    IsCancel="True"
                    Click="ButtonClose_Click" />
                <TextBlock
                    Margin="16 0"
                    VerticalAlignment="Center"
                    TextWrapping="Wrap"
                    Foreground="Red"
                    Text="{Binding ErrorText}" />
            </DockPanel>
        </Grid>
    </Grid>
</platform:WpfUIPlatformWindow>
