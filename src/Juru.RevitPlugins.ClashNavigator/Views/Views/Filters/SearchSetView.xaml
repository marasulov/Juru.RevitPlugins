<Window
    x:Class="Juru.RevitPlugins.ClashNavigator.Views.Filters.SearchSetView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:Juru.RevitPlugins.ClashNavigator.ViewModels.SearchSet"
    xmlns:m="clr-namespace:Juru.RevitPlugins.ClashNavigator.Models.Value"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    mc:Ignorable="d"
    Title="{Binding Name}"
    Height="450"
    Width="800"
    WindowStartupLocation="CenterScreen"
    d:DataContext="{d:DesignInstance vm:SearchSetsViewModel, IsDesignTimeCreatable=False}">

    <!-- Стандартные триггеры для загрузки и закрытия окна -->
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding ShowSetCommand}" />
        </i:EventTrigger>
        <i:EventTrigger EventName="Closing">
            <i:InvokeCommandAction Command="{Binding CloseCommand}" />
        </i:EventTrigger>
    </i:Interaction.Triggers>

    <Window.Resources>
        <!-- Оставляем шаблон данных, но на стандартном TextBox -->
        <DataTemplate DataType="{x:Type m:ParamValue}">
            <TextBox IsReadOnly="True" Text="{Binding DisplayValue}" BorderThickness="0" Background="Transparent"/>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel HorizontalAlignment="Left" Margin="0,0,0,10">
            <!-- Стандартная кнопка -->
            <Button
                DockPanel.Dock="Left"
                ToolTip="Показать весь набор элементов на виде целиком"
                Command="{Binding ShowSetCommand}"
                Content="Показать весь набор"
                Padding="10,5" />
        </DockPanel>

        <!-- Стандартная таблица WPF вместо платного GridControl -->
        <DataGrid
            Grid.Row="1"
            x:Name="_gridControl"
            ItemsSource="{Binding SearchSet.Grid.Rows, UpdateSourceTrigger=PropertyChanged}"
            AutoGenerateColumns="False"
            CanUserAddRows="False"
            SelectionMode="Single"
            HeadersVisibility="Column"
            GridLinesVisibility="Horizontal"
            BorderThickness="1">

            <DataGrid.Columns>
                <!-- Колонка с кнопкой поиска -->
                <DataGridTemplateColumn Width="80">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button 
                                Command="{Binding RelativeSource={RelativeSource AncestorType={x:Type Window}, Mode=FindAncestor},Path=DataContext.SearchSet.Grid.SelectCommand}"
                                CommandParameter="{Binding Row}"
                                Content="Поиск"
                                Margin="2"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- Текстовые колонки -->
                <DataGridTextColumn Width="2*" Header="Файл" Binding="{Binding File}" />
                <DataGridTextColumn Width="1*" Header="Категория" Binding="{Binding Category}" />
                <DataGridTextColumn Width="1*" Header="Id" Binding="{Binding Id}" />
                <DataGridTextColumn Width="3*" Header="Имя семейства" Binding="{Binding FamilyName}" />
                <DataGridTextColumn Width="3*" Header="Имя типоразмера" Binding="{Binding Name}" />
            </DataGrid.Columns>
        </DataGrid>

        <DockPanel Grid.Row="2" Margin="0,10,0,0">
            <!-- Стандартный CheckBox вместо платного CheckEdit. 
                 Команду можно привязать напрямую без сложных триггеров -->
            <CheckBox
                IsChecked="{Binding Inverted}"
                Content="Инвертировать"
                DockPanel.Dock="Left"
                HorizontalAlignment="Left"
                Command="{Binding InversionChangedCommand}" />
        </DockPanel>
    </Grid>
</Window>