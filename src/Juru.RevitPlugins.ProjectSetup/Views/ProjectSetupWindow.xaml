<Window x:Class="Juru.RevitPlugins.ProjectSetup.Views.ProjectSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Подготовка проекта"
        Width="1180" Height="820" MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterOwner"
        FontSize="13">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,4" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
        <Style x:Key="Caption" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,14,0,6" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#6B7280" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </Window.Resources>

    <DockPanel Margin="12">

        <!-- Сервер и пароль: без пароля страницы настроек ClashTracker проекты не видны -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Сервер:" VerticalAlignment="Center" />
            <TextBlock x:Name="ServerText" Margin="6,0,20,0" VerticalAlignment="Center" FontWeight="SemiBold" />
            <TextBlock Text="Пароль:" VerticalAlignment="Center" />
            <PasswordBox x:Name="PasswordBox" Width="180" Margin="6,0,8,0" VerticalContentAlignment="Center" />
            <Button x:Name="ConnectButton" Content="Подключиться" Click="OnConnect" />
        </StackPanel>

        <!-- Состояние и журнал -->
        <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <TextBlock x:Name="StatusText" DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,6" FontWeight="SemiBold" />
            <TextBox x:Name="LogBox" Height="150" IsReadOnly="True" FontFamily="Consolas" FontSize="12"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap" />
        </DockPanel>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Column="0">
                <Button DockPanel.Dock="Top" x:Name="NewProjectButton" Content="+ Новый проект" Margin="0,0,0,8"
                        Click="OnNewProject" IsEnabled="False" />
                <ListBox x:Name="ProjectList" SelectionChanged="OnProjectSelected" />
            </DockPanel>

            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="Editor" IsEnabled="False">

                    <TextBlock Text="Проект" Style="{StaticResource Caption}" Margin="0,0,0,6" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Папка проекта" VerticalAlignment="Center" />
                        <TextBox Grid.Row="0" Grid.Column="1" x:Name="FolderBox" Margin="0,2" />
                        <TextBlock Grid.Row="1" Text="Шифр" VerticalAlignment="Center" />
                        <TextBox Grid.Row="1" Grid.Column="1" x:Name="CodeBox" Margin="0,2" />
                        <CheckBox Grid.Row="2" Grid.Column="1" x:Name="CentralBox" Margin="0,6,0,0"
                                  Content="Файлы дисциплин — файлы-хранилища (центральные модели)" />
                    </Grid>

                    <TextBlock Text="Объекты" Style="{StaticResource Caption}" />
                    <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,6"
                               Text="Код объекта — блок имени файла и имя площадки при Publish из генплана. По умолчанию — имя папки без пробелов." />
                    <DataGrid x:Name="ObjectsGrid" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                              HeadersVisibility="Column" MinHeight="120" MaxHeight="280"
                              BeginningEdit="OnObjectBeginningEdit" />
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <Button Content="+ Объект" Click="OnAddObject" />
                        <Button Content="Удалить объект" Click="OnRemoveObject" />
                    </StackPanel>

                    <TextBlock Text="Шаблоны" Style="{StaticResource Caption}" />
                    <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,6"
                               Text="Файл подбирается в папке по умолчанию по версии Revit. Если подходящих несколько или путь устарел — выберите файл кнопкой «…»." />
                    <ItemsControl x:Name="TemplatesList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                                    <TextBox Grid.Column="1" Text="{Binding Path, UpdateSourceTrigger=PropertyChanged}" />
                                    <Button Grid.Column="2" Content="…" Margin="6,0,0,0" Padding="10,0" Tag="{Binding}" Click="OnBrowseTemplate" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Note}" Foreground="{Binding NoteBrush}"
                                               FontSize="11" TextWrapping="Wrap" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <WrapPanel Margin="0,16,0,4">
                        <Button x:Name="SaveButton" Content="Сохранить" Click="OnSave" />
                        <Button x:Name="StageAButton" Content="Этап А: папки, генплан, базовые файлы" Click="OnStageA" />
                        <Button x:Name="StageBButton" Content="Этап Б: файлы дисциплин" Click="OnStageB" />
                        <Button x:Name="QueueButton" Content="Выполнить задания из очереди" Click="OnRunQueue" />
                    </WrapPanel>
                    <TextBlock Style="{StaticResource Hint}"
                               Text="Этап Б — после того, как базовые файлы расставлены в генплане и координаты опубликованы (Publish) с площадкой, названной кодом объекта." />
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</Window>
