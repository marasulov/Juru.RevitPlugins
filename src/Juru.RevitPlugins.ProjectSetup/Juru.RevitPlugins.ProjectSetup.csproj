<Project Sdk="Nice3point.Revit.Sdk/6.2.2">

    <!--
        Подготовка проекта в СОД: исполнитель Revit-заданий из очереди ClashTracker
        (ClashTracker/docs/ProjectSetup.md). Создаёт генплан, базовые файлы и файлы дисциплин
        из шаблонов. Кнопки на ленте нет: команду запускает BIM-менеджер через Add-in Manager.
    -->
    <PropertyGroup>
        <!-- Перегрузки RevitContext.BeginDialogSuppressionScope ссылаются на WPF MessageBoxResult. -->
        <UseWPF>true</UseWPF>
        <Configurations>Debug.R23;Debug.R24;Debug.R25;Debug.R26;Debug.R27</Configurations>
        <Configurations>$(Configurations);Release.R23;Release.R24;Release.R25;Release.R26;Release.R27</Configurations>
    </PropertyGroup>

    <ItemGroup>
        <!-- Revit Dependencies -->
        <PackageReference Include="Nice3point.Revit.Toolkit" Version="$(RevitVersion).*" />
        <PackageReference Include="Nice3point.Revit.Extensions" Version="$(RevitVersion).*" />
        <PackageReference Include="Nice3point.Revit.Api.RevitAPI" Version="$(RevitVersion).*" />
        <PackageReference Include="Nice3point.Revit.Api.RevitAPIUI" Version="$(RevitVersion).*" />

        <!-- Serialization: входит в состав net8.0 и новее, нужен только для net48 -->
        <PackageReference Include="System.Text.Json" Version="8.0.5" Condition="'$(RevitVersion)' &lt; '2025'" />

        <!-- Development Dependencies -->
        <PackageReference Include="JetBrains.Annotations" Version="2025.2.4" PrivateAssets="all" />
        <PackageReference Include="Polyfill" Version="10.5.1" PrivateAssets="all" />
    </ItemGroup>

    <ItemGroup Condition="'$(RevitVersion)' &lt; '2025'">
        <!-- На net48 HttpClient живёт в отдельной сборке платформы. -->
        <Reference Include="System.Net.Http" />
        <!-- DPAPI (ProtectedData) для пароля сервера -->
        <Reference Include="System.Security" />
    </ItemGroup>

    <ItemGroup Condition="'$(RevitVersion)' &gt;= '2025'">
        <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
    </ItemGroup>

    <ItemGroup>
        <!-- Адрес ClashTracker правится рядом с установленным плагином, без пересборки. -->
        <None Include="ProjectSetup.json" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

</Project>
