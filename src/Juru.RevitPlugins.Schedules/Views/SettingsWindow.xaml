<Window x:Class="Juru.RevitPlugins.Schedules.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:viewModels="clr-namespace:Juru.RevitPlugins.Schedules.ViewModels"
        xmlns:loc="clr-namespace:Juru.RevitPlugins.Schedules.Localization"
        mc:Ignorable="d"
        Title="{x:Static loc:Text.SettingsTitle}"
        Width="620"
        SizeToContent="Height"
        MinHeight="480"
        ResizeMode="NoResize"
        FontSize="12"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        d:DataContext="{d:DesignInstance viewModels:SettingsViewModel, IsDesignTimeCreatable=False}">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Juru.RevitPlugins.Schedules;component/Resources/CustomStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style TargetType="CheckBox" BasedOn="{StaticResource DefaultCheckBoxStyle}" />

            <Style x:Key="Caption" TargetType="TextBlock">
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Margin" Value="0,0,8,0" />
            </Style>

            <Style x:Key="Hint" TargetType="TextBlock">
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="Margin" Value="0,4,0,0" />
                <Setter Property="Foreground" Value="{ui:ThemeResource TextFillColorSecondaryBrush}" />
            </Style>

            <Style x:Key="Section" TargetType="TextBlock">
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Margin" Value="0,16,0,6" />
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="{x:Static loc:Text.TranslationService}" Style="{StaticResource Section}" Margin="0,0,0,6" />

            <!-- Служба перевода и языки выбираются в самом окне спецификаций, рядом с кнопкой
                 «Создать»: выбор нужен часто, а заходить сюда ради него было лишним кликом. -->
            <DockPanel Margin="0,8,0,0">
                <TextBlock DockPanel.Dock="Left" Text="{x:Static loc:Text.SettingsBatchSize}" Style="{StaticResource Caption}" />
                <ui:TextBox Width="60" HorizontalAlignment="Left" Text="{Binding BatchSize}" />
            </DockPanel>

            <!-- Двуязычное значение вида «Кабинет / Office»: один и тот же параметр читается и
                 в русском комплекте, и в английском. -->
            <DockPanel Margin="0,8,0,0">
                <CheckBox DockPanel.Dock="Left" Content="{x:Static loc:Text.SettingsKeepSource}"
                          ToolTip="{x:Static loc:Text.SettingsKeepSourceHint}"
                          IsChecked="{Binding KeepSourceText}" />
                <TextBlock DockPanel.Dock="Left" Text="{x:Static loc:Text.SettingsSeparator}"
                           Style="{StaticResource Caption}" Margin="16,0,8,0"
                           IsEnabled="{Binding KeepSourceText}" />
                <ComboBox DockPanel.Dock="Left" Width="120"
                          IsEnabled="{Binding KeepSourceText}"
                          ItemsSource="{Binding Separators}"
                          DisplayMemberPath="Label" SelectedValuePath="Value"
                          SelectedValue="{Binding Separator}" />
            </DockPanel>

            <!-- Ключи в файл настроек не пишутся: файл лежит рядом с плагином и попадает
                 в репозиторий. Они сохраняются в переменные окружения пользователя. -->
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" Text="DeepL" Style="{StaticResource Section}" />
                <ui:Button DockPanel.Dock="Left" Content="{x:Static loc:Text.SettingsHelp}"
                           Margin="12,10,0,0" Padding="8,2"
                           Click="ButtonDeepLHelp_Click" />
            </DockPanel>

            <DockPanel>
                <TextBlock DockPanel.Dock="Left" Text="{x:Static loc:Text.SettingsVariable}" Style="{StaticResource Caption}" />
                <ui:TextBox DockPanel.Dock="Left" Width="180" Text="{Binding DeepLKeyVariable}" />
                <TextBlock Text="{Binding DeepLKeyState}" Style="{StaticResource Caption}" Margin="12,0,0,0"
                           Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}" />
            </DockPanel>

            <DockPanel Margin="0,8,0,0">
                <TextBlock DockPanel.Dock="Left" Text="{x:Static loc:Text.SettingsNewKey}" Style="{StaticResource Caption}" />
                <PasswordBox x:Name="DeepLKeyBox" PasswordChanged="DeepLKeyBox_PasswordChanged" />
            </DockPanel>

            <TextBlock Style="{StaticResource Hint}"
                       Text="{x:Static loc:Text.SettingsDeepLHint}" />

            <DockPanel>
                <TextBlock DockPanel.Dock="Left" Text="Google" Style="{StaticResource Section}" />
                <ui:Button DockPanel.Dock="Left" Content="{x:Static loc:Text.SettingsHelp}"
                           Margin="12,10,0,0" Padding="8,2"
                           Click="ButtonGoogleHelp_Click" />
            </DockPanel>

            <DockPanel>
                <TextBlock DockPanel.Dock="Left" Text="{x:Static loc:Text.SettingsVariable}" Style="{StaticResource Caption}" />
                <ui:TextBox DockPanel.Dock="Left" Width="180" Text="{Binding GoogleKeyVariable}" />
                <TextBlock Text="{Binding GoogleKeyState}" Style="{StaticResource Caption}" Margin="12,0,0,0"
                           Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}" />
            </DockPanel>

            <DockPanel Margin="0,8,0,0">
                <TextBlock DockPanel.Dock="Left" Text="{x:Static loc:Text.SettingsNewKey}" Style="{StaticResource Caption}" />
                <PasswordBox x:Name="GoogleKeyBox" PasswordChanged="GoogleKeyBox_PasswordChanged" />
            </DockPanel>

        </StackPanel>

        <TextBlock Grid.Row="1" Style="{StaticResource Hint}" Margin="0,16,0,0"
                   Text="{Binding Note}" />

        <DockPanel Grid.Row="2" Margin="0,16,0,0">
            <!-- Кнопки объявлены раньше пути: DockPanel раздаёт ширину в порядке объявления, и
                 путь, объявленный первым, забирал её себе целиком - «Проверить» выдавливалась за
                 край окна. Путь идёт последним и занимает остаток, обрезаясь многоточием. -->
            <ui:Button DockPanel.Dock="Right" Content="{x:Static loc:Text.Cancel}" Width="100" Margin="8,0,0,0"
                       Click="ButtonCancel_Click" />
            <ui:Button DockPanel.Dock="Right" Content="{x:Static loc:Text.Save}" Width="110" Appearance="Primary"
                       Click="ButtonSave_Click" />
            <ui:Button DockPanel.Dock="Right" Content="{x:Static loc:Text.Check}" Width="110" Margin="8,0,8,0"
                       Command="{Binding CheckCommand}" />

            <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                       Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                       ToolTip="{Binding ConfigPath}"
                       Text="{Binding ConfigPath}" />
        </DockPanel>
    </Grid>
</Window>
