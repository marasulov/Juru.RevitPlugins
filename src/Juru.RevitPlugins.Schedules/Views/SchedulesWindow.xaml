<Window
    x:Class="Juru.RevitPlugins.Schedules.Views.SchedulesWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:viewModels="clr-namespace:Juru.RevitPlugins.Schedules.ViewModels"
    mc:Ignorable="d"
    Title="Английские спецификации"
    Height="600" Width="1000" MinHeight="400" MinWidth="800"
    WindowStartupLocation="CenterScreen"
    Background="{ui:ThemeResource ApplicationBackgroundBrush}"
    Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}"
    d:DataContext="{d:DesignInstance viewModels:SchedulesWindowViewModel, IsDesignTimeCreatable=False}">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Dark" />
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>

            <!-- Категории, до которых дело не дошло. Вкладка открывается и объясняет, почему пусто,
                 вместо пустой таблицы, выглядящей поломанной. -->
            <DataTemplate x:Key="UnsupportedCategory">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="520">
                    <TextBlock Text="{Binding}" FontSize="16" FontWeight="SemiBold"
                               HorizontalAlignment="Center" Margin="0,0,0,8" />
                    <TextBlock TextWrapping="Wrap" TextAlignment="Center"
                               Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                               Text="Пока не поддерживается. Перевод этой категории пишется в параметры элементов модели, а не рисуется заново, поэтому требует отката, отметки исходного текста и проверок совместной работы." />
                </StackPanel>
            </DataTemplate>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Спецификации на листах" FontSize="20" FontWeight="SemiBold" />
            <TextBlock Text="Отметьте те, для которых нужен английский комплект"
                       Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <DockPanel Grid.Row="1" Margin="0,0,0,8">
            <Button DockPanel.Dock="Left" Content="Выбрать все" Margin="0,0,8,0"
                    Command="{Binding SelectAllCommand}" />
            <Button DockPanel.Dock="Left" Content="Снять все" Margin="0,0,16,0"
                    Command="{Binding SelectNoneCommand}" />

            <ui:TextBox PlaceholderText="Поиск по имени или листу"
                        Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
        </DockPanel>

        <TabControl Grid.Row="2" Padding="0" BorderThickness="1"
                    BorderBrush="{ui:ThemeResource ControlElevationBorderBrush}">

            <TabItem Header="Спецификации">
            <DataGrid
                x:Name="SchedulesGrid"
                AutoGenerateColumns="False"
                CanUserAddRows="False"
                CanUserDeleteRows="False"
                CanUserReorderColumns="False"
                GridLinesVisibility="Horizontal"
                HeadersVisibility="Column"
                IsReadOnly="True"
                SelectionMode="Extended"
                SelectionUnit="FullRow"
                BorderThickness="1"
                BorderBrush="{ui:ThemeResource ControlElevationBorderBrush}"
                ItemsSource="{Binding View}">

                <!-- Галочка и выделение строки - одно и то же: отметить диапазон стрелками или
                     протаскиванием мыши и есть основной способ выбора. -->
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                    </Style>
                </DataGrid.RowStyle>

                <DataGrid.Columns>
                    <DataGridTemplateColumn Width="Auto" CanUserResize="False" CanUserSort="False">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <!-- Focusable=False: иначе первый щелчок уходит на фокус ячейки,
                                     а не на переключение галочки. -->
                                <CheckBox
                                    Margin="6,0"
                                    Focusable="False"
                                    IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    Click="CheckBox_Click" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="Спецификация" Width="*"
                                        Binding="{Binding ScheduleName}" SortMemberPath="ScheduleName" />
                    <DataGridTextColumn Header="Листы" Width="90"
                                        Binding="{Binding Sheets}" SortMemberPath="Sheets" />
                    <DataGridTextColumn Header="Колонок" Width="70"
                                        Binding="{Binding ColumnCount}" SortMemberPath="ColumnCount" />
                    <DataGridTextColumn Header="Строк" Width="70"
                                        Binding="{Binding RowCount}" SortMemberPath="RowCount" />
                    <DataGridTextColumn Header="Строк на перевод" Width="120"
                                        Binding="{Binding TranslatableCount}" SortMemberPath="TranslatableCount" />
                    <DataGridTextColumn Header="Без перевода" Width="110"
                                        Binding="{Binding UntranslatedCount}" SortMemberPath="UntranslatedCount" />
                    <DataGridTextColumn Header="Состояние" Width="160"
                                        Binding="{Binding Status}" SortMemberPath="Status" />
                </DataGrid.Columns>
            </DataGrid>
            </TabItem>

            <!-- Строка здесь - отдельный переводимый текст, а не спецификация: это поверхность вычитки
                 перевода, та же, что сейчас правится в CSV. -->
            <TabItem Header="Строки на перевод">
            <DataGrid
                x:Name="TranslationsGrid"
                AutoGenerateColumns="False"
                CanUserAddRows="False"
                CanUserDeleteRows="False"
                CanUserReorderColumns="False"
                GridLinesVisibility="Horizontal"
                HeadersVisibility="Column"
                SelectionMode="Extended"
                SelectionUnit="FullRow"
                BorderThickness="0"
                ItemsSource="{Binding TranslationsView}">

                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                    </Style>
                </DataGrid.RowStyle>

                <DataGrid.Columns>
                    <DataGridTemplateColumn Width="Auto" CanUserResize="False" CanUserSort="False" IsReadOnly="True">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox
                                    Margin="6,0"
                                    Focusable="False"
                                    IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    Click="TranslationCheckBox_Click" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="Что это" Width="130" IsReadOnly="True"
                                        Binding="{Binding Kind}" SortMemberPath="Kind" />
                    <DataGridTextColumn Header="Исходный текст" Width="*" IsReadOnly="True"
                                        Binding="{Binding Readable}" SortMemberPath="Readable" />
                    <DataGridTextColumn Header="Перевод" Width="*"
                                        Binding="{Binding Translation, UpdateSourceTrigger=PropertyChanged}"
                                        SortMemberPath="Translation" />
                    <DataGridTextColumn Header="Спецификации" Width="200" IsReadOnly="True"
                                        Binding="{Binding Schedules}" SortMemberPath="Schedules" />
                </DataGrid.Columns>
            </DataGrid>
            </TabItem>
            <TabItem Header="Помещения">
                <ContentControl Content="Помещения" ContentTemplate="{StaticResource UnsupportedCategory}" />
            </TabItem>
            <TabItem Header="Зоны">
                <ContentControl Content="Зоны" ContentTemplate="{StaticResource UnsupportedCategory}" />
            </TabItem>
            <TabItem Header="Листы">
                <ContentControl Content="Листы" ContentTemplate="{StaticResource UnsupportedCategory}" />
            </TabItem>
            <TabItem Header="Виды">
                <ContentControl Content="Виды" ContentTemplate="{StaticResource UnsupportedCategory}" />
            </TabItem>
            <TabItem Header="Текстовые примечания">
                <ContentControl Content="Текстовые примечания" ContentTemplate="{StaticResource UnsupportedCategory}" />
            </TabItem>
            <TabItem Header="Ключевые примечания">
                <ContentControl Content="Ключевые примечания" ContentTemplate="{StaticResource UnsupportedCategory}" />
            </TabItem>
            <TabItem Header="Семейства">
                <ContentControl Content="Семейства" ContentTemplate="{StaticResource UnsupportedCategory}" />
            </TabItem>
            <TabItem Header="Уровни">
                <ContentControl Content="Уровни" ContentTemplate="{StaticResource UnsupportedCategory}" />
            </TabItem>
            <TabItem Header="Материалы">
                <ContentControl Content="Материалы" ContentTemplate="{StaticResource UnsupportedCategory}" />
            </TabItem>
            <TabItem Header="Ревизии">
                <ContentControl Content="Ревизии" ContentTemplate="{StaticResource UnsupportedCategory}" />
            </TabItem>
            <TabItem Header="Размеры">
                <ContentControl Content="Размеры" ContentTemplate="{StaticResource UnsupportedCategory}" />
            </TabItem>
            <TabItem Header="Параметры">
                <ContentControl Content="Параметры" ContentTemplate="{StaticResource UnsupportedCategory}" />
            </TabItem>
        </TabControl>

        <DockPanel Grid.Row="3" Margin="0,12,0,0">
            <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center"
                       Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                       Text="{Binding Summary}" />
            <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" Margin="16,0,0,0"
                       Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                       Text="{Binding TranslationsSummary}" />

            <Button DockPanel.Dock="Right" Content="Отмена" Width="100" Margin="8,0,0,0"
                    Click="ButtonCancel_Click" />
            <ui:Button DockPanel.Dock="Right" Content="Построить" Width="120"
                       Appearance="Primary"
                       Click="ButtonBuild_Click" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="16,0">
                <TextBlock Text="Служба перевода" VerticalAlignment="Center" Margin="0,0,8,0" />
                <ComboBox Width="120" VerticalAlignment="Center"
                          ItemsSource="{Binding Providers}"
                          SelectedItem="{Binding Provider}" />
                <CheckBox Content="Перерисовать в линии" Margin="16,0,0,0" VerticalAlignment="Center"
                          IsChecked="{Binding RedrawAsLines}" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
