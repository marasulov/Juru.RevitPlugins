<UserControl
    x:Class="Juru.RevitPlugins.Openings.Views.Navigator.IncomingOpeningsPaneView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vms="clr-namespace:Juru.RevitPlugins.Openings.ViewModels.Navigator"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance vms:IncomingOpeningsPaneViewModel, IsDesignTimeCreatable=False}">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary />
                <ui:ControlsDictionary />
                <ResourceDictionary
                    Source="pack://application:,,,/Juru.RevitPlugins.Core;component/Resources/CustomStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>


            <Style
                x:Key="Hint"
                TargetType="TextBlock">
                <Setter
                    Property="Opacity"
                    Value="0.6" />
                <Setter
                    Property="TextWrapping"
                    Value="Wrap" />
            </Style>

            <BooleanToVisibilityConverter
                x:Key="BoolToVisibility" />
        </ResourceDictionary>
    </UserControl.Resources>

    <!-- Закреплённая панель Revit не подкладывает под содержимое фона: без своего Background WPF
         оставляет его прозрачным, и панель выглядит чёрной. Кисть берём из той же темы, что красит
         текст и кнопки, - иначе светлый текст лёг бы на светлый фон. -->
    <Grid
        Background="{DynamicResource ApplicationBackgroundBrush}"
        Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition
                Height="Auto" />
            <RowDefinition
                Height="*" />
            <RowDefinition
                Height="Auto" />
            <RowDefinition
                Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel
            Grid.Row="0"
            Margin="0 0 0 8">
            <TextBlock
                FontWeight="SemiBold"
                TextWrapping="Wrap"
                Text="{Binding Summary}" />
            <TextBlock
                Foreground="OrangeRed"
                TextWrapping="Wrap"
                Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}"
                Text="{Binding ErrorText}" />
            <TextBlock
                FontWeight="SemiBold"
                Foreground="OrangeRed"
                TextWrapping="Wrap"
                Visibility="{Binding HasCoordinateWarning, Converter={StaticResource BoolToVisibility}}"
                Text="{Binding CoordinateWarning}" />
            <ui:TextBox
                x:Name="SearchBox"
                Margin="0 6 0 0"
                PlaceholderText="Поиск"
                TextChanged="SearchBox_TextChanged" />
        </StackPanel>

        <Border
            Grid.Row="1"
            Style="{StaticResource CustomBorder}">
            <DataGrid
                x:Name="TasksGrid"
                Margin="1"
                AutoGenerateColumns="False"
                CanUserAddRows="False"
                CanUserDeleteRows="False"
                CanUserResizeColumns="True"
                ColumnHeaderStyle="{StaticResource CustomResizableColumnHeaderStyle}"
                GridLinesVisibility="Horizontal"
                HeadersVisibility="Column"
                IsReadOnly="True"
                SelectedItem="{Binding SelectedTask}"
                SelectionChanged="TasksGrid_SelectionChanged"
                SelectionMode="Single"
                SelectionUnit="FullRow">
                <DataGrid.Columns>
                    <DataGridTextColumn
                        Width="120"
                        Binding="{Binding HostName}"
                        Header="Основа" />
                    <DataGridTextColumn
                        Width="70"
                        Binding="{Binding LevelName}"
                        Header="Уровень" />
                    <DataGridTextColumn
                        Width="90"
                        Binding="{Binding MepSystem}"
                        Header="Система" />
                    <DataGridTextColumn
                        Width="105"
                        Binding="{Binding SentByDisplayName}"
                        Header="Кто выдал" />
                    <DataGridTextColumn
                        Width="105"
                        Binding="{Binding OtherDisciplineText}"
                        Header="Другая дисциплина" />
                    <!-- Пересчитано локально по конструкциям этого файла плюс "объединённое"
                         с ВИС-стороны. Не решение согласующего. -->
                    <DataGridTextColumn
                        Width="110"
                        Binding="{Binding TechnicalStatusText}"
                        Header="Конструкция">
                        <DataGridTextColumn.ElementStyle>
                            <Style
                                TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger
                                        Binding="{Binding TechnicalStatusNeedsAttention}"
                                        Value="True">
                                        <Setter
                                            Property="Foreground"
                                            Value="OrangeRed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <!-- Решение только показано: принимают его кнопками панели ниже, по выделенной
                         строке. Звёздочка - решение изменено, но ещё не отправлено. -->
                    <DataGridTemplateColumn
                        Width="120"
                        Header="Моё решение">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel
                                    Orientation="Horizontal">
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontWeight="SemiBold"
                                        Text="{Binding OwnStatusText}">
                                        <TextBlock.Style>
                                            <Style
                                                TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger
                                                        Binding="{Binding IsApproved}"
                                                        Value="True">
                                                        <Setter
                                                            Property="Foreground"
                                                            Value="Green" />
                                                    </DataTrigger>
                                                    <DataTrigger
                                                        Binding="{Binding IsRejected}"
                                                        Value="True">
                                                        <Setter
                                                            Property="Foreground"
                                                            Value="Red" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock
                                        Margin="4 0 0 0"
                                        VerticalAlignment="Center"
                                        Foreground="OrangeRed"
                                        Text="*"
                                        Visibility="{Binding IsDirty, Converter={StaticResource BoolToVisibility}}" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn
                        Width="150"
                        Binding="{Binding Comment}"
                        Header="Причина отклонения" />
                    <DataGridTextColumn
                        Width="*"
                        Binding="{Binding Description}"
                        Header="Описание" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Панель решения. Сверху вниз: переход между заданиями, решение по текущему, причина
             отклонения. Целиком по IsEnabled не выключается - выключенный контейнер не пропускает
             клики и к кнопкам внутри; доступность решают сами кнопки. -->
        <Border
            Grid.Row="2"
            Margin="0 10 0 0"
            Style="{StaticResource CustomBorder}">
            <StackPanel
                Margin="10">
                <TextBlock
                    FontWeight="SemiBold"
                    TextWrapping="Wrap"
                    Text="{Binding SelectedTaskTitle}" />

                <StackPanel
                    Margin="0 8 0 0"
                    Orientation="Horizontal">
                    <ui:Button
                        Width="110"
                        Content="◀ Назад"
                        ToolTip="Предыдущее задание в списке - с показом в модели"
                        Click="PreviousButton_Click" />
                    <ui:Button
                        Width="110"
                        Margin="8 0 0 0"
                        Content="Вперёд ▶"
                        ToolTip="Следующее задание в списке - с показом в модели"
                        Click="NextButton_Click" />
                    <TextBlock
                        Margin="12 0 0 0"
                        VerticalAlignment="Center"
                        Style="{StaticResource Hint}"
                        Text="{Binding PositionText}" />
                </StackPanel>

                <StackPanel
                    Margin="0 8 0 0"
                    Orientation="Horizontal">
                    <ui:Button
                        Width="140"
                        Appearance="Success"
                        Content="Согласовать"
                        IsEnabled="{Binding CanApproveSelected}"
                        Click="ApproveButton_Click" />
                    <ui:Button
                        Width="140"
                        Margin="8 0 0 0"
                        Appearance="Danger"
                        Content="Отклонить"
                        IsEnabled="{Binding CanRejectSelected}"
                        Click="RejectButton_Click" />
                </StackPanel>

                <TextBlock
                    Margin="0 6 0 0"
                    Style="{StaticResource Hint}"
                    Text="{Binding DecisionHint}" />

                <ui:TextBox
                    x:Name="CommentBox"
                    Margin="0 8 0 0"
                    AcceptsReturn="False"
                    PlaceholderText="Причина отклонения - обязательна"
                    IsEnabled="{Binding CanEditComment}"
                    KeyDown="CommentBox_KeyDown"
                    Text="{Binding SelectedTask.Comment, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
        </Border>

        <StackPanel
            Grid.Row="3"
            Margin="0 10 0 0"
            HorizontalAlignment="Right"
            Orientation="Horizontal">
            <ui:Button
                Width="180"
                Appearance="Success"
                Content="Вставить все согласованные"
                ToolTip="Прорезать вырезающим семейством все согласованные задания, которые ещё не прорезаны"
                Command="{Binding InsertAllApprovedCommand}" />
            <ui:Button
                Width="110"
                Margin="8 0 0 0"
                Content="Обновить"
                Command="{Binding RefreshCommand}" />
            <ui:Button
                Width="110"
                Margin="8 0 0 0"
                Appearance="Info"
                Content="Сохранить"
                Command="{Binding SaveCommand}" />
        </StackPanel>
    </Grid>
</UserControl>
