<Window
    x:Class="Juru.RevitPlugins.Openings.Views.Navigator.OpeningsNavigatorWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vms="clr-namespace:Juru.RevitPlugins.Openings.ViewModels.Navigator"
    xmlns:scm="clr-namespace:System.ComponentModel;assembly=WindowsBase"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    mc:Ignorable="d"
    Title="Навигатор по заданиям на отверстия"
    Width="1100"
    Height="640"
    MinWidth="720"
    MinHeight="420"
    WindowStartupLocation="CenterOwner"
    d:DataContext="{d:DesignInstance vms:OpeningsNavigatorViewModel, IsDesignTimeCreatable=False}">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Без словарей WPF-UI таблица и кнопки рисуются без стилей: окно наследует Window,
                     а не FluentWindow. Тему ставит JuruTheme по настройке интерфейса Revit. -->
                <ui:ThemesDictionary />
                <ui:ControlsDictionary />
                <ResourceDictionary
                    Source="pack://application:,,,/Juru.RevitPlugins.Core;component/Resources/CustomStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Список группируется по состоянию, а группы упорядочены так, чтобы проблемные задания
                 были сверху: в списке из сотни корректных иначе не найти те, с которыми что-то не так. -->
            <CollectionViewSource
                x:Key="TasksView"
                Source="{Binding Tasks}">
                <CollectionViewSource.SortDescriptions>
                    <scm:SortDescription
                        PropertyName="SortOrder" />
                    <scm:SortDescription
                        PropertyName="Status" />
                    <scm:SortDescription
                        PropertyName="MepSystem" />
                </CollectionViewSource.SortDescriptions>
                <CollectionViewSource.GroupDescriptions>
                    <PropertyGroupDescription
                        PropertyName="Status" />
                </CollectionViewSource.GroupDescriptions>
            </CollectionViewSource>

            <Style
                x:Key="Hint"
                TargetType="TextBlock">
                <Setter
                    Property="Opacity"
                    Value="0.6" />
                <Setter
                    Property="TextWrapping"
                    Value="Wrap" />
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid
        Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition
                Height="Auto" />
            <RowDefinition
                Height="*" />
            <RowDefinition
                Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel
            Grid.Row="0"
            Margin="0 0 0 10">
            <TextBlock
                FontWeight="SemiBold"
                Text="{Binding Summary}" />
            <TextBlock
                Style="{StaticResource Hint}"
                Text="{Binding LinksText}" />
            <TextBlock
                Style="{StaticResource Hint}">
                <Run
                    Text="Состояния определены по настройкам:" />
                <Run
                    Text="{Binding ConfigName, Mode=OneWay}" />
                <Run
                    Text="и пересчитываются при каждом обновлении - в модели они не хранятся." />
            </TextBlock>
        </StackPanel>

        <Border
            Grid.Row="1"
            Style="{StaticResource CustomBorder}">
            <DataGrid
                Margin="1"
                AutoGenerateColumns="False"
                CanUserAddRows="False"
                CanUserDeleteRows="False"
                GridLinesVisibility="Horizontal"
                HeadersVisibility="Column"
                IsReadOnly="True"
                ItemsSource="{Binding Source={StaticResource TasksView}}"
                SelectedItem="{Binding SelectedTask}"
                SelectionMode="Single"
                SelectionUnit="FullRow">

                <DataGrid.InputBindings>
                    <MouseBinding
                        MouseAction="LeftDoubleClick"
                        Command="{Binding ShowCommand}"
                        CommandParameter="{Binding SelectedTask}" />
                </DataGrid.InputBindings>

                <DataGrid.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.ContainerStyle>
                            <Style
                                TargetType="GroupItem">
                                <Setter
                                    Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate
                                            TargetType="GroupItem">
                                            <Expander
                                                IsExpanded="True"
                                                Margin="0 4 0 0">
                                                <Expander.Header>
                                                    <StackPanel
                                                        Orientation="Horizontal">
                                                        <TextBlock
                                                            FontWeight="SemiBold"
                                                            Text="{Binding Name}" />
                                                        <TextBlock
                                                            Margin="8 0 0 0"
                                                            Opacity="0.6"
                                                            Text="{Binding ItemCount, StringFormat=({0})}" />
                                                    </StackPanel>
                                                </Expander.Header>
                                                <ItemsPresenter />
                                            </Expander>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </GroupStyle.ContainerStyle>
                    </GroupStyle>
                </DataGrid.GroupStyle>

                <DataGrid.Columns>
                    <DataGridTemplateColumn
                        Width="90">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ui:Button
                                    Margin="2"
                                    Padding="8 2"
                                    Content="Показать"
                                    Command="{Binding DataContext.ShowCommand,
                                        RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn
                        Width="70"
                        Binding="{Binding Id}"
                        Header="Id" />
                    <DataGridTextColumn
                        Width="130"
                        Binding="{Binding MepSystem}"
                        Header="Система" />
                    <DataGridTextColumn
                        Width="110"
                        Binding="{Binding Size}"
                        Header="Габариты, мм" />
                    <DataGridTextColumn
                        Width="90"
                        Binding="{Binding Elevation}"
                        Header="Отметка" />
                    <DataGridTextColumn
                        Width="90"
                        Binding="{Binding CenterElevation}"
                        Header="Отм. оси" />
                    <DataGridTextColumn
                        Width="180"
                        Binding="{Binding Host}"
                        Header="Конструкция" />
                    <DataGridTextColumn
                        Width="90"
                        Binding="{Binding Date}"
                        Header="Дата" />
                    <DataGridTextColumn
                        Width="*"
                        Binding="{Binding Description}"
                        Header="Описание" />
                    <DataGridTextColumn
                        Width="130"
                        Binding="{Binding Author}"
                        Header="Автор" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <DockPanel
            Grid.Row="2"
            Margin="0 12 0 0">
            <TextBlock
                Style="{StaticResource Hint}"
                VerticalAlignment="Center"
                Text="Двойной щелчок по строке показывает задание в модели." />

            <StackPanel
                HorizontalAlignment="Right"
                Orientation="Horizontal">
                <ui:Button
                    Width="120"
                    Margin="6 0"
                    Appearance="Info"
                    Content="Обновить"
                    Command="{Binding RefreshCommand}" />
                <ui:Button
                    Width="120"
                    Margin="6 0"
                    Content="Закрыть"
                    Click="ButtonClose_Click" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
