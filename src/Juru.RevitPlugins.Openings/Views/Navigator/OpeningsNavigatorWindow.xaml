<Window
    x:Class="Juru.RevitPlugins.Openings.Views.Navigator.OpeningsNavigatorWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vms="clr-namespace:Juru.RevitPlugins.Openings.ViewModels.Navigator"
    xmlns:scm="clr-namespace:System.ComponentModel;assembly=WindowsBase"
    xmlns:loc="clr-namespace:Juru.RevitPlugins.Core.Localization;assembly=Juru.RevitPlugins.Core"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    mc:Ignorable="d"
    Title="{DynamicResource Navigator.Title}"
    Width="1100"
    Height="640"
    MinWidth="720"
    MinHeight="420"
    WindowStartupLocation="CenterOwner"
    d:DataContext="{d:DesignInstance vms:OpeningsNavigatorViewModel, IsDesignTimeCreatable=False}">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Без словарей WPF-UI таблица и кнопки рисуются без стилей: окно наследует Window,
                     а не FluentWindow. Тему ставит JuruTheme по настройке интерфейса Revit. -->
                <ui:ThemesDictionary />
                <ui:ControlsDictionary />
                <ResourceDictionary
                    Source="pack://application:,,,/Juru.RevitPlugins.Core;component/Resources/CustomStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Список группируется по состоянию, а группы упорядочены так, чтобы проблемные задания
                 были сверху: в списке из сотни корректных иначе не найти те, с которыми что-то не так. -->
            <CollectionViewSource
                x:Key="TasksView"
                Source="{Binding Tasks}"
                Filter="TasksView_Filter">
                <CollectionViewSource.SortDescriptions>
                    <scm:SortDescription
                        PropertyName="SortOrder" />
                    <scm:SortDescription
                        PropertyName="Status" />
                    <scm:SortDescription
                        PropertyName="DateGroupText" />
                    <scm:SortDescription
                        PropertyName="MepSystem" />
                </CollectionViewSource.SortDescriptions>
                <CollectionViewSource.GroupDescriptions>
                    <PropertyGroupDescription
                        PropertyName="Status" />
                    <PropertyGroupDescription
                        PropertyName="DateGroupText" />
                </CollectionViewSource.GroupDescriptions>
            </CollectionViewSource>

            <Style
                x:Key="Hint"
                TargetType="TextBlock">
                <Setter
                    Property="Opacity"
                    Value="0.6" />
                <Setter
                    Property="TextWrapping"
                    Value="Wrap" />
            </Style>

            <!-- Панель всплывающего списка живёт в отдельном визуальном дереве, поэтому фон и
                 цвет текста берём из темы явно: иначе в тёмной теме светлый текст ложится
                 на светлую панель. -->
            <Style
                x:Key="ColumnsPopupPanelStyle"
                TargetType="Border">
                <Setter
                    Property="Background"
                    Value="{ui:ThemeResource ApplicationBackgroundBrush}" />
                <Setter
                    Property="BorderBrush"
                    Value="{ui:ThemeResource ControlElevationBorderBrush}" />
                <Setter
                    Property="BorderThickness"
                    Value="1" />
                <Setter
                    Property="Padding"
                    Value="8" />
                <Setter
                    Property="TextBlock.Foreground"
                    Value="{ui:ThemeResource TextFillColorPrimaryBrush}" />
            </Style>

            <!-- Флажкам цвет задаём отдельно: их собственный стиль WPF-UI перекрывает
                 наследование от панели. -->
            <Style
                x:Key="ColumnsPopupCheckBoxStyle"
                TargetType="CheckBox">
                <Setter
                    Property="Foreground"
                    Value="{ui:ThemeResource TextFillColorPrimaryBrush}" />
            </Style>

            <!-- Первый клик по невыделенной ячейке иначе уходит на выбор ячейки, а не на кнопку
                 внутри неё - см. DataGridCell_PreviewMouseLeftButtonDown в code-behind. -->
            <Style
                TargetType="DataGridCell">
                <EventSetter
                    Event="PreviewMouseLeftButtonDown"
                    Handler="DataGridCell_PreviewMouseLeftButtonDown" />
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid
        Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition
                Height="Auto" />
            <RowDefinition
                Height="*" />
            <RowDefinition
                Height="Auto" />
            <RowDefinition
                Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel
            Grid.Row="0"
            Margin="0 0 0 10">
            <ui:TextBox
                x:Name="SearchBox"
                DockPanel.Dock="Right"
                Width="220"
                VerticalAlignment="Top"
                PlaceholderText="{DynamicResource Navigator.SearchPlaceholder}"
                TextChanged="SearchBox_TextChanged" />
            <StackPanel>
                <TextBlock
                    FontWeight="SemiBold"
                    Text="{Binding Summary}" />
                <TextBlock
                    TextWrapping="Wrap"
                    Text="{Binding LinksText}">
                    <TextBlock.Style>
                        <Style
                            BasedOn="{StaticResource Hint}"
                            TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger
                                    Binding="{Binding NoLinksLoaded}"
                                    Value="True">
                                    <Setter
                                        Property="Foreground"
                                        Value="OrangeRed" />
                                    <Setter
                                        Property="Opacity"
                                        Value="1" />
                                    <Setter
                                        Property="FontWeight"
                                        Value="SemiBold" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <!-- Решения приходят с сервера, а состояния считаются локально: если сервер
                     не ответил, окно всё равно полезно, и об этом нужно сказать явно - иначе
                     прочерк в колонках решений читается как "никто ещё не ответил". -->
                <TextBlock
                    TextWrapping="Wrap"
                    Text="{Binding ServerText}">
                    <TextBlock.Style>
                        <Style
                            BasedOn="{StaticResource Hint}"
                            TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger
                                    Binding="{Binding DecisionsUnknown}"
                                    Value="True">
                                    <Setter
                                        Property="Foreground"
                                        Value="OrangeRed" />
                                    <Setter
                                        Property="Opacity"
                                        Value="1" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock
                    Style="{StaticResource Hint}">
                    <Run
                        Text="{DynamicResource Navigator.ConfigHintPrefix}" />
                    <Run
                        Text="{Binding ConfigName, Mode=OneWay}" />
                    <Run
                        Text="{DynamicResource Navigator.ConfigHintSuffix}" />
                </TextBlock>

                <!-- Список флажков собирается по самому гриду - см. code-behind, чтобы
                     не заводить второй перечень колонок. Всплывающим списком, а не Expander:
                     раскрытый Expander закрывался только повторным щелчком по стрелке,
                     а Popup со StaysOpen=False уходит от клика мимо него.
                     ClickMode=Press: иначе клик по кнопке при открытом Popup перехватывается им,
                     и кнопка остаётся нажатой при закрытом списке. -->
                <WrapPanel
                    Margin="0 8 0 0">
                    <ToggleButton
                        x:Name="ColumnsToggle"
                        ClickMode="Press"
                        Content="{DynamicResource Navigator.ColumnsToggle}"
                        ToolTip="{DynamicResource Navigator.ColumnsToggleTooltip}" />
                    <Popup
                        AllowsTransparency="False"
                        IsOpen="{Binding IsChecked, ElementName=ColumnsToggle}"
                        Placement="Bottom"
                        PlacementTarget="{Binding ElementName=ColumnsToggle}"
                        StaysOpen="False">
                        <Border
                            MinWidth="180"
                            Style="{StaticResource ColumnsPopupPanelStyle}">
                            <WrapPanel
                                x:Name="ColumnsPanel"
                                MaxWidth="420" />
                        </Border>
                    </Popup>
                </WrapPanel>
            </StackPanel>
        </DockPanel>

        <Border
            Grid.Row="1"
            Style="{StaticResource CustomBorder}">
            <DataGrid
                x:Name="TasksGrid"
                Margin="1"
                AutoGenerateColumns="False"
                CanUserAddRows="False"
                CanUserResizeColumns="True"
                ColumnHeaderStyle="{StaticResource CustomResizableColumnHeaderStyle}"
                CanUserDeleteRows="False"
                GridLinesVisibility="Horizontal"
                HeadersVisibility="Column"
                IsReadOnly="True"
                ItemsSource="{Binding Source={StaticResource TasksView}}"
                SelectedItem="{Binding SelectedTask}"
                SelectionMode="Extended"
                SelectionUnit="FullRow"
                PreviewKeyDown="TasksGrid_PreviewKeyDown"
                SelectionChanged="TasksGrid_SelectionChanged">

                <DataGrid.InputBindings>
                    <MouseBinding
                        MouseAction="LeftDoubleClick"
                        Command="{Binding ShowCommand}"
                        CommandParameter="{Binding SelectedTask}" />
                </DataGrid.InputBindings>

                <DataGrid.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.ContainerStyle>
                            <Style
                                TargetType="GroupItem">
                                <Setter
                                    Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate
                                            TargetType="GroupItem">
                                            <Expander
                                                IsExpanded="True"
                                                Margin="0 4 0 0">
                                                <Expander.Header>
                                                    <StackPanel
                                                        Orientation="Horizontal">
                                                        <TextBlock
                                                            FontWeight="SemiBold"
                                                            Text="{Binding Name}" />
                                                        <TextBlock
                                                            Margin="8 0 0 0"
                                                            Opacity="0.6"
                                                            Text="{Binding ItemCount, StringFormat=({0})}" />
                                                    </StackPanel>
                                                </Expander.Header>
                                                <ItemsPresenter />
                                            </Expander>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </GroupStyle.ContainerStyle>
                    </GroupStyle>
                </DataGrid.GroupStyle>

                <DataGrid.Columns>
                    <DataGridTemplateColumn
                        Width="40"
                        loc:ColumnLocalization.Key="Navigator.Column.HostButton">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <!-- Отдельная кнопка на хост - стену/перекрытие, которое пробивает
                                     задание - как в Bim4Everyone: одна кнопка ведёт к самому
                                     заданию, другая, лупа, к его основе. -->
                                <ui:Button
                                    Margin="2"
                                    Padding="4 2"
                                    ToolTip="{DynamicResource Navigator.ShowHostTooltip}"
                                    Content="&#128269;"
                                    IsEnabled="{Binding CanShowHost}"
                                    Click="ShowHostButton_Click" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn
                        Width="70"
                        Binding="{Binding Id}"
                        loc:ColumnLocalization.Key="Navigator.Column.Id" />
                    <DataGridTextColumn
                        Width="130"
                        Binding="{Binding MepSystem}"
                        loc:ColumnLocalization.Key="Navigator.Column.MepSystem" />
                    <DataGridTextColumn
                        Width="110"
                        Binding="{Binding Size}"
                        loc:ColumnLocalization.Key="Navigator.Column.Size" />
                    <DataGridTextColumn
                        Width="90"
                        Binding="{Binding Elevation}"
                        loc:ColumnLocalization.Key="Navigator.Column.Elevation" />
                    <DataGridTextColumn
                        Width="90"
                        Binding="{Binding CenterElevation}"
                        loc:ColumnLocalization.Key="Navigator.Column.CenterElevation" />
                    <!-- Два решения отдельными колонками, а не один общий статус: инженеру нужно
                         видеть, кто именно ещё не ответил. -->
                    <DataGridTextColumn
                        Width="120"
                        Binding="{Binding ArcDecisionText}"
                        loc:ColumnLocalization.Key="Navigator.Column.ArcDecision">
                        <DataGridTextColumn.ElementStyle>
                            <Style
                                TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger
                                        Binding="{Binding IsArcRejected}"
                                        Value="True">
                                        <Setter
                                            Property="Foreground"
                                            Value="OrangeRed" />
                                        <Setter
                                            Property="FontWeight"
                                            Value="SemiBold" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn
                        Width="120"
                        Binding="{Binding StrDecisionText}"
                        loc:ColumnLocalization.Key="Navigator.Column.StrDecision">
                        <DataGridTextColumn.ElementStyle>
                            <Style
                                TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger
                                        Binding="{Binding IsStrRejected}"
                                        Value="True">
                                        <Setter
                                            Property="Foreground"
                                            Value="OrangeRed" />
                                        <Setter
                                            Property="FontWeight"
                                            Value="SemiBold" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn
                        Width="200"
                        Binding="{Binding DecisionComment}"
                        loc:ColumnLocalization.Key="Navigator.Column.DecisionComment" />
                    <DataGridTextColumn
                        Width="180"
                        Binding="{Binding Host}"
                        loc:ColumnLocalization.Key="Navigator.Column.Structure" />
                    <DataGridTextColumn
                        Width="70"
                        Binding="{Binding HostId}"
                        loc:ColumnLocalization.Key="Navigator.Column.HostId" />
                    <DataGridTextColumn
                        Width="*"
                        Binding="{Binding Description}"
                        loc:ColumnLocalization.Key="Navigator.Column.Description" />
                    <DataGridTextColumn
                        Width="130"
                        Binding="{Binding Author}"
                        loc:ColumnLocalization.Key="Navigator.Column.Author" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Переход по списку - отдельной строкой над кнопками окна, как в окне согласования:
             он относится к строкам грида, а в одном ряду с "Отправить"/"Закрыть" читался бы
             как ещё одно действие над всей пачкой заданий. -->
        <StackPanel
            Grid.Row="2"
            Margin="0 10 0 0"
            Orientation="Horizontal">
            <ui:Button
                Width="110"
                Content="{DynamicResource Navigator.PreviousButton}"
                ToolTip="{DynamicResource Navigator.PreviousTooltip}"
                Click="PreviousButton_Click" />
            <ui:Button
                Width="110"
                Margin="8 0 0 0"
                Content="{DynamicResource Navigator.NextButton}"
                ToolTip="{DynamicResource Navigator.NextTooltip}"
                Click="NextButton_Click" />
            <TextBlock
                x:Name="PositionText"
                Margin="12 0 0 0"
                VerticalAlignment="Center"
                Style="{StaticResource Hint}" />
            <TextBlock
                Margin="16 0 0 0"
                VerticalAlignment="Center"
                Style="{StaticResource Hint}"
                Text="{DynamicResource Navigator.RowHint}" />
        </StackPanel>

        <!-- WrapPanel, а не StackPanel в DockPanel: подсказка рядом забирала себе ширину,
             и панель действий обрезалась с левого края - первым пропадал флажок "ARC".
             При нехватке ширины кнопки переносятся на вторую строку, а не исчезают. -->
        <WrapPanel
            Grid.Row="3"
            Margin="0 12 0 0"
            HorizontalAlignment="Right">
            <!-- С кем согласовывать - решает инженер: на объекте, где STR не работает в Revit,
                 ожидание его решения означало бы, что не прорежут ни одного отверстия.
                 Отмеченное уходит в пачке (approvers), и сервер считает общий статус
                 только по этим дисциплинам. -->
            <TextBlock
                Margin="0 0 8 0"
                VerticalAlignment="Center"
                Text="{DynamicResource Navigator.ApproveWithLabel}" />
            <CheckBox
                Margin="0 0 8 0"
                VerticalAlignment="Center"
                Content="ARC"
                ToolTip="{DynamicResource Navigator.ApproveArcTooltip}"
                IsChecked="{Binding ApproveWithArc}" />
            <CheckBox
                Margin="0 0 12 0"
                VerticalAlignment="Center"
                Content="STR"
                ToolTip="{DynamicResource Navigator.ApproveStrTooltip}"
                IsChecked="{Binding ApproveWithStr}" />
            <!-- Удаление стоит до отправки, потому что в таком порядке им и пользуются: убрал лишние
                 задания - отправил остаток. Работает по выделению в гриде, а не по строке-кнопке:
                 удаляют обычно пачкой, найденной поиском. -->
            <ui:Button
                Width="120"
                Margin="6 0"
                Appearance="Danger"
                Content="{DynamicResource Common.Remove}"
                ToolTip="{DynamicResource Navigator.DeleteTooltip}"
                Click="DeleteButton_Click" />
            <ui:Button
                Width="180"
                Margin="6 0"
                Appearance="Success"
                Content="{DynamicResource Navigator.SendButton}"
                ToolTip="{DynamicResource Navigator.SendTooltip}"
                IsEnabled="{Binding CanSend}"
                Command="{Binding SendCommand}" />
            <ui:Button
                Width="120"
                Margin="6 0"
                Appearance="Info"
                Content="{DynamicResource Common.Refresh}"
                Command="{Binding RefreshCommand}" />
            <ui:Button
                Width="120"
                Margin="6 0"
                Content="{DynamicResource Common.Close}"
                Click="ButtonClose_Click" />
        </WrapPanel>
    </Grid>
</Window>
