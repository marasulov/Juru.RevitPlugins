<Window
    x:Class="Juru.RevitPlugins.Openings.Views.Navigator.IncomingOpeningsNavigatorWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vms="clr-namespace:Juru.RevitPlugins.Openings.ViewModels.Navigator"
    xmlns:scm="clr-namespace:System.ComponentModel;assembly=WindowsBase"
    xmlns:loc="clr-namespace:Juru.RevitPlugins.Core.Localization;assembly=Juru.RevitPlugins.Core"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    mc:Ignorable="d"
    Title="{DynamicResource Approval.WindowTitle}"
    Width="1250"
    Height="680"
    MinWidth="820"
    MinHeight="440"
    WindowStartupLocation="CenterOwner"
    d:DataContext="{d:DesignInstance vms:IncomingOpeningsNavigatorViewModel, IsDesignTimeCreatable=False}">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary />
                <ui:ControlsDictionary />
                <ResourceDictionary
                    Source="pack://application:,,,/Juru.RevitPlugins.Core;component/Resources/CustomStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Три уровня группировки, как в навигаторе Bim4Everyone: откуда пришло задание, его
                 статус, дата выдачи - каждый со своим счётчиком и раскрытием. Порядок сортировки
                 должен повторять порядок группировки, иначе один и тот же статус/дата разобьётся
                 на несколько групп подряд. -->
            <CollectionViewSource
                x:Key="TasksView"
                Source="{Binding Tasks}"
                Filter="TasksView_Filter">
                <CollectionViewSource.SortDescriptions>
                    <scm:SortDescription
                        PropertyName="TechnicalSortOrder" />
                    <scm:SortDescription
                        PropertyName="TechnicalGroupText" />
                    <scm:SortDescription
                        PropertyName="SenderGroupText" />
                    <scm:SortDescription
                        PropertyName="StatusGroupText" />
                    <scm:SortDescription
                        PropertyName="DateGroupText" />
                    <scm:SortDescription
                        PropertyName="MepSystem" />
                </CollectionViewSource.SortDescriptions>
                <CollectionViewSource.GroupDescriptions>
                    <PropertyGroupDescription
                        PropertyName="TechnicalGroupText" />
                    <PropertyGroupDescription
                        PropertyName="SenderGroupText" />
                    <PropertyGroupDescription
                        PropertyName="StatusGroupText" />
                    <PropertyGroupDescription
                        PropertyName="DateGroupText" />
                </CollectionViewSource.GroupDescriptions>
            </CollectionViewSource>

            <Style
                x:Key="Hint"
                TargetType="TextBlock">
                <Setter
                    Property="Opacity"
                    Value="0.6" />
                <Setter
                    Property="TextWrapping"
                    Value="Wrap" />
            </Style>

            <!-- Панель всплывающего списка живёт в отдельном визуальном дереве, поэтому фон и
                 цвет текста берём из темы явно: иначе в тёмной теме светлый текст ложится
                 на светлую панель. -->
            <Style
                x:Key="ColumnsPopupPanelStyle"
                TargetType="Border">
                <Setter
                    Property="Background"
                    Value="{ui:ThemeResource ApplicationBackgroundBrush}" />
                <Setter
                    Property="BorderBrush"
                    Value="{ui:ThemeResource ControlElevationBorderBrush}" />
                <Setter
                    Property="BorderThickness"
                    Value="1" />
                <Setter
                    Property="Padding"
                    Value="8" />
                <Setter
                    Property="TextBlock.Foreground"
                    Value="{ui:ThemeResource TextFillColorPrimaryBrush}" />
            </Style>

            <!-- Флажкам цвет задаём отдельно: их собственный стиль WPF-UI перекрывает
                 наследование от панели. -->
            <Style
                x:Key="ColumnsPopupCheckBoxStyle"
                TargetType="CheckBox">
                <Setter
                    Property="Foreground"
                    Value="{ui:ThemeResource TextFillColorPrimaryBrush}" />
            </Style>

            <BooleanToVisibilityConverter
                x:Key="BoolToVisibility" />

            <!-- Первый клик по невыделенной ячейке иначе уходит на выбор ячейки, а не на кнопку
                 внутри неё - см. DataGridCell_PreviewMouseLeftButtonDown в code-behind. -->
            <Style
                TargetType="DataGridCell">
                <EventSetter
                    Event="PreviewMouseLeftButtonDown"
                    Handler="DataGridCell_PreviewMouseLeftButtonDown" />
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid
        Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition
                Height="Auto" />
            <RowDefinition
                Height="*" />
            <RowDefinition
                Height="Auto" />
            <RowDefinition
                Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel
            Grid.Row="0"
            Margin="0 0 0 10">
            <ui:TextBox
                x:Name="SearchBox"
                DockPanel.Dock="Right"
                Width="220"
                VerticalAlignment="Top"
                PlaceholderText="{DynamicResource Navigator.SearchPlaceholder}"
                TextChanged="SearchBox_TextChanged" />
            <StackPanel>
                <TextBlock
                    FontWeight="SemiBold"
                    Text="{Binding Summary}" />
                <TextBlock
                    Style="{StaticResource Hint}"
                    Text="{DynamicResource Approval.SaveHint}" />
                <TextBlock
                    Foreground="OrangeRed"
                    Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}"
                    Text="{Binding ErrorText}" />
                <TextBlock
                    FontWeight="SemiBold"
                    Foreground="OrangeRed"
                    TextWrapping="Wrap"
                    Visibility="{Binding HasCoordinateWarning, Converter={StaticResource BoolToVisibility}}"
                    Text="{Binding CoordinateWarning}" />

                <!-- Фильтр по своему решению, а не по общему статусу задания: разбирают те, где
                     решение ещё за тобой, а решённые убирают с глаз. Работает вместе с поиском. -->
                <WrapPanel
                    Margin="0 8 0 0">
                    <TextBlock
                        Margin="0 0 8 0"
                        VerticalAlignment="Center"
                        Style="{StaticResource Hint}"
                        Text="{DynamicResource Approval.ShowLabel}" />
                    <CheckBox
                        x:Name="ShowPendingBox"
                        Margin="0 0 10 0"
                        Content="{DynamicResource Approval.ShowPending}"
                        IsChecked="True"
                        ToolTip="{DynamicResource Approval.ShowPendingTooltip}"
                        Checked="StatusFilter_Changed"
                        Unchecked="StatusFilter_Changed" />
                    <CheckBox
                        x:Name="ShowApprovedBox"
                        Margin="0 0 10 0"
                        Content="{DynamicResource Approval.ShowApproved}"
                        IsChecked="True"
                        ToolTip="{DynamicResource Approval.ShowApprovedTooltip}"
                        Checked="StatusFilter_Changed"
                        Unchecked="StatusFilter_Changed" />
                    <CheckBox
                        x:Name="ShowRejectedBox"
                        Margin="0 0 16 0"
                        Content="{DynamicResource Approval.ShowRejected}"
                        IsChecked="True"
                        ToolTip="{DynamicResource Approval.ShowRejectedTooltip}"
                        Checked="StatusFilter_Changed"
                        Unchecked="StatusFilter_Changed" />

                    <!-- Список флажков собирается по самому гриду - см. code-behind, чтобы
                         не заводить второй перечень колонок. Всплывающим списком, а не Expander:
                         раскрытый Expander закрывался только повторным щелчком по стрелке,
                         а Popup со StaysOpen=False уходит от клика мимо него.
                         ClickMode=Press: иначе клик по кнопке при открытом Popup перехватывается им,
                         и кнопка остаётся нажатой при закрытом списке. -->
                    <ToggleButton
                        x:Name="ColumnsToggle"
                        ClickMode="Press"
                        Content="{DynamicResource Navigator.ColumnsToggle}"
                        ToolTip="{DynamicResource Navigator.ColumnsToggleTooltip}" />
                    <Popup
                        AllowsTransparency="False"
                        IsOpen="{Binding IsChecked, ElementName=ColumnsToggle}"
                        Placement="Bottom"
                        PlacementTarget="{Binding ElementName=ColumnsToggle}"
                        StaysOpen="False">
                        <Border
                            MinWidth="180"
                            Style="{StaticResource ColumnsPopupPanelStyle}">
                            <WrapPanel
                                x:Name="ColumnsPanel"
                                MaxWidth="420" />
                        </Border>
                    </Popup>
                </WrapPanel>
            </StackPanel>
        </DockPanel>

        <Border
            Grid.Row="1"
            Style="{StaticResource CustomBorder}">
            <DataGrid
                x:Name="TasksGrid"
                Margin="1"
                AutoGenerateColumns="False"
                CanUserAddRows="False"
                CanUserResizeColumns="True"
                ColumnHeaderStyle="{StaticResource CustomResizableColumnHeaderStyle}"
                CanUserDeleteRows="False"
                EnableRowVirtualization="False"
                EnableColumnVirtualization="False"
                GridLinesVisibility="Horizontal"
                HeadersVisibility="Column"
                ItemsSource="{Binding Source={StaticResource TasksView}}"
                SelectionMode="Single"
                SelectionUnit="FullRow">

                <DataGrid.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.ContainerStyle>
                            <Style
                                TargetType="GroupItem">
                                <Setter
                                    Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate
                                            TargetType="GroupItem">
                                            <Expander
                                                IsExpanded="True"
                                                Margin="0 4 0 0">
                                                <Expander.Header>
                                                    <StackPanel
                                                        Orientation="Horizontal">
                                                        <TextBlock
                                                            FontWeight="SemiBold"
                                                            Text="{Binding Name}" />
                                                        <TextBlock
                                                            Margin="8 0 0 0"
                                                            Opacity="0.6"
                                                            Text="{Binding ItemCount, StringFormat=({0})}" />
                                                    </StackPanel>
                                                </Expander.Header>
                                                <ItemsPresenter />
                                            </Expander>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </GroupStyle.ContainerStyle>
                    </GroupStyle>
                </DataGrid.GroupStyle>

                <DataGrid.Columns>
                    <!-- Id задания, хост и его Id - как у Bim4Everyone: помогают свериться
                         с моделью напрямую, без похода через "Показать". -->
                    <DataGridTextColumn
                        Width="60"
                        IsReadOnly="True"
                        Binding="{Binding ElementIdText}"
                        loc:ColumnLocalization.Key="Navigator.Column.Id" />
                    <DataGridTextColumn
                        Width="150"
                        IsReadOnly="True"
                        Binding="{Binding HostName}"
                        loc:ColumnLocalization.Key="Approval.Column.HostName" />
                    <DataGridTextColumn
                        Width="70"
                        IsReadOnly="True"
                        Binding="{Binding HostElementIdText}"
                        loc:ColumnLocalization.Key="Navigator.Column.HostId" />
                    <DataGridTextColumn
                        Width="120"
                        IsReadOnly="True"
                        Binding="{Binding OpeningTypeText}"
                        loc:ColumnLocalization.Key="Approval.Column.OpeningType" />
                    <DataGridTextColumn
                        Width="100"
                        IsReadOnly="True"
                        Binding="{Binding SizeText}"
                        loc:ColumnLocalization.Key="Navigator.Column.Size" />
                    <DataGridTextColumn
                        Width="90"
                        IsReadOnly="True"
                        Binding="{Binding LevelName}"
                        loc:ColumnLocalization.Key="Approval.Column.Level" />
                    <DataGridTextColumn
                        Width="110"
                        IsReadOnly="True"
                        Binding="{Binding MepSystem}"
                        loc:ColumnLocalization.Key="Navigator.Column.MepSystem" />
                    <DataGridTextColumn
                        Width="80"
                        IsReadOnly="True"
                        Binding="{Binding SenderDiscipline}"
                        loc:ColumnLocalization.Key="Approval.Column.From" />
                    <DataGridTextColumn
                        Width="130"
                        IsReadOnly="True"
                        Binding="{Binding SentByDisplayName}"
                        loc:ColumnLocalization.Key="Approval.Column.SentBy" />
                    <DataGridTextColumn
                        Width="120"
                        IsReadOnly="True"
                        Binding="{Binding SentAtText}"
                        loc:ColumnLocalization.Key="Approval.Column.SentAt" />
                    <DataGridTextColumn
                        Width="150"
                        IsReadOnly="True"
                        Binding="{Binding OtherDisciplineText}"
                        loc:ColumnLocalization.Key="Approval.Column.OtherDiscipline" />
                    <!-- Пересчитано локально по конструкциям файла АР/КР, плюс "объединённое" -
                         факт с ВИС-стороны, переданный флагом. Не решение согласующего. -->
                    <DataGridTextColumn
                        Width="140"
                        IsReadOnly="True"
                        Binding="{Binding TechnicalStatusText}"
                        loc:ColumnLocalization.Key="Approval.Column.Technical">
                        <DataGridTextColumn.ElementStyle>
                            <Style
                                TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger
                                        Binding="{Binding TechnicalStatusNeedsAttention}"
                                        Value="True">
                                        <Setter
                                            Property="Foreground"
                                            Value="OrangeRed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTemplateColumn
                        Width="160"
                        loc:ColumnLocalization.Key="Approval.Column.MyDecision">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel
                                    Orientation="Horizontal">
                                    <ui:Button
                                        Margin="1"
                                        Padding="6 2"
                                        Content="✓"
                                        ToolTip="{DynamicResource Approval.ApproveTooltip}"
                                        IsEnabled="{Binding CanApprove}"
                                        Click="ApproveButton_Click" />
                                    <ui:Button
                                        Margin="1"
                                        Padding="6 2"
                                        Content="✕"
                                        ToolTip="{DynamicResource Approval.RejectTooltip}"
                                        IsEnabled="{Binding CanReject}"
                                        Click="RejectButton_Click" />
                                    <!-- Какое решение сейчас выбрано, показывает подпись, а не цвет
                                         кнопок: динамическая перекраска ui:Button через триггеры стиля
                                         не переживала смену выделения строки в теме WPF-UI. -->
                                    <TextBlock
                                        Margin="6 0 0 0"
                                        VerticalAlignment="Center"
                                        FontWeight="SemiBold"
                                        Text="{Binding OwnStatusText}">
                                        <TextBlock.Style>
                                            <Style
                                                TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger
                                                        Binding="{Binding IsApproved}"
                                                        Value="True">
                                                        <Setter
                                                            Property="Foreground"
                                                            Value="Green" />
                                                    </DataTrigger>
                                                    <DataTrigger
                                                        Binding="{Binding IsRejected}"
                                                        Value="True">
                                                        <Setter
                                                            Property="Foreground"
                                                            Value="Red" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock
                                        Margin="4 0 0 0"
                                        VerticalAlignment="Center"
                                        Foreground="OrangeRed"
                                        Text="*"
                                        Visibility="{Binding IsDirty, Converter={StaticResource BoolToVisibility}}" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn
                        Width="90"
                        loc:ColumnLocalization.Key="Approval.Column.Show">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ui:Button
                                    Margin="2"
                                    Padding="8 2"
                                    Content="{DynamicResource Approval.Column.Show}"
                                    IsEnabled="{Binding CanShow}"
                                    Click="ShowButton_Click" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn
                        Width="90"
                        loc:ColumnLocalization.Key="Approval.Column.Insert">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <!-- Прорезает вырезающим семейством одно согласованное задание -
                                     необратимое (в рамках навигатора) изменение модели, поэтому
                                     по явному клику, а не само по себе при обновлении. -->
                                <!-- Прорезать может только АР - КР только согласовывает
                                     (CanCut, решение из этой сессии). Кнопка не просто выключена,
                                     а скрыта - в файле КР её не должно быть видно вообще. -->
                                <ui:Button
                                    Margin="2"
                                    Padding="8 2"
                                    Appearance="Success"
                                    Content="{DynamicResource Approval.Column.Insert}"
                                    ToolTip="{Binding InsertHint}"
                                    IsEnabled="{Binding CanInsert}"
                                    Visibility="{Binding CanCut, Converter={StaticResource BoolToVisibility}}"
                                    Click="InsertButton_Click" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <!-- Колонка пустует, пока инженер ничего не удалял, поэтому окно её прячет
                         целиком - см. UpdateRemoveColumn в code-behind: заголовок без единой
                         кнопки под ним читается как поломка. -->
                    <DataGridTemplateColumn
                        x:Name="RemoveColumn"
                        Width="90"
                        loc:ColumnLocalization.Key="Approval.Column.Remove">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <!-- Появляется только у заданий, которые инженер удалил, а
                                     отверстие по ним уже прорезано: обновление такое отверстие
                                     не трогает - конструкция прорезана по согласованному
                                     заданию, и зарастить её молча нельзя. -->
                                <ui:Button
                                    Margin="2"
                                    Padding="8 2"
                                    Appearance="Danger"
                                    Content="{DynamicResource Approval.Column.Remove}"
                                    ToolTip="{DynamicResource Approval.RemoveButtonTooltip}"
                                    Visibility="{Binding CanRemove, Converter={StaticResource BoolToVisibility}}"
                                    Click="RemoveButton_Click" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn
                        Width="40"
                        loc:ColumnLocalization.Key="Navigator.Column.HostButton">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <!-- Отдельная кнопка на хост - стену/перекрытие, которое пробивает
                                     задание - как в Bim4Everyone: одна кнопка ведёт к самому
                                     заданию, другая, лупа, к его основе. -->
                                <ui:Button
                                    Margin="2"
                                    Padding="4 2"
                                    ToolTip="{DynamicResource Navigator.ShowHostTooltip}"
                                    Content="&#128269;"
                                    IsEnabled="{Binding CanShowHost}"
                                    Click="ShowHostButton_Click" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn
                        Width="200"
                        IsReadOnly="False"
                        Binding="{Binding Comment, UpdateSourceTrigger=PropertyChanged}"
                        loc:ColumnLocalization.Key="Approval.Column.Comment" />
                    <DataGridTextColumn
                        Width="*"
                        IsReadOnly="True"
                        Binding="{Binding Description}"
                        loc:ColumnLocalization.Key="Navigator.Column.Description" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Переход по списку - отдельной строкой над кнопками окна: он относится к строкам грида,
             а в одном ряду с "Сохранить"/"Закрыть" читался как ещё одно действие над всей пачкой. -->
        <StackPanel
            Grid.Row="2"
            Margin="0 10 0 0"
            Orientation="Horizontal">
            <ui:Button
                Width="110"
                Content="{DynamicResource Navigator.PreviousButton}"
                ToolTip="{DynamicResource Navigator.PreviousTooltip}"
                Click="PreviousButton_Click" />
            <ui:Button
                Width="110"
                Margin="8 0 0 0"
                Content="{DynamicResource Navigator.NextButton}"
                ToolTip="{DynamicResource Navigator.NextTooltip}"
                Click="NextButton_Click" />
            <TextBlock
                x:Name="PositionText"
                Margin="12 0 0 0"
                VerticalAlignment="Center"
                Style="{StaticResource Hint}" />
            <TextBlock
                Margin="16 0 0 0"
                VerticalAlignment="Center"
                Style="{StaticResource Hint}"
                Text="{DynamicResource Approval.DirtyHint}" />
        </StackPanel>

        <DockPanel
            Grid.Row="3"
            Margin="0 12 0 0">
            <StackPanel
                HorizontalAlignment="Right"
                Orientation="Horizontal">
                <ui:Button
                    Width="215"
                    Margin="6 0"
                    Appearance="Success"
                    Content="{DynamicResource Approval.InsertAllButton}"
                    ToolTip="{DynamicResource Approval.InsertAllTooltip}"
                    Visibility="{Binding CanCut, Converter={StaticResource BoolToVisibility}}"
                    Command="{Binding InsertAllApprovedCommand}" />
                <ui:Button
                    Width="120"
                    Margin="6 0"
                    Content="{DynamicResource Common.Refresh}"
                    Command="{Binding RefreshCommand}" />
                <ui:Button
                    Width="120"
                    Margin="6 0"
                    Appearance="Info"
                    Content="{DynamicResource Common.Save}"
                    Command="{Binding SaveCommand}" />
                <ui:Button
                    Width="120"
                    Margin="6 0"
                    Content="{DynamicResource Common.Close}"
                    Click="ButtonClose_Click" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
