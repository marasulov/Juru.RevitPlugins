<Window
    x:Class="Juru.RevitPlugins.Openings.Views.Settings.OpeningsSettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    xmlns:configs="clr-namespace:Juru.RevitPlugins.Openings.Models.Configs"
    xmlns:vms="clr-namespace:Juru.RevitPlugins.Openings.ViewModels.Settings"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    mc:Ignorable="d"
    Title="Настройки выдачи заданий"
    Width="880"
    Height="700"
    MinWidth="820"
    MinHeight="620"
    WindowStartupLocation="CenterOwner"
    d:DataContext="{d:DesignInstance vms:OpeningsSettingsViewModel, IsDesignTimeCreatable=False}">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Без словарей WPF-UI флажки и поля рисуются без стилей: окно наследует Window,
                     а не FluentWindow. Тему здесь задавать нечего - её ставит JuruTheme по настройке
                     интерфейса Revit, светлую или тёмную. -->
                <ui:ThemesDictionary />
                <ui:ControlsDictionary />
                <ResourceDictionary
                    Source="pack://application:,,,/Juru.RevitPlugins.Core;component/Resources/CustomStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter
                x:Key="BoolToVisibility" />

            <ObjectDataProvider
                x:Key="Shapes"
                MethodName="GetValues"
                ObjectType="{x:Type sys:Enum}">
                <ObjectDataProvider.MethodParameters>
                    <x:Type
                        TypeName="configs:OpeningShape" />
                </ObjectDataProvider.MethodParameters>
            </ObjectDataProvider>

            <Style
                x:Key="SectionTitle"
                TargetType="TextBlock">
                <Setter
                    Property="FontWeight"
                    Value="SemiBold" />
                <Setter
                    Property="Margin"
                    Value="0 0 0 2" />
            </Style>

            <Style
                x:Key="Hint"
                TargetType="TextBlock">
                <Setter
                    Property="Opacity"
                    Value="0.6" />
                <Setter
                    Property="TextWrapping"
                    Value="Wrap" />
                <Setter
                    Property="Margin"
                    Value="0 0 0 8" />
            </Style>

            <Style
                x:Key="FieldRow"
                TargetType="DockPanel">
                <Setter
                    Property="Margin"
                    Value="0 3" />
            </Style>

            <Style
                x:Key="FieldName"
                TargetType="TextBlock">
                <Setter
                    Property="Width"
                    Value="250" />
                <Setter
                    Property="VerticalAlignment"
                    Value="Center" />
                <Setter
                    Property="TextWrapping"
                    Value="Wrap" />
            </Style>

            <Style
                x:Key="FieldValue"
                TargetType="ui:TextBox">
                <Setter
                    Property="Width"
                    Value="110" />
                <Setter
                    Property="HorizontalAlignment"
                    Value="Left" />
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition
                Height="Auto" />
            <RowDefinition
                Height="*" />
            <RowDefinition
                Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar
            Grid.Row="0"
            Title="Настройки выдачи заданий" />

        <Grid
            Grid.Row="1"
            Margin="14 6 14 0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition
                    Width="250" />
                <ColumnDefinition
                    Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Слева только выбор вида: что с ним делать, решается справа. -->
            <Border
                Grid.Column="0"
                Margin="0 0 14 0"
                Style="{StaticResource CustomBorder}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition
                            Height="Auto" />
                        <RowDefinition
                            Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel
                        Grid.Row="0"
                        Margin="12 10 12 4">
                        <TextBlock
                            Style="{StaticResource SectionTitle}"
                            Text="Виды элементов" />
                        <TextBlock
                            Style="{StaticResource Hint}"
                            Text="Настройки задаются для каждого вида отдельно. Серым показаны те, для которых задания не выдаются." />
                    </StackPanel>

                    <ListBox
                        Grid.Row="1"
                        Margin="6 0 6 6"
                        BorderThickness="0"
                        Background="Transparent"
                        HorizontalContentAlignment="Stretch"
                        ItemsSource="{Binding Categories}"
                        SelectedItem="{Binding SelectedCategory}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock
                                    Margin="6 7"
                                    Text="{Binding Name}"
                                    TextWrapping="Wrap">
                                    <TextBlock.Style>
                                        <Style
                                            TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger
                                                    Binding="{Binding IsSelected}"
                                                    Value="False">
                                                    <Setter
                                                        Property="Opacity"
                                                        Value="0.45" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <ScrollViewer
                Grid.Column="1"
                VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border
                        Margin="0 0 0 12"
                        DataContext="{Binding SelectedCategory}"
                        Style="{StaticResource CustomBorder}">
                        <StackPanel
                            Margin="12 10">
                            <TextBlock
                                Style="{StaticResource SectionTitle}"
                                Text="{Binding Name}" />
                            <TextBlock
                                Style="{StaticResource Hint}"
                                Text="Выключите, если для этого вида задания на отверстия не нужны: такие элементы не проверяются вовсе." />
                            <CheckBox
                                Content="Выдавать задания для этого вида"
                                IsChecked="{Binding IsSelected}" />
                        </StackPanel>
                    </Border>

                    <Border
                        Margin="0 0 0 12"
                        DataContext="{Binding SelectedCategory}"
                        Style="{StaticResource CustomBorder}">
                        <StackPanel
                            Margin="12 10"
                            IsEnabled="{Binding IsSelected}">
                            <TextBlock
                                Style="{StaticResource SectionTitle}"
                                Text="Какие элементы проверять" />
                            <TextBlock
                                Style="{StaticResource Hint}"
                                Text="Элементы мельче наименьшего габарита не проверяются: для них отверстия не выдают. Крупнее наибольшего - пропускаются как ошибка черчения." />

                            <DockPanel
                                Style="{StaticResource FieldRow}"
                                Visibility="{Binding IsRound, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock
                                    Style="{StaticResource FieldName}"
                                    Text="Наименьший диаметр, мм" />
                                <ui:TextBox
                                    Style="{StaticResource FieldValue}"
                                    Text="{Binding MinDiameterMm, UpdateSourceTrigger=PropertyChanged}" />
                            </DockPanel>
                            <StackPanel
                                Visibility="{Binding IsRectangular, Converter={StaticResource BoolToVisibility}}">
                                <DockPanel
                                    Style="{StaticResource FieldRow}">
                                    <TextBlock
                                        Style="{StaticResource FieldName}"
                                        Text="Наименьшая ширина, мм" />
                                    <ui:TextBox
                                        Style="{StaticResource FieldValue}"
                                        Text="{Binding MinWidthMm, UpdateSourceTrigger=PropertyChanged}" />
                                </DockPanel>
                                <DockPanel
                                    Style="{StaticResource FieldRow}">
                                    <TextBlock
                                        Style="{StaticResource FieldName}"
                                        Text="Наименьшая высота, мм" />
                                    <ui:TextBox
                                        Style="{StaticResource FieldValue}"
                                        Text="{Binding MinHeightMm, UpdateSourceTrigger=PropertyChanged}" />
                                </DockPanel>
                            </StackPanel>
                            <DockPanel
                                Style="{StaticResource FieldRow}">
                                <TextBlock
                                    Style="{StaticResource FieldName}"
                                    Text="Наибольший габарит, мм" />
                                <ui:TextBox
                                    Style="{StaticResource FieldValue}"
                                    Text="{Binding MaxSizeMm, UpdateSourceTrigger=PropertyChanged}" />
                            </DockPanel>

                            <TextBlock
                                Margin="0 10 0 2"
                                Style="{StaticResource SectionTitle}"
                                Text="В каких конструкциях" />
                            <StackPanel
                                Margin="0 4"
                                Orientation="Horizontal">
                                <CheckBox
                                    Margin="0 0 24 0"
                                    Content="Стены"
                                    IsChecked="{Binding CheckWalls}" />
                                <CheckBox
                                    Content="Перекрытия"
                                    IsChecked="{Binding CheckFloors}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border
                        Margin="0 0 0 12"
                        DataContext="{Binding SelectedCategory}"
                        Style="{StaticResource CustomBorder}">
                        <StackPanel
                            Margin="12 10"
                            IsEnabled="{Binding IsSelected}">
                            <TextBlock
                                Style="{StaticResource SectionTitle}"
                                Text="Размер отверстия" />
                            <TextBlock
                                Style="{StaticResource Hint}"
                                Text="Зазор - насколько отверстие шире элемента с каждой стороны. Для каждого диапазона габаритов свой зазор и своя форма отверстия: мелкие трассы обычно круглые, крупные прямоугольные." />

                            <DockPanel
                                Style="{StaticResource FieldRow}">
                                <TextBlock
                                    Style="{StaticResource FieldName}"
                                    Text="Округление габаритов, мм" />
                                <ui:TextBox
                                    Style="{StaticResource FieldValue}"
                                    Text="{Binding SizeRoundingMm, UpdateSourceTrigger=PropertyChanged}" />
                            </DockPanel>
                            <DockPanel
                                Style="{StaticResource FieldRow}">
                                <TextBlock
                                    Style="{StaticResource FieldName}"
                                    Text="Округление отметок, мм" />
                                <ui:TextBox
                                    Style="{StaticResource FieldValue}"
                                    Text="{Binding ElevationRoundingMm, UpdateSourceTrigger=PropertyChanged}" />
                            </DockPanel>

                            <DockPanel
                                Margin="0 10 0 4">
                                <TextBlock
                                    Style="{StaticResource SectionTitle}"
                                    Text="Зазоры по диапазонам габаритов" />
                                <StackPanel
                                    HorizontalAlignment="Right"
                                    Orientation="Horizontal">
                                    <ui:Button
                                        Width="110"
                                        Margin="4 0"
                                        Content="Добавить"
                                        Command="{Binding AddOffsetCommand}" />
                                    <ui:Button
                                        Width="110"
                                        Margin="4 0"
                                        Content="Удалить"
                                        Command="{Binding RemoveOffsetCommand}" />
                                </StackPanel>
                            </DockPanel>

                            <DataGrid
                                MinHeight="150"
                                AutoGenerateColumns="False"
                                CanUserAddRows="False"
                                GridLinesVisibility="All"
                                HeadersVisibility="Column"
                                ItemsSource="{Binding Offsets}"
                                SelectedItem="{Binding SelectedOffset}"
                                VirtualizingPanel.VirtualizationMode="Standard">
                                <DataGrid.Columns>
                                    <DataGridTextColumn
                                        Header="Габарит от, мм"
                                        Width="120"
                                        Binding="{Binding FromMm, UpdateSourceTrigger=PropertyChanged}" />
                                    <DataGridTextColumn
                                        Header="до, мм"
                                        Width="120"
                                        Binding="{Binding ToMm, UpdateSourceTrigger=PropertyChanged}" />
                                    <DataGridTextColumn
                                        Header="Зазор, мм"
                                        Width="120"
                                        Binding="{Binding OffsetMm, UpdateSourceTrigger=PropertyChanged}" />
                                    <!-- Шаблон, а не DataGridComboBoxColumn: та показывает значение
                                         только в режиме правки, и колонка выглядит пустой. -->
                                    <DataGridTemplateColumn
                                        Header="Форма отверстия"
                                        Width="*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <ComboBox
                                                    Margin="2"
                                                    BorderThickness="0"
                                                    Background="Transparent"
                                                    ItemsSource="{Binding Source={StaticResource Shapes}}"
                                                    SelectedItem="{Binding Shape, UpdateSourceTrigger=PropertyChanged}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>

                    <Border
                        Style="{StaticResource CustomBorder}">
                        <StackPanel
                            Margin="12 10">
                            <TextBlock
                                Style="{StaticResource SectionTitle}"
                                Text="Общее для всех видов" />
                            <TextBlock
                                Style="{StaticResource Hint}"
                                Text="Соприкасающиеся отверстия плагин заменяет одним: труба сквозь штукатурку, кладку и штукатурку - это одно отверстие, а не три." />

                            <DockPanel
                                Style="{StaticResource FieldRow}"
                                ToolTip="Габариты объединённого отверстия округляются до этого шага.">
                                <TextBlock
                                    Style="{StaticResource FieldName}"
                                    Text="Округление объединённых, мм" />
                                <ui:TextBox
                                    Style="{StaticResource FieldValue}"
                                    Text="{Binding UnitedTaskSizeRoundingMm, UpdateSourceTrigger=PropertyChanged}" />
                            </DockPanel>
                            <DockPanel
                                Style="{StaticResource FieldRow}"
                                ToolTip="Слои конструкции могут идти с воздушной прослойкой. Если она не больше этого значения, отверстия объединяются.">
                                <TextBlock
                                    Style="{StaticResource FieldName}"
                                    Text="Наибольший зазор между слоями, мм" />
                                <ui:TextBox
                                    Style="{StaticResource FieldValue}"
                                    Text="{Binding UnitedTaskMaxGapMm, UpdateSourceTrigger=PropertyChanged}" />
                            </DockPanel>
                            <DockPanel
                                Style="{StaticResource FieldRow}"
                                ToolTip="Насколько отверстия могут не доходить друг до друга вдоль конструкции, чтобы всё же считаться соприкасающимися. Большое значение склеит соседние отверстия в одно огромное.">
                                <TextBlock
                                    Style="{StaticResource FieldName}"
                                    Text="Допуск соприкосновения, мм" />
                                <ui:TextBox
                                    Style="{StaticResource FieldValue}"
                                    Text="{Binding UnitedTaskTouchToleranceMm, UpdateSourceTrigger=PropertyChanged}" />
                            </DockPanel>
                            <DockPanel
                                Style="{StaticResource FieldRow}"
                                ToolTip="Элемент, задевший конструкцию углом, отверстия не требует. Ноль - выдавать задания и на касаниях.">
                                <TextBlock
                                    Style="{StaticResource FieldName}"
                                    Text="Наименьшая глубина прохода, мм" />
                                <ui:TextBox
                                    Style="{StaticResource FieldValue}"
                                    Text="{Binding MinPassDepthMm, UpdateSourceTrigger=PropertyChanged}" />
                            </DockPanel>

                            <CheckBox
                                Margin="0 8 0 0"
                                Content="Показывать отчёт об ошибках расстановки"
                                IsChecked="{Binding ShowPlacingErrors}" />
                        </StackPanel>
                    </Border>

                    <Border
                        Margin="0 12 0 0"
                        Style="{StaticResource CustomBorder}">
                        <StackPanel
                            Margin="12 10">
                            <TextBlock
                                Style="{StaticResource SectionTitle}"
                                Text="Сервер согласования" />
                            <TextBlock
                                Style="{StaticResource Hint}"
                                Text="Куда уходят выданные задания и решения по согласованию. Пусто - берётся адрес из ClashServer.json рядом со сборкой плагина (тот же сервер, что у ClashNavigator)." />

                            <DockPanel
                                Style="{StaticResource FieldRow}">
                                <TextBlock
                                    Style="{StaticResource FieldName}"
                                    Text="Адрес сервера" />
                                <ui:TextBox
                                    Width="300"
                                    HorizontalAlignment="Left"
                                    Text="{Binding ServerUrl, UpdateSourceTrigger=PropertyChanged}"
                                    PlaceholderText="http://localhost:5000" />
                            </DockPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <Border
            Grid.Row="2"
            Margin="14 12 14 14">
            <DockPanel>
                <ui:TextBlock
                    MaxWidth="520"
                    VerticalAlignment="Center"
                    TextWrapping="Wrap"
                    Foreground="Orange"
                    Text="{Binding ErrorText}" />

                <StackPanel
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
                    <ui:Button
                        Width="120"
                        Margin="6 0"
                        Appearance="Info"
                        Content="Сохранить"
                        Click="ButtonOk_Click"
                        Command="{Binding AcceptViewCommand}" />
                    <ui:Button
                        Width="120"
                        Margin="6 0"
                        Content="Отмена"
                        IsCancel="True"
                        Click="ButtonCancel_Click" />
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
