<Window
    x:Class="Juru.RevitPlugins.Openings.Views.Settings.OpeningsSettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    xmlns:configs="clr-namespace:Juru.RevitPlugins.Openings.Models.Configs"
    xmlns:vms="clr-namespace:Juru.RevitPlugins.Openings.ViewModels.Settings"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    mc:Ignorable="d"
    Title="Настройки выдачи заданий"
    Width="1000"
    Height="660"
    MinWidth="900"
    MinHeight="600"
    WindowStartupLocation="CenterOwner"
    d:DataContext="{d:DesignInstance vms:OpeningsSettingsViewModel, IsDesignTimeCreatable=False}">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Без словарей WPF-UI флажки и поля рисуются без стилей: окно наследует Window,
                     а не FluentWindow, и тему за него никто не применяет. -->
                <ui:ThemesDictionary
                    Theme="Light" />
                <ui:ControlsDictionary />
                <ResourceDictionary
                    Source="pack://application:,,,/Juru.RevitPlugins.Core;component/Resources/CustomStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter
                x:Key="BoolToVisibility" />

            <ObjectDataProvider
                x:Key="Shapes"
                MethodName="GetValues"
                ObjectType="{x:Type sys:Enum}">
                <ObjectDataProvider.MethodParameters>
                    <x:Type
                        TypeName="configs:OpeningShape" />
                </ObjectDataProvider.MethodParameters>
            </ObjectDataProvider>

            <Style
                x:Key="FieldLabel"
                TargetType="TextBlock">
                <Setter
                    Property="VerticalAlignment"
                    Value="Center" />
                <Setter
                    Property="TextWrapping"
                    Value="Wrap" />
                <Setter
                    Property="Margin"
                    Value="0 0 12 0" />
            </Style>

            <Style
                x:Key="FieldBox"
                TargetType="ui:TextBox">
                <Setter
                    Property="Width"
                    Value="120" />
                <Setter
                    Property="HorizontalAlignment"
                    Value="Right" />
            </Style>

            <Style
                x:Key="SectionHeader"
                TargetType="TextBlock">
                <Setter
                    Property="Margin"
                    Value="4 0 0 6" />
                <Setter
                    Property="Opacity"
                    Value="0.75" />
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition
                Height="Auto" />
            <RowDefinition
                Height="*" />
            <RowDefinition
                Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar
            Grid.Row="0"
            Title="Настройки выдачи заданий" />

        <Grid
            Grid.Row="1"
            Margin="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition
                    Width="300" />
                <ColumnDefinition
                    Width="*" />
            </Grid.ColumnDefinitions>

            <Grid
                Grid.Column="0"
                Margin="0 0 12 0">
                <Grid.RowDefinitions>
                    <RowDefinition
                        Height="*" />
                    <RowDefinition
                        Height="Auto" />
                </Grid.RowDefinitions>

                <Border
                    Grid.Row="0"
                    Style="{StaticResource CustomBorder}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition
                                Height="Auto" />
                            <RowDefinition
                                Height="*" />
                        </Grid.RowDefinitions>

                        <TextBlock
                            Grid.Row="0"
                            Margin="10 8 10 4"
                            Style="{StaticResource SectionHeader}"
                            Text="Виды элементов" />

                        <ListBox
                            Grid.Row="1"
                            Margin="4"
                            BorderThickness="0"
                            Background="Transparent"
                            HorizontalContentAlignment="Stretch"
                            ItemsSource="{Binding Categories}"
                            SelectedItem="{Binding SelectedCategory}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox
                                        Margin="4 6"
                                        IsChecked="{Binding IsSelected}">
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            Text="{Binding Name}"
                                            TextWrapping="Wrap" />
                                    </CheckBox>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>

                <Border
                    Grid.Row="1"
                    Margin="0 12 0 0"
                    Style="{StaticResource CustomBorder}">
                    <StackPanel
                        Margin="10 8">
                        <TextBlock
                            Style="{StaticResource SectionHeader}"
                            Text="Объединение заданий" />
                        <DockPanel
                            Margin="4 4">
                            <TextBlock
                                Style="{StaticResource FieldLabel}"
                                Text="Округление, мм" />
                            <ui:TextBox
                                Style="{StaticResource FieldBox}"
                                Text="{Binding UnitedTaskSizeRoundingMm, UpdateSourceTrigger=PropertyChanged}" />
                        </DockPanel>
                        <DockPanel
                            Margin="4 4">
                            <TextBlock
                                Style="{StaticResource FieldLabel}"
                                Text="Зазор по толщине, мм" />
                            <ui:TextBox
                                Style="{StaticResource FieldBox}"
                                Text="{Binding UnitedTaskMaxGapMm, UpdateSourceTrigger=PropertyChanged}" />
                        </DockPanel>
                        <DockPanel
                            Margin="4 4">
                            <TextBlock
                                Style="{StaticResource FieldLabel}"
                                Text="Допуск касания, мм" />
                            <ui:TextBox
                                Style="{StaticResource FieldBox}"
                                Text="{Binding UnitedTaskTouchToleranceMm, UpdateSourceTrigger=PropertyChanged}" />
                        </DockPanel>

                        <TextBlock
                            Margin="4 12 0 6"
                            Style="{StaticResource SectionHeader}"
                            Text="Отбор пересечений" />
                        <DockPanel
                            Margin="4 4"
                            ToolTip="Проходы мельче этого значения считаются касанием. Ноль - выдавать задания и на касаниях.">
                            <TextBlock
                                Style="{StaticResource FieldLabel}"
                                Text="Глубина прохода, мм" />
                            <ui:TextBox
                                Style="{StaticResource FieldBox}"
                                Text="{Binding MinPassDepthMm, UpdateSourceTrigger=PropertyChanged}" />
                        </DockPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <ScrollViewer
                Grid.Column="1"
                VerticalScrollBarVisibility="Auto"
                DataContext="{Binding SelectedCategory}">
                <StackPanel>
                    <Border
                        Margin="0 0 0 12"
                        Style="{StaticResource CustomBorder}">
                        <StackPanel
                            Margin="10 8">
                            <TextBlock
                                Style="{StaticResource SectionHeader}"
                                Text="Наименьшие габариты элемента, мм" />
                            <DockPanel
                                Margin="4 6"
                                Visibility="{Binding IsRound, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock
                                    Style="{StaticResource FieldLabel}"
                                    Text="Диаметр" />
                                <ui:TextBox
                                    Style="{StaticResource FieldBox}"
                                    Text="{Binding MinDiameterMm, UpdateSourceTrigger=PropertyChanged}" />
                            </DockPanel>
                            <StackPanel
                                Visibility="{Binding IsRectangular, Converter={StaticResource BoolToVisibility}}">
                                <DockPanel
                                    Margin="4 6">
                                    <TextBlock
                                        Style="{StaticResource FieldLabel}"
                                        Text="Ширина" />
                                    <ui:TextBox
                                        Style="{StaticResource FieldBox}"
                                        Text="{Binding MinWidthMm, UpdateSourceTrigger=PropertyChanged}" />
                                </DockPanel>
                                <DockPanel
                                    Margin="4 6">
                                    <TextBlock
                                        Style="{StaticResource FieldLabel}"
                                        Text="Высота" />
                                    <ui:TextBox
                                        Style="{StaticResource FieldBox}"
                                        Text="{Binding MinHeightMm, UpdateSourceTrigger=PropertyChanged}" />
                                </DockPanel>
                            </StackPanel>
                            <DockPanel
                                Margin="4 6"
                                ToolTip="Элементы крупнее этого габарита пропускаются: обычно это ошибка черчения.">
                                <TextBlock
                                    Style="{StaticResource FieldLabel}"
                                    Text="Наибольший габарит" />
                                <ui:TextBox
                                    Style="{StaticResource FieldBox}"
                                    Text="{Binding MaxSizeMm, UpdateSourceTrigger=PropertyChanged}" />
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <Border
                        Margin="0 0 0 12"
                        Style="{StaticResource CustomBorder}">
                        <StackPanel
                            Margin="10 8">
                            <TextBlock
                                Style="{StaticResource SectionHeader}"
                                Text="Округление, мм" />
                            <DockPanel
                                Margin="4 6">
                                <TextBlock
                                    Style="{StaticResource FieldLabel}"
                                    Text="Габариты" />
                                <ui:TextBox
                                    Style="{StaticResource FieldBox}"
                                    Text="{Binding SizeRoundingMm, UpdateSourceTrigger=PropertyChanged}" />
                            </DockPanel>
                            <DockPanel
                                Margin="4 6">
                                <TextBlock
                                    Style="{StaticResource FieldLabel}"
                                    Text="Отметки" />
                                <ui:TextBox
                                    Style="{StaticResource FieldBox}"
                                    Text="{Binding ElevationRoundingMm, UpdateSourceTrigger=PropertyChanged}" />
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <Border
                        Margin="0 0 0 12"
                        Style="{StaticResource CustomBorder}">
                        <StackPanel
                            Margin="10 8">
                            <TextBlock
                                Style="{StaticResource SectionHeader}"
                                Text="Конструкции для проверки" />
                            <StackPanel
                                Margin="4 6"
                                Orientation="Horizontal">
                                <CheckBox
                                    Margin="0 0 24 0"
                                    Content="Стены"
                                    IsChecked="{Binding CheckWalls}" />
                                <CheckBox
                                    Content="Перекрытия"
                                    IsChecked="{Binding CheckFloors}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border
                        Style="{StaticResource CustomBorder}">
                        <StackPanel
                            Margin="10 8">
                            <DockPanel>
                                <TextBlock
                                    Style="{StaticResource SectionHeader}"
                                    Text="Зазоры по диапазонам габаритов, мм" />
                                <StackPanel
                                    HorizontalAlignment="Right"
                                    Orientation="Horizontal">
                                    <ui:Button
                                        Width="34"
                                        Margin="4 0"
                                        Content="+"
                                        ToolTip="Добавить диапазон"
                                        Command="{Binding AddOffsetCommand}" />
                                    <ui:Button
                                        Width="34"
                                        Margin="4 0"
                                        Content="—"
                                        ToolTip="Удалить выбранный диапазон"
                                        Command="{Binding RemoveOffsetCommand}" />
                                </StackPanel>
                            </DockPanel>

                            <DataGrid
                                Margin="4 8"
                                MinHeight="160"
                                AutoGenerateColumns="False"
                                CanUserAddRows="False"
                                GridLinesVisibility="Horizontal"
                                HeadersVisibility="Column"
                                ItemsSource="{Binding Offsets}"
                                SelectedItem="{Binding SelectedOffset}"
                                VirtualizingPanel.VirtualizationMode="Standard">
                                <DataGrid.Columns>
                                    <DataGridTextColumn
                                        Header="От"
                                        Width="100"
                                        Binding="{Binding FromMm, UpdateSourceTrigger=PropertyChanged}" />
                                    <DataGridTextColumn
                                        Header="До"
                                        Width="100"
                                        Binding="{Binding ToMm, UpdateSourceTrigger=PropertyChanged}" />
                                    <DataGridTextColumn
                                        Header="Зазор"
                                        Width="100"
                                        Binding="{Binding OffsetMm, UpdateSourceTrigger=PropertyChanged}" />
                                    <DataGridComboBoxColumn
                                        Header="Форма отверстия"
                                        Width="*"
                                        ItemsSource="{Binding Source={StaticResource Shapes}}"
                                        SelectedItemBinding="{Binding Shape, UpdateSourceTrigger=PropertyChanged}" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <DockPanel
            Grid.Row="2"
            Margin="12 0 12 12">
            <CheckBox
                VerticalAlignment="Center"
                Content="Показывать ошибки расстановки"
                IsChecked="{Binding ShowPlacingErrors}" />

            <StackPanel
                HorizontalAlignment="Right"
                Orientation="Horizontal">
                <ui:TextBlock
                    MaxWidth="420"
                    Margin="10"
                    VerticalAlignment="Center"
                    TextWrapping="Wrap"
                    Foreground="Orange"
                    Text="{Binding ErrorText}" />
                <ui:Button
                    Width="90"
                    Margin="6"
                    Appearance="Info"
                    Content="ОК"
                    Click="ButtonOk_Click"
                    Command="{Binding AcceptViewCommand}" />
                <ui:Button
                    Width="90"
                    Margin="6"
                    Content="Отмена"
                    IsCancel="True"
                    Click="ButtonCancel_Click" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
