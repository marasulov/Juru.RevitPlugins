<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <IsPackable>false</IsPackable>
        <LangVersion>latest</LangVersion>
        <Configurations>Debug.R23;Debug.R24;Debug.R25;Debug.R26;Debug.R27</Configurations>
        <Configurations>$(Configurations);Release.R23;Release.R24;Release.R25;Release.R26;Release.R27</Configurations>
    </PropertyGroup>

    <!-- Целевая платформа повторяет ту, что Nice3point.Revit.Sdk выбирает для тестируемого
         проекта: иначе ссылка на него не соберётся. Ревит 2027 перешёл на .NET, остальные годы
         остаются на .NET Framework. -->
    <PropertyGroup Condition="'$(Configuration)' == 'Debug.R27' Or '$(Configuration)' == 'Release.R27'">
        <TargetFramework>net10.0-windows7.0</TargetFramework>
    </PropertyGroup>
    <PropertyGroup Condition="'$(TargetFramework)' == ''">
        <TargetFramework>net48</TargetFramework>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
        <PackageReference Include="xunit" Version="2.9.2" />
        <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />

        <!-- Операторы диапазона из подключённого файлом RussianText: на net48 System.Index и
             System.Range приходят пакетом, как и в самом Juru.RevitPlugins.Schedules. -->
        <PackageReference Include="Polyfill" Version="10.5.1" PrivateAssets="all" />
    </ItemGroup>

    <!-- Только Core: здесь лежит логика, у которой нет ни одной ссылки на Revit API, и она
         единственная, что честно проверяется обычными тестами. Почему не больше - см. Readme.md
         рядом. -->
    <ItemGroup>
        <ProjectReference Include="..\..\src\Juru.RevitPlugins.Core\Juru.RevitPlugins.Core.csproj" />
    </ItemGroup>

    <!-- Файлом, а не ссылкой на проект: Juru.RevitPlugins.Schedules тянет сборки Ревита, с
         которыми тесты не выполняются (см. Readme.md). Сам RussianText под критерий подходит - в
         нём нет ни одной ссылки на Revit API, это чистый разбор строк, и ошибка в нём тиха:
         неразобранная двуязычная строка просто множит ключи в словаре. -->
    <ItemGroup>
        <Compile Include="..\..\src\Juru.RevitPlugins.Schedules\Services\RussianText.cs"
                 Link="RussianText.cs" />
    </ItemGroup>

    <!-- Так же, файлами: разбор выгрузки Navisworks и имя файла отчёта из ClashNavigator - чистая
         работа со строками и XML, без Revit API, а сам ClashNavigator, как и Schedules, тянет
         сборки Ревита. -->
    <ItemGroup>
        <Compile Include="..\..\src\Juru.RevitPlugins.ClashNavigator\Services\NavisworksImport\NavisworksXml.cs"
                 Link="NavisworksXml.cs" />
        <Compile Include="..\..\src\Juru.RevitPlugins.ClashNavigator\Models\RevitClashes\Models\Clashes\ReportFileName.cs"
                 Link="ReportFileName.cs" />
        <Compile Include="..\..\src\Juru.RevitPlugins.ClashNavigator\Models\RevitClashes\Models\RevitClashReport\NavisXmlReport.cs"
                 Link="NavisXmlReport.cs" />
    </ItemGroup>

</Project>
